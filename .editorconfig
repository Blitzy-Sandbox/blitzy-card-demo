# ******************************************************************
# * File         : .editorconfig
# * Application  : CardDemo
# * Type         : Editor formatting contract (repository hygiene)
# * Function     : Deterministic whitespace, charset and line-ending
# *                conventions for the Java 25 / Spring Boot tree added
# *                alongside the frozen legacy corpus. No formatter,
# *                linter or style-tool configuration existed anywhere in
# *                this repository, so this convention is ESTABLISHED
# *                rather than inherited - and it deliberately stops at
# *                the boundary of app/, samples/ and diagrams/.
# * Derived from  : CONTRIBUTING.md:33-34 (focus on the specific change;
# *                reformatting everything obscures it - ensure local
# *                tests pass) and app/cbl/CBACT04C.cbl:1-21 (fixed-column
# *                COBOL, banner space-padded to column 72 and body text
# *                to column 80 - spacing that is load bearing and must
# *                never be touched).
# ******************************************************************
# * Copyright Amazon.com, Inc. or its affiliates. All Rights Reserved.
# * Licensed under the Apache License, Version 2.0. See the LICENSE and
# * NOTICE files at the repository root for the full terms.
# ******************************************************************

# ==================================================================
# WHAT THIS FILE DOES
#   EditorConfig is a hint protocol honoured by editors and IDEs on
#   save. It is NOT a formatter and NOT a build step: it never rewrites
#   a file on its own, never runs in CI, and has no effect on
#   compilation. `mvn` behaviour is unchanged by this file. Its only job
#   is to stop two contributors' editors from disagreeing about
#   whitespace, and to keep every editor away from the frozen corpus.
#
# SCOPE AND PRECEDENCE
#   Sections run general -> specific and the LAST matching section wins
#   per property, so the frozen-corpus block sits at the bottom: no rule
#   above it can reach app/, samples/ or diagrams/.
#
# KEY DEFAULTS
#   UTF-8, LF, final newline, trailing whitespace trimmed, 2-space
#   indent. Java overrides the indent to 4. These mirror .gitattributes
#   exactly (LF for sources and config, CRLF for *.cmd and *.bat) so the
#   editor and Git can never disagree about a line ending.
#
# HOW TO VERIFY A CHANGE TO THIS FILE
#   editorconfig /abs/path/to/file          # resolved properties
#   git check-attr text eol binary -- PATH  # the .gitattributes view
#   git diff -- app samples diagrams        # MUST stay empty
#
# FAILURE MODES TO AVOID
#   Never assert charset, end_of_line or insert_final_newline over
#   app/**. That tree is mixed on purpose: it is predominantly LF but
#   five members are CRLF (app/cbl/CBSTM03A.CBL, app/cbl/CBSTM03B.CBL,
#   app/cbl/COACTUPC.cbl, app/cpy/COSTM01.CPY, app/jcl/CREASTMT.JCL),
#   and the EBCDIC datasets under app/data/EBCDIC carry NO line
#   terminator at all - USRSEC.PS is 800 bytes of ten 80-byte records.
#   Asserting a value there would invite an editor to add or remove
#   bytes and silently break the fixed-width record offsets the
#   migration is validated against. `unset` is the only safe answer.
# ==================================================================

root = true

# ---- Baseline for every file authored for this migration. 2 spaces is
# ---- the conventional width for the YAML, XML, JSON, SQL, shell and
# ---- Markdown that dominate the new tree; Java widens it below.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# ---- Java sources. 4 spaces and 120 columns are not aspirational: the
# ---- existing tree already indents at 4 and its widest line is exactly
# ---- 120, so this records the convention in force rather than imposing
# ---- a new one. A hint only - the compiler ignores it.
[*.java]
indent_size = 4
max_line_length = 120

# ---- Build descriptors, resources, migrations, container and CI
# ---- definitions. The width hint is deliberately confined to these
# ---- structured formats, where every current file already fits.
[*.{xml,yml,yaml,json,sql,sh,properties,html}]
max_line_length = 120

# ---- Markdown keeps its trailing whitespace: two trailing spaces are a
# ---- hard line break, and trimming them would silently reflow README.md
# ---- and the docs/ set. No width hint either - prose here legitimately
# ---- runs to several hundred columns.
[*.md]
trim_trailing_whitespace = false

# ---- Windows launchers. cmd.exe needs CRLF to parse a batch file
# ---- reliably; this matches .gitattributes, which sets eol=crlf for
# ---- both extensions. Covers mvnw.cmd.
[*.{bat,cmd}]
end_of_line = crlf

# ---- Fixed-width test fixtures and parity baselines. These are
# ---- byte-exact copies of the legacy datasets: custdata.txt is fifty
# ---- 500-character records whose padding is significant. Trimming or
# ---- reindenting them would corrupt the record geometry the parity
# ---- comparison depends on. LF and UTF-8 are kept on purpose - CRLF
# ---- would add a byte per record.
[src/test/resources/**.txt]
trim_trailing_whitespace = false
indent_style = unset
indent_size = unset

# ==================================================================
# FROZEN LEGACY CORPUS - LAST BLOCK, SO IT OVERRIDES EVERYTHING ABOVE
#
# app/ holds the COBOL programs, copybooks, BMS mapsets, JCL, PROC and
# CTL members, the CICS CSD, the VSAM catalogue listing and the data
# fixtures. samples/ holds the z/OS compile templates, the build
# procedures and two binary runtime archives. diagrams/ holds the legacy
# illustrations. All three are read-only reference material that must
# survive byte-for-byte, so every property is unset: the editor is given
# no opinion to act on.
#
# trim_trailing_whitespace is the one exception - it is pinned to false
# rather than unset, because trimming is a one-directional destructive
# edit that many editors perform by default, whereas `unset` merely
# declines to express a preference. Trailing-space padding to the fixed
# columns 72 and 80 is pervasive here: 15 of the 21 banner lines in
# app/cbl/CBACT04C.cbl end in spaces. The stronger, explicit
# prohibition is therefore the correct choice.
#
# Each block unsets every property this file sets anywhere, including
# max_line_length, which no section above currently applies to these
# paths. That is deliberate rather than redundant: it keeps the block a
# complete firewall, so widening an earlier section later cannot leak an
# opinion into the frozen trees.
#
# tab_width is intentionally absent: unsetting indent_size already
# clears the derived tab_width, so restating it would be redundant.
# ==================================================================

[app/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = false
indent_style = unset
indent_size = unset
max_line_length = unset

[samples/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = false
indent_style = unset
indent_size = unset
max_line_length = unset

[diagrams/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = false
indent_style = unset
indent_size = unset
max_line_length = unset
