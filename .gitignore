# ******************************************************************

# ---- Maven build output ----
target/
!.mvn/wrapper/maven-wrapper.properties
.mvn/wrapper/maven-wrapper.jar
.mvn/.develocity/
build/
out/
dependency-reduced-pom.xml
release.properties
pom.xml.versionsBackup
pom.xml.releaseBackup
pom.xml.next
pom.xml.tag

# ---- Compiled / packaged artefacts ----
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar
*.tar.gz
*.tgz
!.mvn/wrapper/*.jar

# ---- Test, coverage and scan reports ----
surefire-reports/
failsafe-reports/
jacoco.exec
jacoco-it.exec
jacoco-merged.exec
dependency-check-report.*
dependency-check/
*.hprof
hs_err_pid*
replay_pid*

# ---- Logs ----
logs/
*.log
!localstack-init/*.log.example

# ---- IDE and editor state ----
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.classpath
.project
.factorypath
.apt_generated/
nbproject/private/
*.swp
*.swo
*~

# ---- OS noise ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# ---- Local secrets and environment overrides (never committed) ----
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
*.keystore
*.truststore
secrets/
credentials

# ---- Container / infrastructure local state ----
.localstack/
volume/
localstack-volume/
postgres-data/
prometheus-data/
grafana-data/

# ---- Python virtual environments (tooling only, never application code) ----
.venv/
venv/
__pycache__/
*.py[cod]

# ---- Blitzy scratch space ----
blitzy/
blitzy_adhoc_test_*
