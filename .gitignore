# =============================================================================
# .gitignore  —  AWS CardDemo (Java 17 / Spring Boot 3.x / Maven /
#                              Docker / LocalStack / Terraform)
# -----------------------------------------------------------------------------
# This file implements the 11-phase coverage matrix mandated by the project's
# Agent Action Plan (AAP §0.2.1, §0.4.1, §0.7.1).  It is intentionally
# explicit and self-documenting — every section is keyed to an AAP phase so
# auditors and contributors can trace each rule back to the source spec.
#
# What this file IGNORES
#   * Maven/Java build outputs (target/, *.class, *.jar, ...)
#   * IDE & editor metadata (IntelliJ, Eclipse, VS Code, NetBeans, Vim, Emacs)
#   * Operating-system noise (.DS_Store, Thumbs.db, ...)
#   * Spring Boot developer-local profile overlays & log files
#   * Docker / LocalStack runtime state and persisted volumes
#   * Terraform local state, plan files, lock dirs, *.tfvars
#   * CI/CD secrets — *.pem, *.key, .env, secrets.json, AWS local creds
#   * JVM crash dumps, heap dumps, flight recordings
#   * MkDocs site builds, test reports, coverage data
#   * Parallel-run validation output and ad-hoc test scratch
#
# What this file DELIBERATELY DOES NOT IGNORE  (re-included via "!" or never
# listed at all — see AAP §0.2.1)
#   * The COBOL source tree under app/   — frozen authoritative reference
#       (app/cbl/, app/cpy/, app/bms/, app/cpy-bms/, app/jcl/, app/catlg/,
#        app/data/, app/csd/, app/ctl/, app/proc/)
#   * The samples/ tree                  — sample build wrappers (REFERENCE)
#   * The diagrams/ tree                 — architecture & data-model diagrams
#   * The docs/ tree                     — project documentation (MUST commit)
#   * application.yml / application-{local,dev,prod,test}.yml — canonical
#       Spring profile files committed at src/main/resources/
#   * .mvn/wrapper/maven-wrapper.jar     — committed for reproducible builds
#   * .mvn/wrapper/maven-wrapper.properties — committed
#   * localstack/init/init-aws.sh        — committed LocalStack bootstrap
#   * localstack/init/secrets.json       — committed local-only seed (if any)
#   * .terraform.lock.hcl                — committed for reproducible IaC
# =============================================================================


# -----------------------------------------------------------------------------
# Phase 1 — Maven / Java build artifacts
# -----------------------------------------------------------------------------
# Maven build output (root project + any submodule)
target/
**/target/

# Compiled Java class files
*.class

# Packaged outputs.  These are produced by `mvn package` / `mvn install` and
# must not be checked in.  The Maven Wrapper JAR is re-included below.
*.jar
*.war
*.ear
*.nar

# Re-include the Maven Wrapper JAR — required for reproducible builds even
# though it appears to be a *.jar.  AAP §0.2.1 lists this as committed.
!.mvn/wrapper/maven-wrapper.jar

# Maven release-plugin scratch files
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties

# Maven build-timing log (generated by `mvn -T` or profilers)
.mvn/timing.properties


# -----------------------------------------------------------------------------
# Phase 2 — IDE and editor metadata
# -----------------------------------------------------------------------------

# --- IntelliJ IDEA ---
.idea/
*.iml
*.ipr
*.iws
out/

# --- Eclipse / Spring Tool Suite ---
.metadata/
.settings/
.project
.classpath
.factorypath
.recommenders/
.apt_generated/
.apt_generated_test/
.loadpath
.springBeans
.checkstyle
local.properties
bin/

# --- Visual Studio Code ---
.vscode/
*.code-workspace

# --- NetBeans ---
nbproject/private/
nbbuild/
nbdist/
nb-configuration.xml
nb-configuration.xml.bak

# --- Vim / Emacs / generic editor swap & backup files ---
*.swp
*.swo
*~
.#*
\#*\#
*.bak
*.orig
*.rej


# -----------------------------------------------------------------------------
# Phase 3 — Operating system noise
# -----------------------------------------------------------------------------

# --- macOS ---
.DS_Store
.DS_Store?
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes
.fseventsd

# --- Windows ---
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# --- Linux ---
.fuse_hidden*
.directory
.Trash-*
.nfs*


# -----------------------------------------------------------------------------
# Phase 4 — Spring Boot specific
# -----------------------------------------------------------------------------
# Developer-local Spring profile overlays — never committed.  Patterns require
# a leading segment between `application-` and the trailing keyword so the
# canonical profile files (application.yml, application-local.yml,
# application-dev.yml, application-prod.yml, application-test.yml) are NOT
# matched here.  AAP §0.2.1 explicitly lists those as committed.
application-*-local.yml
application-*-local.yaml
application-*-secret.yml
application-*-secret.yaml
application-*-secrets.yml
application-*-secrets.yaml
application-local-override.yml
application-local-override.yaml
application-secrets.yml
application-secrets.yaml

# Spring Boot DevTools restart trigger
.spring-boot-devtools.properties

# Spring Boot / Spring Shell runtime log files
spring.log
spring.log.*
spring-shell.log
*.log
logs/


# -----------------------------------------------------------------------------
# Phase 5 — Docker / LocalStack runtime state
# -----------------------------------------------------------------------------
# Local Docker / docker-compose mount directories
volumes/
volume/
data/

# LocalStack persisted state and caches
.localstack/
localstack/data/
localstack/.cache/
localstack/tmp/
localstack/volume/

# Docker scratch files
.dockerignore.bak

# Re-include the committed LocalStack init directory and seed files.
# AAP §0.2.1 lists localstack/init/init-aws.sh and localstack/init/secrets.json
# as committed artifacts.  The blanket `data/` ignore above could otherwise
# shadow a future localstack/init/data/ subtree, so we negate explicitly.
!localstack/init/
!localstack/init/**


# -----------------------------------------------------------------------------
# Phase 6 — Terraform IaC artifacts
# -----------------------------------------------------------------------------
# Provider plugin cache (one per Terraform module)
.terraform/
**/.terraform/*

# Terraform state files and backups — NEVER commit local state
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform crash logs
crash.log
crash.*.log

# Terraform variable files — MAY contain secrets (DB passwords, AWS account
# IDs, KMS key ARNs).  AAP §0.7.1 forbids credentials in the repo.
*.tfvars
*.tfvars.json

# Local override files (developer-specific configuration tweaks)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration files
.terraformrc
terraform.rc

# Terraform plan output files
*.tfplan
*.tfplan.*

# Re-include the dependency lock file — committed for reproducible IaC.
# (AAP §0.2.1: "infrastructure/terraform/" — .terraform.lock.hcl belongs to it.)
!.terraform.lock.hcl
!**/.terraform.lock.hcl


# -----------------------------------------------------------------------------
# Phase 7 — CI/CD secrets and intermediates
# -----------------------------------------------------------------------------
# Private keys, certificates, keystores, truststores
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.truststore
*.der
*.crt
*.csr

# Environment files — may contain credentials.  Per AAP §0.7.1, all secrets
# are managed via AWS Secrets Manager; nothing belongs in .env at runtime.
.env
.env.local
.env.*.local
.env.production
.env.development
.env.staging

# Secret-bearing JSON / YAML config files at any depth
secrets.json
secret.json
secrets.yml
secrets.yaml
local-secrets/

# AWS local CLI cache (credentials, sso cache, etc.)
.aws/

# Re-include the LocalStack-init seed file — it is documented in the AAP
# as a committed seed file used by docker-compose to bootstrap LocalStack
# with placeholder secrets for local development only.  The values inside
# are non-sensitive fakes (NOT production credentials).  AAP §0.4.1:
# "localstack/init/*.sh — LocalStack init scripts".
!localstack/init/secrets.json


# -----------------------------------------------------------------------------
# Phase 8 — JVM crash dumps, heap dumps, flight recordings
# -----------------------------------------------------------------------------
hs_err_pid*
replay_pid*
*.hprof
*.jfr
core.*

# Generic scratch / temp directories
tmp/
.tmp/


# -----------------------------------------------------------------------------
# Phase 9 — Documentation site builds
# -----------------------------------------------------------------------------
# MkDocs (`mkdocs build`) output
site/
_site/

# Sphinx, Jekyll and other static-site builders (defensive)
_build/
.docusaurus/


# -----------------------------------------------------------------------------
# Phase 10 — Test reports and coverage
# -----------------------------------------------------------------------------
# Surefire / Failsafe unit and integration test reports
**/surefire-reports/
**/failsafe-reports/

# Maven Site reports (Phase 9 already ignores root site/; this catches nested)
**/site/

# JaCoCo coverage reports and binary execution data
**/jacoco-report/
.jacoco/
coverage/
*.exec

# OWASP Dependency-Check reports
dependency-check-report.*

# Generic test-runner output
test-output/


# -----------------------------------------------------------------------------
# Phase 11 — Parallel-run golden-output diffs (local validation only)
# -----------------------------------------------------------------------------
# Output produced by the COBOL-vs-Java parallel-run validation harness
# described in AAP §0.7.2 ("parallel-run period: run COBOL and Java systems
# simultaneously and diff outputs before cutover").
parallel-run-output/
*.diff
*.diff.txt
*.delta


# -----------------------------------------------------------------------------
# Blitzy agent working directory and scratch files
# -----------------------------------------------------------------------------
# Ad-hoc test files generated by Blitzy validation agents must never be
# committed (per the platform's universal validation protocol).
blitzy_adhoc_test_*

# Blitzy agent runtime artifacts (screenshots, screen recordings, traces)
blitzy/


# -----------------------------------------------------------------------------
# Miscellaneous build / runtime / package-manager artifacts
# -----------------------------------------------------------------------------
# Generic Gradle / SBT / general build output (defensive — project uses Maven)
build/
dist/
.gradle/

# Process ID, seed and lockfiles from runtime services
*.pid
*.seed
*.pid.lock

# Node modules — in case future client-side or doc tooling is added
node_modules/

# End of file
