<?xml version="1.0" encoding="UTF-8"?>
<!--
    CardDemo - Structured Logging Configuration (Observability rule).

    Purpose
      Realizes the "Observability" deliverable: structured logging with correlation IDs and
      trace/span propagation, shipped with the initial implementation.

    Companion components (populate the SLF4J MDC consumed below)
      - com.carddemo.observability.CorrelationIdFilter -> MDC key "correlationId" (per HTTP request).
      - Micrometer Tracing (OpenTelemetry bridge)       -> MDC keys "traceId" and "spanId".

    Why this file is named "logback-spring.xml" (not "logback.xml")
      Spring Boot only processes the <springProfile> and <springProperty> extension elements when
      the Logback configuration is named "logback-spring.xml"; "logback.xml" is loaded by Logback
      itself too early for those extensions to be understood.

    Output contract
      - Non-"local" profiles (test, default, container): single-line JSON to STDOUT (JSON_CONSOLE).
      - "local" profile: human-readable colored text to STDOUT (PLAIN_CONSOLE), still carrying the IDs.
      Both surfaces emit correlationId / traceId / spanId whenever those keys are present in the MDC.

    Design rationale (profile split, field naming, restricted MDC emission) is documented in
    DECISION_LOG.md per the Explainability rule, intentionally kept out of verbose XML comments.
-->
<configuration>

    <!-- Flush buffered/async log events on graceful JVM shutdown. -->
    <shutdownHook class="ch.qos.logback.core.hook.DefaultShutdownHook"/>

    <!--
        Spring Boot logging defaults: registers the %clr (color) and %wEx (whitespace exception)
        conversion rules and sensible baseline log levels. The console/file appender defaults are
        deliberately NOT included - this file defines its own JSON and plain appenders instead.
    -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!--
        Service identity stamped into every log line. Sourced from the Spring "spring.application.name"
        property and defaulting to "carddemo" so logs are always attributable, even before configuration
        is fully resolved.
    -->
    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="carddemo"/>

    <!--
        ============================================================================================
        Application and framework logger levels (baseline), profile-independent.
        These set levels only; they reference no appender and inherit the profile-selected root
        appender via additivity, and remain overridable at runtime by "logging.level.*" entries in
        application.yml.
        ============================================================================================
    -->
    <logger name="com.carddemo" level="INFO"/>
    <logger name="org.springframework.batch" level="INFO"/>
    <logger name="org.flywaydb" level="INFO"/>
    <logger name="org.hibernate.SQL" level="WARN"/>
    <logger name="io.awspring.cloud" level="WARN"/>
    <logger name="software.amazon.awssdk" level="WARN"/>

    <!--
        ============================================================================================
        Non-"local" profiles (test / default / containerized runtime): single-line JSON to STDOUT.
        The JSON_CONSOLE appender is declared INSIDE this profile block so it is only created when
        the profile is active - avoiding a defined-but-unreferenced appender under the "local" profile.
        ============================================================================================
    -->
    <springProfile name="!local">
        <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
                <providers>
                    <!-- ISO-8601 timestamp, emitted in UTC under the "@timestamp" field. -->
                    <timestamp>
                        <fieldName>@timestamp</fieldName>
                        <timeZone>UTC</timeZone>
                        <pattern>yyyy-MM-dd'T'HH:mm:ss.SSSXXX</pattern>
                    </timestamp>
                    <!-- Log level under "level". -->
                    <logLevel>
                        <fieldName>level</fieldName>
                    </logLevel>
                    <!-- Logger name under "logger" (overrides the encoder default of "logger_name"). -->
                    <loggerName>
                        <fieldName>logger</fieldName>
                    </loggerName>
                    <!-- Executing thread under "thread" (overrides the encoder default of "thread_name"). -->
                    <threadName>
                        <fieldName>thread</fieldName>
                    </threadName>
                    <!-- Formatted log message under "message". -->
                    <message>
                        <fieldName>message</fieldName>
                    </message>
                    <!--
                        Correlation / distributed-tracing context. Only the three known-safe keys are
                        emitted - arbitrary MDC content is intentionally NOT propagated, providing
                        defense-in-depth against accidentally logging sensitive values.
                    -->
                    <mdc>
                        <includeMdcKeyName>correlationId</includeMdcKeyName>
                        <includeMdcKeyName>traceId</includeMdcKeyName>
                        <includeMdcKeyName>spanId</includeMdcKeyName>
                    </mdc>
                    <!-- Exception stack traces under "stack_trace" (only present when an exception is logged). -->
                    <stackTrace>
                        <fieldName>stack_trace</fieldName>
                    </stackTrace>
                    <!-- Static service identity field: { "service": "<appName>" }. -->
                    <pattern>
                        <omitEmptyFields>true</omitEmptyFields>
                        <pattern>{"service":"${appName}"}</pattern>
                    </pattern>
                    <!-- Structured key/value arguments supplied via net.logstash.logback.argument.StructuredArguments. -->
                    <arguments/>
                </providers>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="JSON_CONSOLE"/>
        </root>
    </springProfile>

    <!--
        ============================================================================================
        "local" profile: human-readable colored text to STDOUT for local development. Still surfaces
        [correlationId] and [traceId,spanId] so developers see the same context as the JSON surface.
        The PLAIN_CONSOLE appender is declared INSIDE this profile block so it is only created when
        the "local" profile is active.
        ============================================================================================
    -->
    <springProfile name="local">
        <appender name="PLAIN_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
                <charset>UTF-8</charset>
                <pattern>%clr(%d{yyyy-MM-dd'T'HH:mm:ss.SSS, UTC}){faint} %clr(%-5level) %clr([%X{correlationId:-}]){magenta} %clr([%X{traceId:-},%X{spanId:-}]){cyan} %clr(%logger{36}){blue} - %msg%n%wEx</pattern>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="PLAIN_CONSOLE"/>
        </root>
    </springProfile>

</configuration>
