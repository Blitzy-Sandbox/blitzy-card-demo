<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <!-- Empty by design: no aggregator pom exists at any level of this repository, so the parent
             must be resolved from the repository rather than from ../pom.xml. -->
        <relativePath/>
    </parent>

    <groupId>com.vsergeychik</groupId>
    <artifactId>carddemo</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>carddemo</name>
    <description>
        AWS CardDemo - like-for-like migration of 28 COBOL programs to Java 21 and Spring Boot
        3.x: 17 CICS online transactions as stateless REST controllers, 9 non-CICS programs as
        Spring Batch jobs (8 invoked by EXEC PGM= plus the untriggered CBTRN01C orphan), 2 CALLed
        subprograms as injected components, and 12 dataset repositories over plain JDBC with no
        schema change.
    </description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>

        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
        <jacoco.version>0.8.15</jacoco.version>

        <!-- The acceptance bar, applied below at BUNDLE and at PACKAGE granularity so no package can
             hide behind another's coverage. -->
        <jacoco.branch.minimum>0.90</jacoco.branch.minimum>

        <!-- Directory-safe: Maven's default timestamp is an ISO instant containing colons, which is not
             a portable path segment, and this value becomes one. -->
        <maven.build.timestamp.format>yyyyMMdd-HHmmssSSS</maven.build.timestamp.format>

        <!-- The only two versions the parent BOM manages that this file overrides. Both are logging
             families AAP 0.5.4's inventory does not enumerate, and in both cases the version the BOM
             manages is the one the advisory names: logback-core is affected by CVE-2026-13006 "up to
             and including version 1.5.34", and log4j-api 2.24.3 falls inside CVE-2026-49844's range.
             Boot 3.5.16 is the last published OSS 3.5.x release, so no parent upgrade carries either
             fix. tomcat.version (10.1.55) and jackson-bom.version (2.21.4) are advisory-affected too
             and are deliberately NOT overridden: AAP 0.5.4 enumerates both, so moving them needs an
             authorised revision of the plan rather than a pin here - escalated as risk R-J in
             docs/project-guide.md. -->
        <logback.version>1.5.38</logback.version>
        <log4j2.version>2.25.5</log4j2.version>

        <!-- One writable output root per invocation. application-test.yml derives
             carddemo.test.work-dir from this, and several outputs beneath it are opened in append mode,
             so two runs sharing a root would append to each other's data. -->
        <carddemo.test.run.id>${maven.build.timestamp}</carddemo.test.run.id>

        <!-- Excluded from the main test run and re-run in the verify phase below, because it reads the
             main run's surefire reports to prove every compiled suite actually executed. -->
        <carddemo.test.execution-verifier>**/ExecutedSuiteInventoryVerification.java</carddemo.test.execution-verifier>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-batch</artifactId>
            <!-- Micrometer is outside this module's dependency set; spring-batch-core pulls
                 micrometer-core, which pulls these two, and an exclusion is the only way to drop them. -->
            <exclusions>
                <exclusion>
                    <groupId>org.hdrhistogram</groupId>
                    <artifactId>HdrHistogram</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.latencyutils</groupId>
                    <artifactId>LatencyUtils</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.h2database</groupId>
            <!-- Test scope only, and it must stay that way: it backs the Spring Batch JobRepository,
                 which Batch 5 requires to be DataSource-backed, and hosts the parity harness's seeded
                 rows. It is never a production datasource. -->
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>carddemo</finalName>

        <!-- Declaring this element replaces Maven's default, so src/test/resources is restated first.
             CSLKPCDY.cpy is copied unfiltered from app/cpy as a read-only transcription oracle. -->
        <testResources>
            <testResource>
                <directory>${project.basedir}/src/test/resources</directory>
                <filtering>false</filtering>
            </testResource>
            <testResource>
                <directory>${project.basedir}/../cpy</directory>
                <targetPath>cobol-oracle</targetPath>
                <filtering>false</filtering>
                <includes>
                    <include>CSLKPCDY.cpy</include>
                </includes>
            </testResource>
            <testResource>
                <directory>${project.basedir}/../jcl</directory>
                <targetPath>jcl-oracle</targetPath>
                <filtering>false</filtering>
            </testResource>
            <testResource>
                <directory>${project.basedir}/../proc</directory>
                <targetPath>jcl-oracle</targetPath>
                <filtering>false</filtering>
            </testResource>
        </testResources>

        <!-- Order matters: surefire is declared before jacoco so that within the shared test phase the
             tests run first and the report is produced from their execution data. -->
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <release>21</release>
                    <!-- Keep parameter names in the bytecode, so payload binding and diagnostics report
                         the declared field names rather than arg0, arg1. -->
                    <parameters>true</parameters>
                    <compilerArgs>
                        <!-- Advisory only: a like-for-like translation legitimately produces constructs
                             the compiler would rather see written differently, and failing on them would
                             pressure a change in behaviour. -->
                        <arg>-Xlint:all</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
                <configuration>
                    <!-- Results stream to stdout in a deterministic, filesystem-independent order, with
                         full traces, so one non-interactive command shows every failure inline. -->
                    <useFile>false</useFile>
                    <trimStackTrace>false</trimStackTrace>
                    <runOrder>alphabetical</runOrder>

                    <!-- The default is false, and with it a run that discovered no test reports success:
                         surefire is content to find none and jacoco:check skips its rules when no
                         execution data exists, so both halves of the gate stand down together. -->
                    <failIfNoTests>true</failIfNoTests>

                    <systemPropertyVariables>
                        <carddemo.test.run-id>${maven.build.timestamp}</carddemo.test.run-id>
                        <carddemo.test.run.id>${carddemo.test.run.id}</carddemo.test.run.id>
                    </systemPropertyVariables>
                </configuration>

                <executions>
                    <execution>
                        <!-- A second execution of the same plugin, bound to verify, whose input is the
                             main run's surefire reports; surefire appends per execution and never clears
                             the directory, so reading and writing it here is safe. -->
                        <id>verify-executed-suite-inventory</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>${carddemo.test.execution-verifier}</include>
                            </includes>
                            <reportsDirectory>${project.build.directory}/surefire-reports</reportsDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>jacoco-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>

                    <execution>
                        <id>jacoco-report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>

                    <execution>
                        <id>jacoco-check-branch-coverage</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <haltOnFailure>true</haltOnFailure>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.branch.minimum}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                        <!-- Per-package as well as per-bundle: a bundle ratio alone lets a
                                     thinly covered package hide behind a well covered one. -->
                            <element>PACKAGE</element>
                                    <limits>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.branch.minimum}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <!-- No <version>: the version and the repackage execution both come from the parent's
                     pluginManagement, so this adds no coordinate to resolve. -->
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.vsergeychik.carddemo.CardDemoApplication</mainClass>
                    <layout>ZIP</layout>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
