# ---------------------------------------------------------------------------
# CardDemo UI environment template (Vite).
# Copy to `.env.local` for local development. Only VITE_-prefixed variables
# are inlined into the client bundle at build time.
# ---------------------------------------------------------------------------

# Base URL prefix for API requests issued by the generated client / Axios.
# Leave EMPTY for same-origin routing: the browser calls "/api/..." which is
# forwarded to the BFF by nginx (production) or the Vite dev proxy (dev).
# The BFF serves all UI-facing paths under "/api". Only override this if the
# UI must call an absolute BFF origin (not needed in the compose topology).
VITE_API_BASE_URL=

# Where `npm run dev` proxies "/api" during local development. This is a
# SERVER-ONLY value read by vite.config.ts (the dev proxy); it is deliberately
# NOT in the `VITE_` namespace so it is never inlined into the browser bundle.
# Reserve `VITE_*` strictly for variables intended to reach client code.
# Defaults to the BFF host port (root .env.example sets BFF_PORT=8080).
BFF_PROXY_TARGET=http://localhost:8080
