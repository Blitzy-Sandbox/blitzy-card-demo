# Maven build outputs
target/
**/target/
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar

# Maven local state
.mvn/wrapper/maven-wrapper.jar
!.mvn/wrapper/maven-wrapper.properties
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.flattened-pom.xml

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Eclipse
.project
.classpath
.settings/
.factorypath
.apt_generated/
.springBeans
.sts4-cache/
bin/

# VS Code
.vscode/
*.code-workspace
.history/

# NetBeans
nbproject/private/
nbbuild/
nbdist/
.nb-gradle/

# OS-generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# JVM dumps and crash files
hs_err_pid*.log
replay_pid*.log
*.hprof
core
core.*

# Java Flight Recorder
*.jfr

# jqwik persistent property-test seed database (generated by jqwik on test
# discovery whenever jqwik is on the classpath, regardless of whether any
# property-based test actually runs; AAP §0.5.1, §0.6.1)
.jqwik-database
**/.jqwik-database

# Test output (non-target locations)
*.log
logs/

# Local environment overrides — never commit secrets or local paths
application.properties
application-local.properties
.env
.env.local

# Un-ignore the bundled classpath default application.properties shipped INSIDE
# every shaded jar produced by carddemo-app/maven-shade-plugin. This file is
# committed and bundled (NOT a local override); the broad rule above would
# otherwise prevent it from being tracked. See AAP §0.2.1 and the file header
# of java/carddemo-app/src/main/resources/application.properties for details.
!carddemo-app/src/main/resources/application.properties
