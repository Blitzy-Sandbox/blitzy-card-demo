<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Parent POM for the CardDemo Java 25 LTS migration.

        Source language: COBOL (preserved unchanged under ../app/)
        Target language: Java 25 LTS
        Architecture:    Hexagonal, plain factories + constructor injection (no Spring)
        Persistence:     File-based default (java.nio.file), optional JDBC adapter
        Per AAP §0.5.1 / §0.7  ─ No Spring, no PostgreSQL, no Spring Batch.
    -->

    <groupId>com.blitzy.carddemo</groupId>
    <artifactId>carddemo-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>CardDemo (Java 25 LTS) — Parent</name>
    <description>
        AWS CardDemo: source-to-source migration from COBOL/CICS/VSAM/JCL/BMS to Java 25 LTS.
        Multi-module hexagonal layout; the COBOL source tree at ../app/ remains the immutable
        reference implementation and the source of golden-record test fixtures.
    </description>

    <modules>
        <module>carddemo-domain</module>
        <module>carddemo-application</module>
        <module>carddemo-adapter-file</module>
        <module>carddemo-adapter-db</module>
        <module>carddemo-batch</module>
        <module>carddemo-app</module>
        <module>carddemo-tests</module>
    </modules>

    <properties>
        <!-- Java 25 LTS: per AAP §0.3.4, finalized features only (no preview flag). -->
        <maven.compiler.release>25</maven.compiler.release>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Maven plugin versions (per AAP §0.5.1) -->
        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.2</maven-surefire-plugin.version>
        <maven-shade-plugin.version>3.6.0</maven-shade-plugin.version>
        <maven-jar-plugin.version>3.4.2</maven-jar-plugin.version>
        <maven-resources-plugin.version>3.3.1</maven-resources-plugin.version>
        <maven-install-plugin.version>3.1.3</maven-install-plugin.version>
        <maven-deploy-plugin.version>3.1.3</maven-deploy-plugin.version>
        <maven-clean-plugin.version>3.4.0</maven-clean-plugin.version>
        <maven-site-plugin.version>3.20.0</maven-site-plugin.version>

        <!--
            Library versions (per AAP §0.5.1).

            Security advisories drove two upgrades since the initial pin
            published in the AAP. The Java agent retains AAP-compliance
            by treating "no forbidden frameworks" + "all artifacts from
            Maven Central" as the binding constraint; minor patch-level
            upgrades to CVE-affected artifacts are explicitly permitted
            under AAP §0.7.2 ("preserve all existing PCI-relevant
            controls" and "the user explicitly excludes ... vulnerable
            dependencies").

              * logback 1.5.12 -> 1.5.19   — addresses CVE-2025-11226
                                              (logback-core <=1.5.18,
                                              fixed in 1.5.19); also
                                              picks up the 1.5.13 SSRF
                                              fix and intermediate
                                              configuration ACE
                                              advisories. Runtime
                                              ServiceLoader contract
                                              and SLF4J 2.x binding
                                              compatibility unchanged
                                              between 1.5.12 and
                                              1.5.19.
              * assertj 3.26.3 -> 3.27.7   — addresses
                                              CVE-2026-24400 (XXE in
                                              assertj-core XML
                                              assertion utilities,
                                              fixed in 3.27.7). Test
                                              scope only; the fix is
                                              backward-compatible.
        -->
        <junit-jupiter.version>5.13.1</junit-jupiter.version>
        <junit-platform.version>1.13.1</junit-platform.version>
        <assertj.version>3.27.7</assertj.version>
        <jqwik.version>1.9.3</jqwik.version>
        <slf4j.version>2.0.16</slf4j.version>
        <logback.version>1.5.19</logback.version>

        <!--
            JaCoCo Maven plugin — enforces AAP §0.6.1 mandate
            ("100% line coverage on monetary code"). Version 0.8.14 is
            required because it is the first release with OFFICIAL
            support for Java 25 class files (major version 69); earlier
            versions (0.8.11–0.8.13) either lack Java 25 support
            entirely or only ship experimental support. Configured in
            the carddemo-tests module to fail `mvn verify` if
            Decimals.java line coverage drops below 100%.
        -->
        <jacoco-maven-plugin.version>0.8.14</jacoco-maven-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Internal module dependencies -->
            <dependency>
                <groupId>com.blitzy.carddemo</groupId>
                <artifactId>carddemo-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.blitzy.carddemo</groupId>
                <artifactId>carddemo-application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.blitzy.carddemo</groupId>
                <artifactId>carddemo-adapter-file</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.blitzy.carddemo</groupId>
                <artifactId>carddemo-adapter-db</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.blitzy.carddemo</groupId>
                <artifactId>carddemo-batch</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.blitzy.carddemo</groupId>
                <artifactId>carddemo-app</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Logging facade and backend -->
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <dependency>
                <groupId>ch.qos.logback</groupId>
                <artifactId>logback-classic</artifactId>
                <version>${logback.version}</version>
            </dependency>

            <!-- Test scope -->
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit-jupiter.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.platform</groupId>
                <artifactId>junit-platform-launcher</artifactId>
                <version>${junit-platform.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>net.jqwik</groupId>
                <artifactId>jqwik</artifactId>
                <version>${jqwik.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <compilerArgs>
                            <!-- Finalized JEPs only per AAP §0.3.4; no preview features enabled. -->
                            <!-- Keep -Xlint warnings on for code-quality signals; tune at module level. -->
                            <arg>-Xlint:all</arg>
                            <arg>-Xlint:-preview</arg>
                            <arg>-Xlint:-serial</arg>
                            <arg>-parameters</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                    <configuration>
                        <!--
                            argLine composition contract:

                            @{argLine} is the Maven late-binding placeholder
                            that JaCoCo's prepare-agent execution writes into
                            during the "initialize" phase. The literal flags
                            that follow (-XX:+EnableDynamicAgentLoading,
                            -Xshare:auto) are the project-wide JVM flags
                            mandated by AAP §0.6.7 (jqwik / AssertJ-style
                            bytecode helpers require dynamic agent loading
                            under JDK 25). Modules that do NOT enable JaCoCo
                            still inherit a benign empty @{argLine} expansion.

                            DO NOT replace @{argLine} with ${argLine} — only
                            the @{} placeholder is reevaluated at every
                            Surefire invocation; ${} is captured once at
                            model-resolution time and would freeze JaCoCo
                            out of the test argLine.
                        -->
                        <argLine>@{argLine} -XX:+EnableDynamicAgentLoading -Xshare:auto</argLine>
                        <includes>
                            <include>**/*Test.java</include>
                            <include>**/*Tests.java</include>
                            <include>**/*Properties.java</include>
                        </includes>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>${maven-shade-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${maven-resources-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>${maven-install-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>${maven-deploy-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>${maven-clean-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-site-plugin</artifactId>
                    <version>${maven-site-plugin.version}</version>
                </plugin>
                <!--
                    JaCoCo Maven plugin — code-coverage measurement and
                    threshold enforcement. The plugin is declared in the
                    parent pluginManagement so every module gets the
                    same version pin (per AAP §0.5.1 pinning discipline).
                    The actual coverage gate is configured in
                    carddemo-tests/pom.xml because that is the module
                    that exercises Decimals.java via DecimalsProperties;
                    AAP §0.6.1 mandates 100% line coverage on monetary
                    code (Decimals.java is the canonical monetary
                    utility).
                -->
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco-maven-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
