<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.blitzy.carddemo</groupId>
        <artifactId>carddemo-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>carddemo-adapter-db</artifactId>
    <packaging>jar</packaging>

    <name>CardDemo Adapter — DB (optional)</name>
    <description>
        Optional JDBC adapter. Empty by default per AAP §0.5.1 — only populated if the
        COBOL source requires a DB2/relational adapter via embedded SQL.
        File-based batch is the default per the AAP architecture override.
        JDBC driver is added with scope=provided at runtime when wired in carddemo-app.
    </description>

    <dependencies>
        <dependency>
            <groupId>com.blitzy.carddemo</groupId>
            <artifactId>carddemo-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
