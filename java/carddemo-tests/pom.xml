        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            jqwik property-based testing library (test scope) — REQUIRED
            for AAP §0.6.1 100% line coverage on monetary code mandate
            and §0.7.2 explicit user mandate ("jqwik property-based
            tests for Decimals").

            Used by the DecimalsProperties.java test class in
            src/test/java/com/blitzy/carddemo/tests/property/ which uses
            jqwik's @Property annotation, @ForAll arbitraries, and
            shrinking/falsification machinery to generate random
            BigDecimal inputs in COBOL-valid ranges and assert
            Java/COBOL agreement on:
              * add / subtract / multiply / divide / round operations
              * MathContext.DECIMAL128 (34-digit precision)
              * COBOL-mandated RoundingMode — HALF_EVEN (banker's
                rounding) for the COBOL ROUNDED clause; DOWN
                (truncation) for default unrounded arithmetic
              * Scale preservation (a BigDecimal value of 1.20 MUST NOT
                be normalized to 1.2 — every monetary operation
                preserves the COBOL implicit decimal position)
              * Sign nybble handling for COMP-3
                (parseSignedPacked / encodeSignedPacked round-trip)
            per AAP §0.6.1.

            jqwik 1.9.3 auto-registers its TestEngine via the
            META-INF/services/org.junit.platform.engine.TestEngine
            service entry; the JUnit Platform launcher 1.13.1 declared
            above is the MINIMUM required version per AAP §0.5.1.

            Version (1.9.3) inherited from the parent POM's
            dependencyManagement per AAP §0.5.1.
        -->
        <dependency>
            <groupId>net.jqwik</groupId>
            <artifactId>jqwik</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                maven-compiler-plugin — activated for this module so the
                parent's pluginManagement (version 3.13.0,
                &lt;release&gt;25&lt;/release&gt;, no preview flag per
                AAP §0.6.7 and §0.7.4, -parameters for record component
                names, -Xlint:all -Xlint:-preview -Xlint:-serial)
                applies during the test-compile phase.

                The Java language level is set ONCE in the parent POM;
                this child must NOT redeclare &lt;source&gt;,
                &lt;target&gt;, or &lt;release&gt; per the agent_prompt
                Phase 2 forbidden-items list.

                CRITICAL: NO "enable-preview" compiler argument (the
                double-dash CLI flag) anywhere in the build per AAP §0.6.7
                and §0.7.4. The test code in
                src/test/java/com/blitzy/carddemo/tests/ uses ONLY
                finalized Java 25 features (records, sealed types,
                pattern matching, java.nio.file, java.time, BigDecimal,
                ScopedValue (JEP 506 Final), virtual threads,
                Module Import Declarations (JEP 511 Final),
                Flexible Constructor Bodies (JEP 513 Final)).
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>

            <!--
                maven-surefire-plugin — activated for this module to run
                JUnit 5 + AssertJ + jqwik tests during the `test` phase
                using JUnit Platform native support.

                Plugin version 3.5.2 inherited from the parent POM's
                pluginManagement (per AAP §0.5.1).

                Module-specific configuration overrides:
                  (1) &lt;includes&gt; — test inclusion patterns covering:
                      * **/*Test.java        — golden-record harness
                                                (e.g., CbAct01CGoldenTest)
                      * **/*Tests.java       — plural-named test classes
                      * **/*Properties.java  — jqwik property tests
                                                (e.g., DecimalsProperties);
                                                jqwik convention per AAP §0.6.11
                                                ("DecimalsProperties.java")
                      * **/*PropertyTest.java — alternate jqwik convention
                  (2) &lt;forkCount&gt;1&lt;/forkCount&gt; +
                      &lt;reuseForks&gt;true&lt;/reuseForks&gt; — JFR-friendly
                      forked-VM lifecycle so the perf baseline tests in
                      JfrBaseline.java can write JFR recordings that
                      capture the full forked VM lifecycle per AAP §0.6.11.
                  (3) &lt;encoding&gt;UTF-8&lt;/encoding&gt; — UTF-8 test
                      output reporting.
                  (4) &lt;systemPropertyVariables&gt; jfr.recording.dir —
                      pointing to ${project.build.directory}/jfr so
                      JfrBaseline.java can write JFR recordings under
                      target/jfr/ per AAP §0.6.11.
                  (5) NO "enable-preview" argument (the double-dash CLI
                      flag) anywhere in the surefire configuration per AAP
                      §0.6.7 and §0.7.4. The argLine inherited from the
                      parent pluginManagement
                      (-XX:+EnableDynamicAgentLoading -Xshare:auto) is
                      preserved unmodified to avoid disabling the
                      parent's dynamic-agent-loading suppression for
                      AssertJ / Mockito-style bytecode helpers.

                CRITICAL for running the non-negotiable PR-gate harness
                per AAP §0.6.11: golden-record byte-for-byte parity,
                jqwik property tests on Decimals, and JFR 10% regression
                band assertions all execute through this plugin.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!--
                        Test discovery patterns — covers BOTH JUnit
                        Jupiter (@Test) and jqwik (@Property) conventions.
                        The default surefire pattern *Test.java alone
                        would miss jqwik property test class names that
                        follow the *Properties.java convention used in
                        AAP §0.6.11 ("DecimalsProperties.java") and the
                        *PropertyTest.java convention.
                    -->
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                        <include>**/*Properties.java</include>
                        <include>**/*PropertyTest.java</include>
                    </includes>

                    <!--
                        Forked VM lifecycle for JFR — forkCount=1 +
                        reuseForks=true is the JFR-friendly default
                        because JFR captures the full forked VM
                        lifecycle (startup, JIT compilation, GC events,
                        thread births including virtual threads) which
                        the 10% regression band assertions in
                        JfrBaseline.java rely on per AAP §0.6.11.
                    -->
                    <forkCount>1</forkCount>
                    <reuseForks>true</reuseForks>

                    <!--
                        UTF-8 test output reporting — required so that
                        non-ASCII bytes captured from EBCDIC IBM-1047
                        transcoding mismatches and from byte-diff
                        diagnostics surface correctly in CI logs per
                        AAP §0.6.5.
                    -->
                    <encoding>UTF-8</encoding>

                    <!--
                        System properties available to tests.
                        jfr.recording.dir is consumed by
                        src/test/java/com/blitzy/carddemo/tests/perf/
                        JfrBaseline.java to choose where JFR recordings
                        are written per AAP §0.6.11. The directory is
                        cleaned by `mvn clean` along with the rest of
                        target/.
                    -->
                    <systemPropertyVariables>
                        <jfr.recording.dir>${jfr.recording.dir}</jfr.recording.dir>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <!--
                ================================================================
                JaCoCo Maven plugin — 100% line-coverage gate for the
                Decimals utility (AAP §0.6.1).

                AAP §0.6.1 ("Coverage requirement: 100% line coverage on
                monetary code") makes this a mandatory PR gate. The
                DecimalsProperties.java jqwik property test exercises
                every Decimals helper; the JaCoCo agent measures line
                coverage and the `check` execution fails the build if
                line coverage on Decimals.java drops below 100%.

                Execution order:
                    1. prepare-agent  (initialize phase) — instruments
                       JVM via -javaagent:jacocoagent.jar
                    2. surefire test  (test phase) — runs the property
                       tests, JaCoCo records line execution
                    3. report  (verify phase) — produces HTML / CSV /
                       XML reports under target/site/jacoco/
                    4. check  (verify phase) — enforces the 100% line
                       coverage threshold on Decimals.java

                The `mvn verify` lifecycle therefore acts as the
                AAP-mandated coverage gate; the build fails if the
                Decimals utility regresses below 100% line coverage,
                exactly as required by AAP §0.6.1.

                Scope: only the Decimals utility (carddemo-domain) is
                gated at 100%. Other classes in carddemo-domain are
                covered by the same JaCoCo report (so the broader
                coverage picture is visible) but are NOT gated at 100%
                because the AAP only mandates 100% for the
                "monetary code" surface.
                ================================================================
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <!--
                        Step 1 — instrument the test JVM.
                        Binds JaCoCo's java agent into the surefire
                        `argLine` so the agent runs alongside the
                        property tests.
                    -->
                    <execution>
                        <id>jacoco-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>

                    <!--
                        Step 2 — generate human + machine readable
                        reports (HTML, CSV, XML) under
                        target/site/jacoco/ at the start of the
                        `verify` phase.

                        Because carddemo-tests has no main sources of
                        its own, the `report` goal would normally
                        produce an empty report. The `prepare-package`
                        execution below (jacoco-stage-domain-classes)
                        stages a copy of carddemo-domain's compiled
                        classes (specifically Decimals.class and any
                        utility-package siblings) into this module's
                        target/classes/ before the verify phase runs;
                        this makes the report goal find Decimals.class
                        and the check goal find its bytecode for rule
                        evaluation.
                    -->
                    <execution>
                        <id>jacoco-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>

                    <!--
                        Step 3 — enforce the 100% line coverage gate on
                        Decimals.java only. The build fails if any
                        line of Decimals.java is uncovered. Other
                        classes are not checked here; they remain
                        visible in the report but unconstrained.

                        AAP §0.6.1 binding: "Coverage requirement:
                        100% line coverage on monetary code".
                        Decimals.java is the canonical monetary code
                        surface per AAP §0.3.3 ("the Decimals utility
                        is the central facade for all monetary
                        arithmetic"); other monetary computations in
                        the application layer call into Decimals and
                        are exercised transitively by the property
                        tests and the golden-record harness.

                        Implementation detail (MIGRATION_NOTES.md
                        §1.12.6): the JaCoCo check goal scans
                        ${project.build.outputDirectory} for class
                        files matching the `<includes>` rule. Because
                        carddemo-tests has no main sources of its own,
                        we stage Decimals.class from carddemo-domain
                        into this module's target/classes/ via the
                        sibling `jacoco-stage-domain-classes`
                        execution defined below. JaCoCo 0.8.5+ then
                        automatically filters the utility-class
                        private constructor of Decimals (per
                        DecimalsProperties.decimalsIsUtilityClass()'s
                        Javadoc note) so the rule passes at exactly
                        100% line coverage.
                    -->
                    <execution>
                        <id>jacoco-check-decimals-100pct</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>com.blitzy.carddemo.domain.util.Decimals</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>1.00</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
                maven-resources-plugin — stage carddemo-domain's compiled
                Decimals.class into this module's target/classes/ so
                JaCoCo's check goal can locate the bytecode for rule
                evaluation.

                Why this is required: carddemo-tests has no main sources
                (its only sources live under src/test/java/), so its
                target/classes/ is empty at the verify phase. JaCoCo's
                report and check goals scan ${project.build.outputDirectory}
                for .class files to apply rules; without staging, the
                Decimals rule evaluates against an empty class set and
                silently passes (vacuous truth). Staging makes the rule
                non-vacuous and enforces the 100% line coverage gate per
                AAP §0.6.1.

                Staging is bound to `prepare-package` (before verify) so
                the report and check executions above find the .class file.
                The reactor order is:
                  1. carddemo-domain: compile → Decimals.class produced
                  2. ... other modules ...
                  3. carddemo-tests: compile → test (jacoco.exec written)
                                  → prepare-package: stage Decimals.class
                                  → verify: jacoco report + check
                so the dependency on carddemo-domain's compiled output is
                satisfied before staging runs.

                The included pattern is scoped narrowly to the Decimals
                class (and any utility-package siblings) so we do NOT
                pollute the report with unrelated domain classes that
                are not part of the 100% monetary-coverage gate.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>jacoco-stage-domain-classes</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.parent.basedir}/carddemo-domain/target/classes</directory>
                                    <includes>
                                        <include>com/blitzy/carddemo/domain/util/Decimals.class</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>

