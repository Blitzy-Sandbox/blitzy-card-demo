# =============================================================================
# CardDemo — local environment template (.env.example)
#
# Copy this file to `.env` in the repository root and replace every placeholder
# with a real value, then run `docker compose up -d`:
#
#     cp .env.example .env
#     # edit .env, fill in the secrets below
#     docker compose up -d
#
# `.env` is git-ignored and MUST NOT be committed; only this `.env.example`
# template (placeholders only — never real secrets) is tracked. Docker Compose
# auto-loads `.env` from the project directory. Rationale: DECISION_LOG D-036
# (fail-fast runtime secrets, no committed credential defaults).
#
# The three secrets below have NO defaults anywhere: `docker compose up` aborts
# with a clear message if any is unset or empty.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED SECRETS — replace the placeholder values before first use.
# -----------------------------------------------------------------------------

# PostgreSQL password for the application's database user. Used by BOTH the
# `postgres` service (to initialize the DB) and the `app` service (to connect).
# Choose any strong local value.
POSTGRES_PASSWORD=change-me-local-db-password

# JWT signing secret for the stateless REST API. Must be a Base64-encoded key
# that decodes to AT LEAST 32 bytes (256 bits), as required by HS256. Generate a
# fresh one with:
#     openssl rand -base64 48
# The placeholder below is a VALID-FORMAT but NON-SECRET example — replace it.
JWT_SECRET=UkVQTEFDRV9NRV9ydW5fb3BlbnNzbF9yYW5kX2Jhc2U2NF80OF90b19nZW5lcmF0ZQ==

# Grafana admin password (for the local dashboards UI at http://localhost:3000).
GF_SECURITY_ADMIN_PASSWORD=change-me-local-grafana-password

# -----------------------------------------------------------------------------
# OPTIONAL — non-secret overrides. Uncomment only to change the defaults shown.
# -----------------------------------------------------------------------------

# Database name / user (non-secret identifiers; default to "carddemo").
# POSTGRES_DB=carddemo
# POSTGRES_USER=carddemo

# Grafana admin username (non-secret; defaults to "admin").
# GF_SECURITY_ADMIN_USER=admin

# Published host ports (container-internal ports never change). Override to avoid
# collisions when running several stacks on one Docker host.
# APP_PUBLISHED_PORT=8080
# LOCALSTACK_PUBLISHED_PORT=4566
# PROMETHEUS_PUBLISHED_PORT=9090
# GRAFANA_PUBLISHED_PORT=3000
# JAEGER_UI_PORT=16686

# LocalStack Pro license token — ONLY needed if you switch the localstack service
# to a Pro image. The default community image does not require it.
# LOCALSTACK_AUTH_TOKEN=

# AWS credentials are NOT set here: the app talks only to LocalStack and the
# compose file already supplies the conventional dummy values (test/test). They
# are not real secrets.
