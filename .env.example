# ============================================================================
# CardDemo — example environment file  (COPY, DO NOT COMMIT YOUR REAL .env)
# ----------------------------------------------------------------------------
# Quick start on a clean machine:
#
#     cp .env.example .env
#     # (optional) edit .env to change any dev credential
#     docker compose up -d                 # starts Postgres, LocalStack, etc.
#     export $(grep -v '^#' .env | xargs)  # load vars into your shell
#     mvn spring-boot:run -Dspring-boot.run.profiles=local
#
# Docker Compose automatically reads a file literally named `.env` in this
# directory, so `docker compose up` picks these up with no extra step. The
# Spring Boot `local` profile reads the SAME variable names (DB_*, AWS_*,
# JWT_SECRET, OTLP_ENDPOINT), so one file configures both the infra stack and
# the app in lock-step.
#
# SECURITY: every value below is a DEV-ONLY, NON-PRODUCTION default — safe for
# a laptop running against LocalStack + a throwaway Postgres. NONE of these are
# production secrets. Your real `.env` is git-ignored (see .gitignore) and MUST
# NOT be committed. Production supplies these via the environment or a vault,
# and the `prod` profile has NO baked-in defaults — it fails fast if any
# required value is missing (AAP §0.8.1).
# ============================================================================

# ----------------------------------------------------------------------------
# JWT signing secret  (REQUIRED — the app will NOT start without it)
# ----------------------------------------------------------------------------
# Replaces the CICS pseudo-conversational COMMAREA with a stateless JWT session.
# Must be at least 32 bytes for HS256. The value below is a DEV-ONLY example so
# `local` runs work out of the box; generate your own strong secret with, e.g.:
#     openssl rand -base64 48
# There is intentionally NO fallback in any profile: an unset JWT_SECRET fails
# fast at startup (Issue 4) instead of silently booting with a weak key.
JWT_SECRET=local-dev-only-change-me-please-0123456789abcdef0123456789

# ----------------------------------------------------------------------------
# PostgreSQL 16  (system of record — replaces VSAM KSDS / sequential files)
# ----------------------------------------------------------------------------
# These drive BOTH the `postgres` container (POSTGRES_DB/USER/PASSWORD default
# from them) and the app's spring.datasource.* connection, so they stay in sync.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=carddemo
DB_USERNAME=carddemo
DB_PASSWORD=carddemo

# ----------------------------------------------------------------------------
# AWS via LocalStack  (S3 GDG staging + SQS FIFO report bridge; ZERO live AWS)
# ----------------------------------------------------------------------------
# `test`/`test` are the conventional LocalStack dummy credentials — they are not
# real AWS keys and grant no access to any live account.
AWS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Optional LocalStack Pro token. Leave EMPTY to run the free community image
# (this project only needs S3 + SQS + SNS, all free). NEVER hardcode a real one.
LOCALSTACK_AUTH_TOKEN=

# ----------------------------------------------------------------------------
# Observability  (OpenTelemetry / Jaeger + Grafana dashboard login)
# ----------------------------------------------------------------------------
# OTLP span exporter endpoint (Jaeger all-in-one, gRPC receiver).
OTLP_ENDPOINT=http://localhost:4317

# Grafana dashboard admin login (dev only — change for any shared instance).
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
