# ==========================================================================
# HOW THIS TEMPLATE IS KEPT HONEST
# ==========================================================================
# Two invariants hold over this file, and
# src/test/java/com/cardemo/unit/config/EnvironmentTemplateContractTest.java
# asserts both on every build:
#
#   1. COMPLETE. Every ${NAME} placeholder that src/main/resources/
#      application.yml, -local.yml, -test.yml or -prod.yml reads is assigned
#      below. A placeholder with no entry here is a setting a developer
#      cannot discover without reading the profiles.
#   2. LIVE. Every name assigned below is read by at least one committed
#      consumer - an application*.yml placeholder, docker-compose.yml,
#      localstack-init/init-aws.sh, pom.xml, .github/workflows/build.yml, or
#      Spring's own relaxed binding for SPRING_PROFILES_ACTIVE. A name that
#      no file reads documents a setting that does not exist.
#
# ONE CONSEQUENCE IS WORTH STATING OUTRIGHT, BECAUSE IT WAS A REAL DEFECT.
# A variable that binds a Spring property DIRECTLY outranks every profile
# file: SPRING_DATASOURCE_URL binds spring.datasource.url and
# MANAGEMENT_OTLP_TRACING_ENDPOINT binds management.otlp.tracing.endpoint.
# While either is exported the composed placeholders in application.yml are
# never evaluated. An earlier revision of this template shipped both of
# those AND omitted POSTGRES_HOST and OTEL_EXPORTER_OTLP_ENDPOINT, so a
# developer who copied it verbatim booted successfully while the decomposed
# form the base profile is built on went completely unexercised - the
# template appeared to work and documented the wrong contract.
#
# Only the decomposed form is shipped below. A deployment that prefers to
# supply a whole URL sets SPRING_DATASOURCE_URL deliberately, in its own
# environment, INSTEAD OF the POSTGRES_* group; the same applies to
# MANAGEMENT_OTLP_TRACING_ENDPOINT and OTEL_EXPORTER_OTLP_ENDPOINT. Never
# ship both spellings for one value in one environment.
#
# Each entry below names its consumer. "REQUIRED" means the profile reads it
# with no fallback, so an absent value aborts startup with the variable named
# and no value echoed.

# ==========================================================================
# COPY, CONFIGURE, RUN, BUILD, AND TEST
# ==========================================================================
# 1. Copy, never rename, this tracked template:
#      cp .env.example .env
# 2. In the ignored `.env`, set JWT_SIGNING_KEY, POSTGRES_PASSWORD,
#    CARDDEMO_DB_APP_PASSWORD, CARDDEMO_DB_MIGRATION_PASSWORD,
#    GRAFANA_ADMIN_PASSWORD and METRICS_SCRAPE_PASSWORD - six values, every
#    one of them guarded, none of them defaulted. Generate them out of band
#    and paste only into `.env`: use `openssl rand -base64 48` for the JWT key
#    and `openssl rand -base64 32` for each password.
# 3. Validate interpolation before creating anything:
#      docker compose --env-file .env config
# 4. Build and run the local topology:
#      docker compose --env-file .env up -d --build
#
# Canonical build and test entry points use the pinned Maven wrapper:
#   ./mvnw -B -ntp clean compile
#   ./mvnw -B -ntp test
#   ./mvnw -B -ntp clean verify
# Full `verify` additionally needs a reachable container daemon for integration
# tests and network access (plus NVD_API_KEY for practical dependency-feed
# updates). Never put a generated value on a command line or in a tracked file.
#
# EXPECTED FAILURE MODES. Compose rejects an empty required JWT, PostgreSQL,
# least-privilege role, Grafana or scrape credential during `config`, before it
# creates a container. A direct host-side application run fails placeholder
# resolution when a required database/AWS/JWT value is absent; a short JWT key
# fails validation. A non-local AWS endpoint is refused before an SDK call. If
# a host-side run deliberately leaves the scrape password blank, metrics fail
# closed with 401. Every one of these is a refusal to start, never a silent
# fallback to a wider-privileged principal or a committed default.

# ==========================================================================
# Application
# ==========================================================================
# Active Spring profile: local | test | prod. Consumed by Spring's own
# relaxed binding for spring.profiles.active; the base profile deliberately
# declares no default so an unprofiled boot is visible.
SPRING_PROFILES_ACTIVE=local
# Consumed by application.yml server.port and by docker-compose.yml.
SERVER_PORT=8080
# HOST interface every docker-compose.yml port mapping binds to - the single
# network-exposure lever for the whole topology. 127.0.0.1 by default, and
# deliberately not 0.0.0.0: that default is a security control rather than a
# convenience. The local profile this topology activates opens the
# demonstration-user gate of db/migration/V3__seed_data.sql, whose ten
# principals - five of them administrators - share one plaintext recorded in
# the frozen app/jcl/DUSRSECJ.jcl, and several substrate components
# authenticate weakly or not at all:
#   - PostgreSQL holds the seeded customer rows, including the nine-digit
#     government identifier of app/cpy/CVCUS01Y.cpy;
#   - LocalStack community edition CANNOT enforce IAM (measured, not assumed -
#     see the ENFORCE_IAM comment in docker-compose.yml), so anything that
#     reaches its edge can read and delete every object in every bucket;
#   - the Jaeger UI and its published OTLP receiver carry no credential at all,
#     so an exposed collector can be both read and injected into;
#   - the Prometheus query API answers without authentication.
# Override it ONLY with a deliberate reason, never to 0.0.0.0 on a shared or
# untrusted network, and never together with the demonstration seed. To reach
# the stack from elsewhere, prefer an SSH tunnel over widening this bind.
CARDDEMO_BIND_ADDRESS=127.0.0.1
# IANA zone identifier for the single production Clock bean that every
# service and batch component injects. Consumed by application.yml
# carddemo.time.zone. Not a secret, so a default is documented; an
# unrecognised value aborts startup with the value named.
CARDDEMO_TIME_ZONE=UTC

# ==========================================================================
# Security - JWT_SIGNING_KEY is REQUIRED, has no default, and fails fast
# ==========================================================================
# HMAC signing key for issued JWTs, bound by
# carddemo.security.jwt.signing-key. Must be at least 32 bytes of entropy
# because HS256 rejects anything shorter.
# Generate one with:  openssl rand -base64 48
# NEVER commit a real value: this template ships the name and no value, which
# is what makes the application's fail-fast path the observable default.
JWT_SIGNING_KEY=
# Token lifetime in MINUTES, bound by
# carddemo.security.jwt.expiration-minutes. Accepted range 1..1440; the
# application default is 30. Minutes, not seconds: an earlier revision of this
# template expressed the lifetime as JWT_EXPIRATION_SECONDS=3600, which is
# double the approved thirty-minute bearer window, and a bearer token cannot be
# revoked before it expires. Both names are non-secret metadata, so a
# documented default is safe here where a signing-key default would not be.
JWT_EXPIRATION_MINUTES=30
# Issuer claim written into and required of every token (default carddemo).
JWT_ISSUER=carddemo

# ==========================================================================
# PostgreSQL 16 - replaces the 10 VSAM KSDS clusters in app/catlg/LISTCAT.txt
#
# The datasource URL is COMPOSED from three of these names so that no
# hostname, port or database name is hardcoded in any profile. POSTGRES_HOST
# and POSTGRES_DB carry no fallback in application.yml; POSTGRES_PORT defaults
# to the IANA-registered port.
#
# POSTGRES_USER and POSTGRES_PASSWORD are the CLUSTER BOOTSTRAP pair and NO
# PROFILE READS EITHER. They initialise the database container and are consumed
# by docker-compose.yml alone; the application connects with the dedicated
# least-privilege roles documented below, and is not even passed the bootstrap
# credential. See LEAST PRIVILEGE further down for why.
# ==========================================================================
# REQUIRED, and previously missing from this contract. application.yml composes
# spring.datasource.url from ${POSTGRES_HOST} with NO DEFAULT, so an unset value
# aborts startup with an unresolvable-placeholder failure. Use `localhost` for a
# host-side run against the port docker-compose.yml publishes, or the Compose
# service name `carddemo-postgres` from inside the Compose network - `postgres`
# when the application itself runs on that network under its service alias.
POSTGRES_HOST=localhost
# The IANA-registered port. Consumed by application.yml and by
# docker-compose.yml, which publishes it.
POSTGRES_PORT=5432
POSTGRES_DB=carddemo
# The cluster BOOTSTRAP role, which the official postgres image creates as a
# SUPERUSER. Consumed by docker-compose.yml's database service to initialise the
# cluster, by its pg_isready healthcheck, and by the role-provisioning script
# that runs as it. No profile binds it.
POSTGRES_USER=carddemo
# REQUIRED by the database service. Deliberately EMPTY: choose a unique value in
# `.env`; there is no committed database credential. It is NOT passed to the
# application container, which has no use for a superuser credential.
POSTGRES_PASSWORD=

# --------------------------------------------------------------------------
# OPTIONAL. The ceiling, in milliseconds, on how long a statement waits for a
# ROW LOCK before giving up. Defaults to 5000 in application.yml.
#
# app/cbl/COACTUPC.cbl:3907-3915 has a defined answer for a lock it cannot
# take - the literal at :517-518, which becomes a 423 - but reaching it needs
# the attempt to FAIL, and PostgreSQL waits forever by default. Without this
# ceiling a row held by another transaction stalled the request indefinitely
# and, at maximum-pool-size 10, a few stalled writers exhausted the pool.
#
# This is a WAIT CEILING, not a performance target, and it is not pool tuning
# (which the AAP defers). Raise it if a batch step must contend for a row an
# online writer holds. Zero means wait forever and restores the defect, so it
# is not the default. statement_timeout is deliberately not set anywhere: it
# would cap the batch stream, whose steps legitimately run long.
POSTGRES_LOCK_TIMEOUT_MS=5000

# --------------------------------------------------------------------------
# LEAST PRIVILEGE FOR THE RUNTIME DATABASE PRINCIPAL (Rule 1 Clause D)
#
# POSTGRES_USER above is the CLUSTER BOOTSTRAP role. The official postgres
# image creates it as a SUPERUSER, and a superuser ignores every grant, every
# row-level policy and every column privilege - so an application connected as
# that role holds far more authority than the eleven tables it touches.
#
# The two pairs below split that authority in three: the runtime connects with
# DML only, DDL stays with a separate migration role, and the bootstrap
# superuser is used for neither.
#
#   CARDDEMO_DB_APP_USER / _PASSWORD        the runtime principal. SELECT,
#       INSERT, UPDATE, DELETE on the eleven domain tables and the Spring Batch
#       metadata tables, plus USAGE, SELECT and UPDATE on their sequences.
#       No CREATE, no DROP, no ALTER, no TRUNCATE, NOSUPERUSER, NOCREATEDB,
#       NOCREATEROLE, NOBYPASSRLS, NOREPLICATION, NOINHERIT of any admin role.
#   CARDDEMO_DB_MIGRATION_USER / _PASSWORD  Flyway only. Owns the schema and
#       may create, alter and drop within it, but is never used to serve a
#       request. Flyway needs DDL; the runtime does not, and giving one role
#       both is what made the finding possible.
#
# ALL FOUR ARE REQUIRED WHEREVER A ROLE IS BOUND AT ALL - the base profile,
# `local` and `prod` alike - and not one of them falls back to POSTGRES_USER or
# POSTGRES_PASSWORD any longer. That fallback was a transition aid, and while
# it existed an absent value silently reconnected the runtime as the bootstrap
# SUPERUSER, which is the exact condition this block exists to prevent. The
# contract is fail-closed in three places at once:
#
#   * application.yml binds ${CARDDEMO_DB_APP_USER} and
#     ${CARDDEMO_DB_APP_PASSWORD} with NO default and NO fallback, and
#     application-local.yml and application-prod.yml bind the migration pair
#     the same way, so an absent value aborts startup naming the variable and
#     echoing no value.
#   * docker-compose.yml guards all four with Compose's `:?` on both the
#     application and the database service, so `docker compose config` fails
#     before a container is created.
#   * the role-provisioning step exits NON-ZERO when any of the four is unset
#     or empty. It used to exit 0 and log that it was skipping, which left the
#     superuser in place and reported success for having done so.
#
# THE TWO ROLE NAMES ARE NOT SECRETS AND SHIP WITH THEIR CONVENTIONAL VALUES;
# THE TWO PASSWORDS ARE SECRETS AND SHIP EMPTY. `carddemo_app` and
# `carddemo_migrator` are role NAMES the provisioning step creates, never
# passwords: an earlier revision of this template assigned those same two
# strings as the passwords as well, which made them predictable, and that is
# what this block now forbids. That earlier revision also assigned all four
# names a second time further down the file, and because a later assignment
# wins, those working values silently overrode the empty quartet above - the
# whole least-privilege section had been duplicated, which is how the override
# went unnoticed. The duplicate is removed, uniqueness is now asserted, and no
# database credential is committed anywhere in this repository.
#
# GENERATE LOCAL-ONLY PASSWORDS AT SETUP TIME, into your own .env, which is
# gitignored and must never be committed:
#   for name in CARDDEMO_DB_APP_PASSWORD CARDDEMO_DB_MIGRATION_PASSWORD; do
#     printf '%s=%s\n' "$name" "$(openssl rand -base64 24)" >> .env
#   done
# The two passwords must be freshly generated per environment; a committed
# default password is a committed secret however local it is intended to be
# (Rule 1 Clause D).
#
# HOST-SIDE SPRING RUNS DISTINGUISH ABSENT FROM EMPTY. Spring aborts startup
# with an unresolvable-placeholder failure when a variable is ABSENT, and
# resolves an EMPTY export to an empty string, which PostgreSQL then refuses
# at authentication. Both fail loudly and neither reaches the superuser, so
# before sourcing `.env` for `spring-boot:run` set both passwords rather than
# exporting them blank.
#
# ALL FOUR VALUES FORM ONE ATOMIC SET, and continuous integration asserts that
# on the RENDERED topology rather than on the committed text: the name and the
# password each service receives, and the name the provisioning script derives,
# must all agree, and no name may resolve to POSTGRES_USER. The workflow
# therefore exports both names beside the two values it generates.
#
# The roles themselves are created by an INLINE CONFIG in docker-compose.yml,
# `postgres-least-privilege-roles`, mounted read only into the database
# container at /docker-entrypoint-initdb.d/10-least-privilege-roles.sh. There
# is no checked-in SQL file for it. It creates ROLES AND GRANTS ONLY - never a
# table, an index or a row, all of which belong to Flyway's three migrations -
# and it is idempotent, so repeated Compose cycles converge. It imports both
# passwords with psql's `\getenv` from the container environment instead of
# passing them as `--set` arguments, so neither value appears in process argv,
# and it unsets both once psql has exited. With any of the four absent it
# REFUSES instead of skipping, so no start can leave the roles uncreated and the
# runtime quietly on the superuser.
#
# Note the standard postgres-image behaviour: /docker-entrypoint-initdb.d runs
# ONLY when the data directory is empty. On a volume that already exists the
# mount is still present, so apply it once by hand - it needs no arguments,
# because Compose already exports all four values onto that container:
#   docker exec carddemo-postgres sh /docker-entrypoint-initdb.d/10-least-privilege-roles.sh
#
# NO FIRST-START ORDERING DANCE IS NEEDED, and an earlier revision of this note
# claimed otherwise. The Spring Batch metadata tables (BATCH_*) are indeed not
# created by Flyway - they come from the framework's own
# org/springframework/batch/core/schema-postgresql.sql - but
# com.cardemo.config.BatchConfig#batchMetadataInitializer runs that script
# through the role named by spring.flyway.user, which is the migration role and
# does hold CREATE, and then proves through the runtime DataSource that all six
# metadata tables are readable by the runtime role, failing startup when any is
# not. A brand-new volume therefore wants all four values from the very first
# start, and nothing has to be applied as the superuser at any point.
CARDDEMO_DB_APP_USER=carddemo_app
CARDDEMO_DB_APP_PASSWORD=
CARDDEMO_DB_MIGRATION_USER=carddemo_migrator
CARDDEMO_DB_MIGRATION_PASSWORD=

# ==========================================================================
# AWS via LocalStack - zero live credentials, ever
#
# AwsConfig enforces an endpoint allowlist at startup: the resolved endpoint
# host must be a LocalStack or loopback host, so no value here can reach a
# real AWS account.
# ==========================================================================
# THE NEXT FOUR VARIABLES ARE MANDATORY IN EVERY PROFILE, INCLUDING prod.
# application.yml binds spring.cloud.aws.credentials.access-key, .secret-key,
# the three spring.cloud.aws.*.endpoint keys and spring.cloud.aws.region.static
# to them with NO literal default, so an unset variable fails placeholder
# resolution and the application does not start. That is deliberate: an absent
# endpoint override is the SDK's instruction to resolve the REAL regional
# service edge, and an absent credential is the library's instruction to fall
# back to the ambient provider chain - a shared credentials file, a
# web-identity token, container credentials, the instance metadata service. AAP
# 0.3.2 forbids both outright, so neither may be left to a default.
#
# The endpoint is ALLOWLISTED rather than merely non-blank.
# com.cardemo.config.AwsConfig and localstack-init/init-aws.sh both accept only
# localhost, 127.0.0.1, [::1], localstack, localhost.localstack.cloud and the
# compose container name carddemo-localstack (optionally -<CLONE_INDEX>).
# Anything else aborts startup. There is no value of AWS_ENDPOINT_URL that
# legitimately names a real AWS host.
#
# The credential pair below is the conventional emulator pair. The SDK requires
# a syntactically valid pair in order to sign a request at all; LocalStack
# ignores their contents, so `test`/`test` is not a secret and is safe to ship
# in this example file. AwsConfig additionally refuses any access key carrying
# the AKIA or ASIA prefix AWS assigns to real identifiers, so a pasted
# production credential fails startup rather than being accepted silently.
# Never put a live key here or in a committed .env. Consumed by
# application.yml, application-local.yml, docker-compose.yml and
# localstack-init/init-aws.sh. REQUIRED.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# The region chain resolves AWS_REGION first and falls back to
# AWS_DEFAULT_REGION, which carries no further fallback. Ship both so either
# spelling works and neither is a surprise. AWS_DEFAULT_REGION is REQUIRED.
AWS_DEFAULT_REGION=us-east-1
# Preferred over AWS_DEFAULT_REGION when set, matching AWS CLI precedence and
# the resolution order localstack-init/init-aws.sh documents. Shipped with a
# value rather than empty: application.yml resolves the chain as
# ${AWS_REGION:${AWS_DEFAULT_REGION}}, and a variable exported as the EMPTY
# STRING satisfies the placeholder and beats the fallback, which would bind an
# empty region and abort startup. Set both spellings to the same value.
AWS_REGION=us-east-1
# The single endpoint override every AWS client uses. REQUIRED, and
# allowlisted: AwsConfig aborts startup on a host that is neither a
# LocalStack host nor loopback.
AWS_ENDPOINT_URL=http://localhost:4566
# Published LocalStack port. Consumed by docker-compose.yml.
LOCALSTACK_PORT=4566
# LocalStack request-log verbosity. `0` is the deterministic quiet default;
# set `1` temporarily when following the LocalStack troubleshooting flow.
# Consumed by docker-compose.yml as `${LOCALSTACK_DEBUG:-0}`.
LOCALSTACK_DEBUG=0
# Pinned so the topology is reproducible, and pinned to the community image
# because S3, SQS and SNS are all community-tier services - CardDemo needs no
# Pro licence and no Pro auth token, so none is shipped here. Consumed by
# docker-compose.yml.
#
# Tag AND digest, spelled exactly as the default in docker-compose.yml, so
# copying this template keeps the immutable pin instead of silently relaxing it
# to whatever the tag points at today. The digest is a multi-arch manifest
# list, so an arm64 host still resolves its own layers. Drop the `@sha256:...`
# suffix only when deliberately moving to another release, and change both
# files together.
LOCALSTACK_IMAGE=localstack/localstack:4.14.0@sha256:3ebc37595918b8accb852f8048fef2aff047d465167edd655528065b07bc364a

# Resource names. Each variable carries the service it addresses in its name -
# CARDDEMO_S3_*, CARDDEMO_SQS_*, CARDDEMO_SNS_* - so the same spelling is used
# by this file, by docker-compose.yml and by localstack-init/init-aws.sh. The
# names below ARE the published contract: renaming one here without renaming it
# in the other two files silently reverts that resource to its default.
#
# S3 buckets replacing the 7 GDG bases of app/jcl/DEFGDGB.jcl
CARDDEMO_S3_BATCH_INPUT_BUCKET=carddemo-batch-input
CARDDEMO_S3_BATCH_OUTPUT_BUCKET=carddemo-batch-output
CARDDEMO_S3_STATEMENTS_BUCKET=carddemo-statements
# SQS FIFO queue replacing DEFINE TDQUEUE(JOBS) in app/csd/CARDDEMO.CSD
CARDDEMO_SQS_REPORT_QUEUE=carddemo-report-jobs.fifo
# SNS notification topic reproducing the NOTIFY=&SYSUID card at
# app/cbl/CORPT00C.cbl:L86. EXACTLY ONE topic is provisioned; no alert topic
# exists, because nothing in the application publishes to or subscribes from
# a second one.
CARDDEMO_SNS_NOTIFICATION_TOPIC=carddemo-notifications

# --------------------------------------------------------------------------
# OPTIONAL. Readiness polling for localstack-init/init-aws.sh, the script that
# provisions the three buckets, the FIFO queue and the topic above. All three
# keys are read as `${NAME-default}`, so an UNSET key takes the default while a
# key exported EMPTY is a configuration error the script refuses by name - it
# validates each one against a bounded range before it touches any resource,
# rather than letting a typo become a hang.
#
#   INIT_MAX_ATTEMPTS            integer, default 30, range 1-3600, optional.
#       How many times the script probes the LocalStack health endpoint before
#       giving up. Raise it on a slow or loaded host; the script's own failure
#       message says so.
#   INIT_SLEEP_SECONDS           integer, default 2, range 0-60, optional.
#       Delay between those attempts. Zero is permitted and means poll without
#       pausing. Write it WITHOUT a leading zero: `08` is rejected, because a
#       leading zero reads as octal in shell arithmetic and that ambiguity was
#       a real abort rather than a hypothetical one.
#   INIT_HEALTH_TIMEOUT_SECONDS  integer, default 5, range 1-300, optional.
#       Per-probe network timeout, so one unresponsive probe cannot consume the
#       whole attempt budget.
#
# The defaults give a ceiling of about 60 seconds of waiting, which is ample
# for the Compose topology. They are left commented out rather than assigned,
# so the shipped template exercises the same default path the script does.
#INIT_MAX_ATTEMPTS=30
#INIT_SLEEP_SECONDS=2
#INIT_HEALTH_TIMEOUT_SECONDS=5

# ==========================================================================
# Observability - capability the COBOL corpus lacks entirely
# ==========================================================================
# OTLP span destination. The base profile reads it with NO fallback so a
# missing collector fails loudly: Boot gates its OTLP span exporter on
# @ConditionalOnProperty, so an absent value would create no exporter and
# drop every span in silence. It MUST be the HTTP receiver on 4318 with the
# /v1/traces path, not the gRPC receiver on 4317. REQUIRED.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# Published Jaeger ports. Consumed by docker-compose.yml; the HTTP port is
# also read by application-local.yml. There is deliberately no
# JAEGER_OTLP_GRPC_PORT: docker-compose.yml does not publish the gRPC
# receiver, because no client in this project speaks OTLP over gRPC, and a
# documented variable that maps nothing is a variable that misleads.
JAEGER_UI_PORT=16686
JAEGER_OTLP_HTTP_PORT=4318
# Published Prometheus and Grafana settings. Consumed by docker-compose.yml.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
# REQUIRED by docker-compose.yml and deliberately EMPTY. Set a unique value in
# `.env`; Compose fails during interpolation rather than starting Grafana with
# a shared default administrator password.
GRAFANA_ADMIN_PASSWORD=
# --------------------------------------------------------------------------
# Metrics scrape credential - the ONE management endpoint that is not
# anonymous
# --------------------------------------------------------------------------
# /actuator/prometheus renders BUSINESS series - transaction volumes, reject
# counts tagged by reject code, authentication attempt counts - so it is a
# disclosure surface rather than a liveness signal, and
# com.cardemo.config.SecurityConfig#metricsScrapeFilterChain requires HTTP
# Basic credentials carrying the SCRAPE authority to read it.
# /actuator/health, its two probe paths and /actuator/info stay anonymous
# because the image's HEALTHCHECK probes readiness with no credential.
#
# NOT fail-fast, unlike JWT_SIGNING_KEY: leaving these blank does NOT stop the
# application starting. The chain FAILS CLOSED instead - with either half
# blank it holds zero principals and answers every scrape 401, so the
# monitoring stack shows the target down within one scrape interval. Losing
# metrics visibly is the correct failure direction; publishing them silently
# is not.
#
# THE USER NAME IS A CROSS-FILE CONTRACT. observability/prometheus.yml cannot
# interpolate a variable - Prometheus performs no environment substitution on
# its configuration file - so it carries this user name as a literal. Change
# it in one place and you must change it in the other, or the credential stops
# matching. A user name is not a secret; the credential is.
METRICS_SCRAPE_USERNAME=carddemo-metrics-scraper
# REQUIRED for metrics to be collected, and deliberately EMPTY here. Generate a
# strong value per environment, for example with `openssl rand -base64 32`.
# docker-compose.yml materialises it into the file Prometheus reads through
# basic_auth.password_file; it is never written into any checked-in file.
METRICS_SCRAPE_PASSWORD=

# ==========================================================================
# Build / CI
# ==========================================================================
# OWASP dependency-check needs an NVD API key for a practical feed update.
# Named, never materialised: pom.xml passes only the variable NAME through
# nvdApiKeyEnvironmentVariable, and .github/workflows/build.yml supplies it
# from a repository secret. Request one at
# https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# ==========================================================================
# Parallel agents / multiple clones
# ==========================================================================
# Shifts every published port and every container name so independent stacks do
# not collide: CLONE_INDEX=1 -> PostgreSQL 5433, LocalStack 4576, Jaeger 16687,
# Prometheus 9091, Grafana 3001. Reusing one shared stack is preferred where
# tests do not mutate conflicting state. Consumed by docker-compose.yml.
CLONE_INDEX=
