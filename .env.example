# =============================================================================
# CardDemo Walking Skeleton - Root Environment Template (.env.example)
# =============================================================================
# Modernized CardDemo walking skeleton: Spring Boot 3 / Java 21 services,
# Oracle Database 23ai, Flyway migrations, and a React 19 + MUI SPA, all
# orchestrated by docker-compose. The service topology (8 Spring Boot services)
# derives from the legacy CICS registrations in app/csd/CARDDEMO.CSD.
# [SRC: CARDDEMO.CSD]
#
# USAGE
#   1. Copy this file to ".env":   cp .env.example .env
#   2. Fill in every REQUIRED secret in ".env". Secret values are intentionally
#      EMPTY in this template (see ORACLE_PASSWORD / APP_USER_PASSWORD below) so
#      a copied-but-unedited ".env" has NO usable credential and fails fast at
#      startup rather than silently running on a shipped default (CWE-798).
#   3. NEVER commit the resulting ".env" - it will hold real secrets. The root
#      ".gitignore" already ignores ".env" (and ".env.*") while keeping this
#      ".env.example" template tracked, so only the template is version-controlled.
#
# This template is consumed by /docker-compose.yml and
# /docker-compose.override.yml for ${VAR} substitution and IS committed to
# version control, so it MUST contain PLACEHOLDER VALUES ONLY - never real
# secrets. Values below are literal dotenv strings: there is NO ${...}
# interpolation inside this file (interpolation happens only in the compose
# files). Where two variables must match, the comment says so and the literal
# value is repeated.
# =============================================================================

# ---- Oracle Database 23ai (gvenzl/oracle-free) ----
# Explicit, pinned Oracle Database Free 23ai image tag. Per the run contract
# this MUST be a concrete patch tag - NEVER "latest", "23", or "23-slim"
# (those are moving major tags and are disallowed). "23.26.2-slim" is a
# currently-available slim patch tag verified present in this environment.
# (The AAP example tags "23.8-slim" / "23.26.0-slim" are not published on
# Docker Hub; use a real, concrete patch tag so the topology starts green.)
ORACLE_IMAGE_TAG=23.26.2-slim
# Admin password for SYS / SYSTEM / PDBADMIN. REQUIRED - no default is shipped.
# Leave EMPTY here and set a real value in ".env"; an empty/unset value makes the
# Oracle container fail to initialize rather than booting on a baked-in secret.
ORACLE_PASSWORD=
# Application schema user auto-created by the image inside the FREEPDB1 PDB.
# This is a (non-secret) username, so a readable default is acceptable.
APP_USER=carddemo
# Password for the application schema user. REQUIRED - no default is shipped.
# Leave EMPTY here and set a real value in ".env"; an empty/unset value makes the
# datasource connection (and thus every service and the Flyway step) fail fast.
APP_USER_PASSWORD=
# Default pluggable database (PDB) name shipped by gvenzl/oracle-free.
ORACLE_PDB=FREEPDB1
# Host port on which the Oracle listener is exposed.
ORACLE_PORT=1521

# ---- Datasource (Flyway migration step + all Spring Boot services) ----
# JDBC URL used by the Flyway migration step and every Spring Boot service.
# Host "oracle" is the docker-compose service name; it resolves via container
# DNS on the internal compose network (it is NOT a hostname on the host).
DB_URL=jdbc:oracle:thin:@oracle:1521/FREEPDB1
# The datasource username / password used by the services and by Flyway are the
# APP_USER / APP_USER_PASSWORD defined in the Oracle block above; the compose
# files reference ${APP_USER} / ${APP_USER_PASSWORD} directly (no separate
# datasource-credential variables are defined here).

# ---- Flyway migration image ----
# Pinned Flyway image for the dedicated migration step that applies
# V1__baseline.sql then V2__seed_tracer.sql before the request-serving services
# start. Pinned to an IMMUTABLE digest (tag + @sha256) so the migration step is
# byte-for-byte reproducible and cannot drift when the "11-alpine" tag is
# re-published (finding m31). Flyway Community includes Oracle support; if this
# alpine variant lacks the Oracle JDBC driver, the compose author may switch to
# the full "flyway/flyway:11" image (re-pin its digest when doing so).
FLYWAY_IMAGE_TAG=11-alpine@sha256:df06535dfd6559ae5f0628c4761013dfa4ea6a30cf6e34294931d8091f55a18f

# ---- Service host port mappings (host:container; container port is 8080) ----
# Every Spring Boot service listens on 8080 inside its container; the values
# below are the host-side ports published by docker-compose. The UI binds only
# to the BFF, but the domain-service ports are exposed for local debugging.
BFF_PORT=8080
AUTH_SVC_PORT=8081
ACCOUNT_SVC_PORT=8082
CARD_SVC_PORT=8083
TRANSACTION_SVC_PORT=8084
PAYMENT_SVC_PORT=8085
USERADMIN_SVC_PORT=8086
# NOTE: reporting-svc intentionally has NO host port - it is an async job stub
# (health-exempt), not a start-and-serve service, so it publishes no port and
# is excluded from the docker-compose "service_healthy" gating chain.

# ---- UI (React SPA served by nginx) ----
# Host port for the React 19 + MUI single-page application. The nginx container
# that serves the built static assets listens on port 80 internally.
UI_PORT=3000

# ---- Cross-cutting ----
# Correlation-ID header propagated UI -> BFF -> card-svc. This hop is real even
# though auth is a permissive stub: each Spring service places the value into
# the SLF4J MDC and the UI Axios interceptor attaches it to every request.
CORRELATION_HEADER=X-Correlation-ID
# Active Spring profile inside the containers.
SPRING_PROFILES_ACTIVE=docker
# Container timezone (UTC keeps logs and timestamps consistent across services).
TZ=UTC
