<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    CardDemo Account Service (account-svc) - Spring Boot 3.5.x / Java 21 typed-stub microservice.

    Parent is org.springframework.boot:spring-boot-starter-parent (NOT the repository-root
    /pom.xml, which is a pure reactor aggregator - a POM may have exactly one parent). The
    starter-parent supplies the Spring Boot 3.5 dependency-management BOM and plugin management.

    Central responsibilities of this build descriptor:
      1. Declare the Spring Boot 3.5.x runtime stack for the "account" bounded context.
      2. Wire the OpenAPI generator so the Java server interfaces + model DTOs are generated at
         build time from the FROZEN contract contracts/account-svc.openapi.yaml (the SSoT).
         Generated code is never hand-edited.

    Provenance: [SRC: COACTVWC/COACTUPC | ACCTDAT] - legacy Account View (CAVW -> COACTVWC) and
    Account Update (CAUP -> COACTUPC) transactions over the ACCTDAT VSAM KSDS
    (record layout app/cpy/CVACT01Y.cpy). All account operations are [DEFERRED] typed stubs.
  -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.carddemo</groupId>
  <artifactId>account-svc</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>account-svc</name>
  <description>CardDemo Account Service (Spring Boot 3 typed stub). Provenance [SRC: COACTVWC/COACTUPC | ACCTDAT]. All operations [DEFERRED].</description>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <openapi-generator.version>7.23.0</openapi-generator.version>
    <ojdbc.version>23.26.2.0.0</ojdbc.version>
    <springdoc.version>2.8.9</springdoc.version>
    <jackson-databind-nullable.version>0.2.6</jackson-databind-nullable.version>
    <!-- Overridable so the Docker build can repoint to an in-context spec copy if needed. -->
    <openapi.spec>${project.basedir}/../../contracts/account-svc.openapi.yaml</openapi.spec>
  </properties>

  <dependencies>
    <!-- Spring Boot starters (versions managed by the Boot 3.5 parent BOM - do NOT hard-code). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- Oracle 23ai JDBC driver (ojdbc11, JDK 21 compatible) - runtime only. -->
    <dependency>
      <groupId>com.oracle.database.jdbc</groupId>
      <artifactId>ojdbc11</artifactId>
      <version>${ojdbc.version}</version>
      <scope>runtime</scope>
    </dependency>

    <!--
      Flyway (versions managed by the Boot 3.5 BOM - do NOT pin). Present on the classpath for
      parity with the rest of the topology even though spring.flyway.enabled=false at runtime:
      the dedicated /db docker-compose Flyway step owns all migrations and seed data.
    -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-oracle</artifactId>
    </dependency>

    <!--
      OpenAPI generated-code support. Brings io.swagger.core.v3:swagger-annotations-jakarta so the
      generated (spring / interfaceOnly) interfaces annotated with io.swagger.v3.oas.annotations.*
      compile, provides the io.swagger.v3.oas.models.OpenAPI type used by OpenApiConfig, and exposes
      a local Swagger-UI. The frozen /contracts spec remains the single source of truth; springdoc
      here only satisfies annotation deps and serves a local API-docs UI - it does not replace it.
    -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc.version}</version>
    </dependency>
    <!-- Required by generated models when openApiNullable is on (JsonNullable wrapper type). -->
    <dependency>
      <groupId>org.openapitools</groupId>
      <artifactId>jackson-databind-nullable</artifactId>
      <version>${jackson-databind-nullable.version}</version>
    </dependency>

    <!-- Test scope: context-load / health smoke test (version managed by the Boot BOM). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        Spring Boot Maven plugin - repackages into a runnable fat JAR
        (target/account-svc-0.1.0-SNAPSHOT.jar) that the Dockerfile runtime stage executes.
        Version is managed by the starter-parent plugin management.
      -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!--
        OpenAPI Generator - emits Java server interfaces + model DTOs from the frozen contract.
          inputSpec  -> ../../contracts/account-svc.openapi.yaml (overridable via -Dopenapi.spec=...)
          spring / interfaceOnly=true  -> generate API interfaces + models only (no controllers)
          useTags=true                 -> group operations by tag: Accounts -> AccountsApi,
                                          Health -> HealthApi (HealthApi is intentionally left
                                          unimplemented; Actuator serves /actuator/health).
          apiPackage/modelPackage      -> com.carddemo.account.api / .model
        The generate goal binds to the generate-sources phase and registers
        target/generated-sources/openapi/src/main/java as a compile source root automatically.
      -->
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <version>${openapi-generator.version}</version>
        <executions>
          <execution>
            <id>generate-account-api</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${openapi.spec}</inputSpec>
              <generatorName>spring</generatorName>
              <apiPackage>com.carddemo.account.api</apiPackage>
              <modelPackage>com.carddemo.account.model</modelPackage>
              <generateApiTests>false</generateApiTests>
              <generateModelTests>false</generateModelTests>
              <generateApiDocumentation>false</generateApiDocumentation>
              <generateModelDocumentation>false</generateModelDocumentation>
              <configOptions>
                <interfaceOnly>true</interfaceOnly>
                <useSpringBoot3>true</useSpringBoot3>
                <useTags>true</useTags>
                <useJakartaEe>true</useJakartaEe>
                <openApiNullable>true</openApiNullable>
                <skipDefaultInterface>false</skipDefaultInterface>
              </configOptions>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
