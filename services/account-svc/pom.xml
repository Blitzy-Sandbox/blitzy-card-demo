<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    CardDemo Account Service (account-svc) - Spring Boot 3.5.x / Java 21 typed-stub microservice.

    Parent is org.springframework.boot:spring-boot-starter-parent (NOT the repository-root
    /pom.xml, which is a pure reactor aggregator - a POM may have exactly one parent). The
    starter-parent supplies the Spring Boot 3.5 dependency-management BOM and plugin management.

    Central responsibilities of this build descriptor:
      1. Declare the Spring Boot 3.5.x runtime stack for the "account" bounded context.
      2. Wire the OpenAPI generator so the Java server interfaces + model DTOs are generated at
         build time from the FROZEN contract contracts/account-svc.openapi.yaml (the SSoT).
         Generated code is never hand-edited.

    Provenance: [SRC: COACTVWC/COACTUPC | ACCTDAT] - legacy Account View (CAVW -> COACTVWC) and
    Account Update (CAUP -> COACTUPC) transactions over the ACCTDAT VSAM KSDS
    (record layout app/cpy/CVACT01Y.cpy). All account operations are [DEFERRED] typed stubs.
  -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.carddemo</groupId>
  <artifactId>account-svc</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>account-svc</name>
  <description>CardDemo Account Service (Spring Boot 3 typed stub). Provenance [SRC: COACTVWC/COACTUPC | ACCTDAT]. All operations [DEFERRED].</description>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <openapi-generator.version>7.23.0</openapi-generator.version>
    <!--
      Security override (finding m29): the Spring Boot 3.5.16 BOM pins
      jackson-bom 2.21.4, whose jackson-databind is affected by a known
      advisory (fixed in 2.21.5). Overriding this property re-imports the
      aligned jackson-bom 2.21.5, bumping every RUNTIME Jackson artifact in
      lock-step (annotations stay on their 2.21 metadata line).
    -->
    <jackson-bom.version>2.21.5</jackson-bom.version>
    <ojdbc.version>23.26.2.0.0</ojdbc.version>
    <!-- Overridable so the Docker build can repoint to an in-context spec copy if needed. -->
    <openapi.spec>${project.basedir}/../../contracts/account-svc.openapi.yaml</openapi.spec>
  </properties>

  <dependencies>
    <!-- Spring Boot starters (versions managed by the Boot 3.5 parent BOM - do NOT hard-code). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- Oracle 23ai JDBC driver (ojdbc11, JDK 21 compatible) - runtime only. -->
    <dependency>
      <groupId>com.oracle.database.jdbc</groupId>
      <artifactId>ojdbc11</artifactId>
      <version>${ojdbc.version}</version>
      <scope>runtime</scope>
    </dependency>

    <!--
      Flyway (versions managed by the Boot 3.5 BOM - do NOT pin). Present on the classpath for
      parity with the rest of the topology even though spring.flyway.enabled=false at runtime:
      the dedicated /db docker-compose Flyway step owns all migrations and seed data.
    -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-oracle</artifactId>
    </dependency>

    <!--
      Lean generator profile (finding M14): documentationProvider=none +
      annotationLibrary=none + openApiNullable=false mean the generated
      interfaces/models carry NO io.swagger.v3.oas.annotations.* and NO
      JsonNullable wrapper type, so neither springdoc-openapi nor
      jackson-databind-nullable is required on the runtime classpath. The frozen
      /contracts spec remains the single source of truth. Removing springdoc also
      drops the transitive commons-lang3 3.17.0 it pulled in (finding m30).
    -->

    <!-- Test scope: context-load / health smoke test (version managed by the Boot BOM). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        Spring Boot Maven plugin - repackages into a runnable fat JAR
        (target/account-svc-0.1.0-SNAPSHOT.jar) that the Dockerfile runtime stage executes.
        Version is managed by the starter-parent plugin management.
      -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!--
        OpenAPI Generator - emits Java server interfaces + model DTOs from the frozen contract.
          inputSpec  -> ../../contracts/account-svc.openapi.yaml (overridable via -Dopenapi.spec=...)
          spring / interfaceOnly=true  -> generate API interfaces + models only (no controllers)
          useTags=true                 -> group operations by tag: Accounts -> AccountsApi,
                                          Health -> HealthApi (HealthApi is intentionally left
                                          unimplemented; Actuator serves /actuator/health).
          apiPackage/modelPackage      -> com.carddemo.account.api / .model
        The generate goal binds to the generate-sources phase and registers
        target/generated-sources/openapi/src/main/java as a compile source root automatically.
      -->
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <version>${openapi-generator.version}</version>
        <executions>
          <execution>
            <id>generate-account-api</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${openapi.spec}</inputSpec>
              <generatorName>spring</generatorName>
              <apiPackage>com.carddemo.account.api</apiPackage>
              <modelPackage>com.carddemo.account.model</modelPackage>
              <generateApiTests>false</generateApiTests>
              <generateModelTests>false</generateModelTests>
              <generateApiDocumentation>false</generateApiDocumentation>
              <generateModelDocumentation>false</generateModelDocumentation>
              <configOptions>
                <!-- QA finding INFO-1: hide the @Generated(date=...) timestamp so the build-output
                     Java sources are byte-deterministic across rebuilds (no committed/gated impact). -->
                <hideGenerationTimestamp>true</hideGenerationTimestamp>
                <interfaceOnly>true</interfaceOnly>
                <useSpringBoot3>true</useSpringBoot3>
                <useTags>true</useTags>
                <useJakartaEe>true</useJakartaEe>
                <!--
                  Lean profile (finding M14): documentationProvider=none +
                  annotationLibrary=none => generated code carries zero
                  swagger/springdoc build-time dependency; openApiNullable=false
                  drops the JsonNullable wrapper. Matches the card-svc reference.
                -->
                <documentationProvider>none</documentationProvider>
                <annotationLibrary>none</annotationLibrary>
                <openApiNullable>false</openApiNullable>
                <skipDefaultInterface>false</skipDefaultInterface>
              </configOptions>
            </configuration>
          </execution>
        </executions>
        <!--
          Security override (finding M12): the openapi-generator 7.23.0 plugin
          realm otherwise resolves vulnerable build-time transitives - Jackson
          2.21.1, Handlebars 4.3.1, and Plexus-Utils 4.0.0 (incl. CVE-2025-67030
          Directory Traversal). These plugin-scoped <dependencies> pin patched,
          compatible versions on the GENERATOR classpath ONLY (runtime graph
          untouched) while retaining the pinned engine version. handlebars-jackson2
          stays at its terminal 4.3.1 (dropped in handlebars.java 4.4+); the
          `spring` generator renders via Mustache so the Handlebars helper is
          never instantiated (verified by green generate-sources).
        -->
        <dependencies>
          <!-- CVE-2025-67030 (Directory Traversal) fixed in 4.0.3. -->
          <dependency>
            <groupId>org.codehaus.plexus</groupId>
            <artifactId>plexus-utils</artifactId>
            <version>4.0.3</version>
          </dependency>
          <!-- Path-traversal + transitive commons-lang3 advisory fixed by 4.5.x. -->
          <dependency>
            <groupId>com.github.jknack</groupId>
            <artifactId>handlebars</artifactId>
            <version>4.5.2</version>
          </dependency>
          <!-- Aligned patched Jackson 2.21.5 across the generator classpath. -->
          <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.21.5</version>
          </dependency>
          <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
            <version>2.21.5</version>
          </dependency>
          <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-guava</artifactId>
            <version>2.21.5</version>
          </dependency>
          <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-joda</artifactId>
            <version>2.21.5</version>
          </dependency>
          <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <version>2.21.5</version>
          </dependency>
          <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
            <version>2.21.5</version>
          </dependency>
        </dependencies>
      </plugin>
    </plugins>
  </build>
</project>
