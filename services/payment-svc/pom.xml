<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      ==========================================================================
      payment-svc — CardDemo Bill Payment service (walking skeleton, F-SKEL)
      ==========================================================================
      Provenance: [SRC: COBIL00C | ACCTDAT] — legacy CICS Bill Payment transaction
      CB00 -> program COBIL00C (mapset COBIL00, screen app/bms/COBIL00.bms) reading
      the ACCTDAT dataset (app/csd/CARDDEMO.CSD).

      This is a BUILD-GREEN, TYPED-STUB service: it exposes the frozen OpenAPI 3.1
      contract and returns typed placeholder responses only — there is NO live
      payment/business logic. The Java API interfaces and DTO models are GENERATED at
      build time from the frozen single-source-of-truth contract
      (contracts/payment-svc.openapi.yaml) by the OpenAPI generator; those generated
      sources are never hand-edited (edit the frozen contract + regenerate instead).

      Independently buildable by design: the parent is spring-boot-starter-parent —
      NOT the repository-root aggregator pom. The empty <relativePath/> below is
      MANDATORY; without it Maven would attempt to resolve the parent from
      ../../pom.xml (the aggregator) and the build would fail.
      ==========================================================================
    -->

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.carddemo</groupId>
    <artifactId>payment-svc</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>payment-svc</name>
    <description>CardDemo Bill Payment service (typed stub, F-SKEL) [SRC: COBIL00C | ACCTDAT]</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Pinned artifact versions (validated; see AAP §0.3 dependency inventory). -->
        <ojdbc.version>23.26.2.0.0</ojdbc.version>
        <openapi-generator.version>7.23.0</openapi-generator.version>
        <!--
          Security override (finding m29): the Spring Boot 3.5.16 BOM pins
          jackson-bom 2.21.4, whose jackson-databind is affected by a known
          advisory (fixed in 2.21.5). Overriding this property re-imports the
          aligned jackson-bom 2.21.5, bumping every RUNTIME Jackson artifact in
          lock-step (annotations stay on their 2.21 metadata line).
        -->
        <jackson-bom.version>2.21.5</jackson-bom.version>
    </properties>

    <dependencies>
        <!-- REST endpoints + embedded Tomcat; also supplies the jakarta.servlet API
             used by the service's CorrelationIdFilter (OncePerRequestFilter + MDC). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- JPA + Hibernate (Oracle dialect). Required by the AAP/folder spec even
             though the stub holds no live entity; datasource autoconfiguration
             connects to Oracle FREEPDB1 at runtime. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Exposes /actuator/health for docker-compose `service_healthy` gating. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Jakarta Bean Validation for the constraints emitted on generated DTOs. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
          Lean generator profile (finding M14): documentationProvider=none +
          annotationLibrary=none + openApiNullable=false mean the generated
          interfaces/models carry NO io.swagger.v3.oas.annotations.* and NO
          JsonNullable wrapper type, so neither springdoc-openapi nor
          jackson-databind-nullable is required on the runtime classpath. The
          frozen /contracts spec remains the single source of truth. Removing
          springdoc also drops the transitive commons-lang3 3.17.0 it pulled in
          (finding m30).
        -->

        <!-- Oracle Database 23ai JDBC driver (JDK 21 compatible); runtime only. -->
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc11</artifactId>
            <version>${ojdbc.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Flyway core — version is managed by the Spring Boot 3.5 BOM (do NOT pin).
             Schema/seed are owned by /db and applied by a dedicated compose step;
             spring.flyway.enabled=false in application.yml. Present per folder spec. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <!-- Flyway Oracle dialect support — BOM-managed (no explicit version). -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-oracle</artifactId>
        </dependency>

        <!-- Context-load / health smoke test support. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Produces the bootable Spring Boot fat-jar via the repackage goal
                 (execution inherited from spring-boot-starter-parent). Layered mode is
                 enabled to support efficient layered container images. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <layers>
                        <enabled>true</enabled>
                    </layers>
                </configuration>
            </plugin>

            <!-- Contract-first code generation: emits the Spring API interfaces
                 (com.carddemo.payment.api.PaymentsApi + HealthApi) and DTO models
                 (com.carddemo.payment.model.*) from the frozen OpenAPI 3.1 contract.
                 interfaceOnly=true => controllers are hand-written and `implements`
                 the generated interfaces. The `generate` goal runs in its default
                 `generate-sources` phase, ahead of `compile`; the plugin auto-adds the
                 generated `src/main/java` root to the compile source roots. -->
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <version>${openapi-generator.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.basedir}/../../contracts/payment-svc.openapi.yaml</inputSpec>
                            <generatorName>spring</generatorName>
                            <apiPackage>com.carddemo.payment.api</apiPackage>
                            <modelPackage>com.carddemo.payment.model</modelPackage>
                            <output>${project.build.directory}/generated-sources/openapi</output>
                            <!-- Generate supporting files, but restrict to ONLY ApiUtil.java.
                                 Because skipDefaultInterface=false, the generated default interface
                                 methods call com.carddemo.payment.api.ApiUtil.setExampleResponse(...),
                                 so that helper MUST be emitted for the generated sources to compile.
                                 The filter suppresses all other supporting files (pom, README, etc.),
                                 preserving the interfaceOnly intent (no generated pom/readme/app). -->
                            <generateSupportingFiles>true</generateSupportingFiles>
                            <supportingFilesToGenerate>ApiUtil.java</supportingFilesToGenerate>
                            <configOptions>
                                <interfaceOnly>true</interfaceOnly>
                                <useSpringBoot3>true</useSpringBoot3>
                                <useTags>true</useTags>
                                <!-- Lean profile (finding M14): no springdoc/swagger annotations
                                     on generated code; matches the card-svc reference. -->
                                <documentationProvider>none</documentationProvider>
                                <annotationLibrary>none</annotationLibrary>
                                <skipDefaultInterface>false</skipDefaultInterface>
                                <openApiNullable>false</openApiNullable>
                            </configOptions>
                        </configuration>
                    </execution>
                </executions>
                <!--
                  Security override (finding M12): the openapi-generator 7.23.0 plugin
                  realm otherwise resolves vulnerable build-time transitives - Jackson
                  2.21.1, Handlebars 4.3.1, and Plexus-Utils 4.0.0 (incl. CVE-2025-67030
                  Directory Traversal). These plugin-scoped <dependencies> pin patched,
                  compatible versions on the GENERATOR classpath ONLY (runtime graph
                  untouched) while retaining the pinned engine version. handlebars-jackson2
                  stays at its terminal 4.3.1 (dropped in handlebars.java 4.4+); the
                  `spring` generator renders via Mustache so the Handlebars helper is
                  never instantiated (verified by green generate-sources).
                -->
                <dependencies>
                    <!-- CVE-2025-67030 (Directory Traversal) fixed in 4.0.3. -->
                    <dependency>
                        <groupId>org.codehaus.plexus</groupId>
                        <artifactId>plexus-utils</artifactId>
                        <version>4.0.3</version>
                    </dependency>
                    <!-- Path-traversal + transitive commons-lang3 advisory fixed by 4.5.x. -->
                    <dependency>
                        <groupId>com.github.jknack</groupId>
                        <artifactId>handlebars</artifactId>
                        <version>4.5.2</version>
                    </dependency>
                    <!-- Aligned patched Jackson 2.21.5 across the generator classpath. -->
                    <dependency>
                        <groupId>com.fasterxml.jackson.core</groupId>
                        <artifactId>jackson-databind</artifactId>
                        <version>2.21.5</version>
                    </dependency>
                    <dependency>
                        <groupId>com.fasterxml.jackson.core</groupId>
                        <artifactId>jackson-core</artifactId>
                        <version>2.21.5</version>
                    </dependency>
                    <dependency>
                        <groupId>com.fasterxml.jackson.datatype</groupId>
                        <artifactId>jackson-datatype-guava</artifactId>
                        <version>2.21.5</version>
                    </dependency>
                    <dependency>
                        <groupId>com.fasterxml.jackson.datatype</groupId>
                        <artifactId>jackson-datatype-joda</artifactId>
                        <version>2.21.5</version>
                    </dependency>
                    <dependency>
                        <groupId>com.fasterxml.jackson.datatype</groupId>
                        <artifactId>jackson-datatype-jsr310</artifactId>
                        <version>2.21.5</version>
                    </dependency>
                    <dependency>
                        <groupId>com.fasterxml.jackson.dataformat</groupId>
                        <artifactId>jackson-dataformat-yaml</artifactId>
                        <version>2.21.5</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>

</project>
