<?xml version="1.0" encoding="UTF-8"?>
<!--
  CardDemo walking skeleton — Maven build for reporting-svc.

  ASYNC JOB STUB, HEALTH-EXEMPT (differs from the other seven services):
  this module MUST build green and expose an invokable job entrypoint, but it is
  deliberately NOT held to the start-and-serve / docker-compose service_healthy
  requirement and publishes no host port. All operations are typed stubs
  [DEFERRED]; no report or statement calculation logic lives here.

  Contract-first: the frozen OpenAPI 3.1 single source of truth at
  contracts/reporting-svc.openapi.yaml drives build-time code generation of the
  Java API interfaces (com.carddemo.reporting.api) and DTO models
  (com.carddemo.reporting.model); those generated sources are never hand-edited.

  Provenance: [SRC: CORPT00C, CBSTM03A/B | TRANSACT] (app/csd/CARDDEMO.CSD:
  CR00 to CORPT00C over file TRANSACT; batch statement generators CBSTM03A/B).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Parent is the Spring Boot starter parent used directly. The empty
    <relativePath/> forces resolution from the repository (Maven Central / local
    cache) rather than the root aggregator: the root /pom.xml is a pure reactor
    aggregator and MUST NOT be this module's parent.
  -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.carddemo</groupId>
  <artifactId>reporting-svc</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>reporting-svc</name>
  <description>CardDemo Reporting/Statement service — async job stub, health-exempt. [SRC: CORPT00C, CBSTM03A/B | TRANSACT]. Typed stubs [DEFERRED]; no report/statement calculation.</description>

  <properties>
    <!-- Compile to Java 21 (LTS); the Spring Boot parent honors java.version. -->
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- OpenAPI Generator with OpenAPI 3.1 support (AAP 0.2.2). -->
    <openapi-generator.version>7.23.0</openapi-generator.version>
    <!-- Oracle 23ai ojdbc11 driver, JDK 21 compatible (AAP 0.3). -->
    <ojdbc.version>23.26.2.0.0</ojdbc.version>
    <!-- Swagger annotations required so the generated spring/useSpringBoot3 code
         (io.swagger.v3.oas.annotations.*) compiles. -->
    <swagger-annotations.version>2.2.25</swagger-annotations.version>
  </properties>

  <dependencies>
    <!-- Web: the generated `spring` interfaces (interfaceOnly=true) reference
         Spring MVC types (ResponseEntity, @RequestMapping, ...) and the shared
         CorrelationIdFilter extends OncePerRequestFilter (spring-web/webmvc). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- Data JPA + Hibernate for an optional Oracle job context. reporting-svc
         has NO JPA entities of its own (all stubs); present for stack
         consistency and future job context. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>

    <!-- Bean Validation: generated models may carry jakarta.validation
         constraints (e.g. @Size from maxLength) that require this on the
         classpath. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- Oracle 23ai JDBC driver (runtime only). -->
    <dependency>
      <groupId>com.oracle.database.jdbc</groupId>
      <artifactId>ojdbc11</artifactId>
      <version>${ojdbc.version}</version>
      <scope>runtime</scope>
    </dependency>

    <!-- Flyway core (BOM-managed). Present per folder requirement even though
         in-service Flyway is DISABLED; schema is owned by /db. -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>

    <!-- Flyway Oracle dialect support (BOM-managed). -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-oracle</artifactId>
    </dependency>

    <!-- Swagger annotations: required for the generated code annotations to
         compile (see property note above). -->
    <dependency>
      <groupId>io.swagger.core.v3</groupId>
      <artifactId>swagger-annotations</artifactId>
      <version>${swagger-annotations.version}</version>
    </dependency>

    <!-- Test: context-load smoke test only. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        OpenAPI Generator (THE critical plugin): generates the Java server
        interfaces + models from the frozen contract at build time. With
        useTags=true it emits ReportsApi (submitReport, getJobStatus) and
        StatementsApi (submitStatement) plus models ReportRequest,
        StatementRequest, JobAcknowledgement, JobStatus and Error.

        interfaceOnly=true  -> only interfaces + models (no controllers); the
                               downstream job-stub handlers consume the model types.
        openApiNullable=false -> OpenAPI 3.1 nullable fields become plain nullable
                               Java types, so jackson-databind-nullable is NOT needed.
        useSpringBoot3 + useJakartaEe -> generated code uses jakarta.* imports.

        The plugin auto-registers target/generated-sources/openapi/src/main/java
        as a compile source root (no build-helper plugin needed).
      -->
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <version>${openapi-generator.version}</version>
        <executions>
          <execution>
            <id>generate-reporting-api</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${project.basedir}/../../contracts/reporting-svc.openapi.yaml</inputSpec>
              <generatorName>spring</generatorName>
              <apiPackage>com.carddemo.reporting.api</apiPackage>
              <modelPackage>com.carddemo.reporting.model</modelPackage>
              <generateApiTests>false</generateApiTests>
              <generateApiDocumentation>false</generateApiDocumentation>
              <generateModelTests>false</generateModelTests>
              <generateModelDocumentation>false</generateModelDocumentation>
              <configOptions>
                <interfaceOnly>true</interfaceOnly>
                <useSpringBoot3>true</useSpringBoot3>
                <useTags>true</useTags>
                <openApiNullable>false</openApiNullable>
                <skipDefaultInterface>false</skipDefaultInterface>
                <useJakartaEe>true</useJakartaEe>
              </configOptions>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        Spring Boot Maven plugin (version managed by the parent). The parent's
        pluginManagement contributes the default `repackage` execution bound to
        the package phase, so `mvn package` produces the executable fat JAR that
        the Dockerfile runtime stage runs with `java -jar`. Main class
        com.carddemo.reporting.ReportingApplication is auto-detected.
      -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

</project>
