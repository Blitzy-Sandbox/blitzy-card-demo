# =============================================================================
# CardDemo Java (Maven / Spring Boot) — VCS ignore rules
# Purpose: keep build output, IDE metadata, and local-only artifacts out of git.
# Setup/configuration file added by the environment-setup step (no source impact).
# =============================================================================

# --- Maven build output ---
target/

# --- Maven wrapper downloaded binary (fetched on-demand by ./mvnw from
#     wrapperUrl in .mvn/wrapper/maven-wrapper.properties; not version-controlled) ---
.mvn/wrapper/maven-wrapper.jar

# --- Spring Boot / runtime local artifacts ---
*.log
logs/

# --- IDE / editor metadata ---
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.project
.classpath
.factorypath

# --- Local environment secrets (CWE-798: never commit a real .env; the
#     committed template is .env.example, which carries only NON-SECRET
#     placeholders and is explicitly re-included below) ---
.env
.env.local
!.env.example

# --- OS cruft ---
.DS_Store
Thumbs.db
