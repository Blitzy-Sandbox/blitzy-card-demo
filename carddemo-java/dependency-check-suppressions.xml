    <packageUrl regex="true">^pkg:maven/org\.hibernate\.validator/hibernate-validator@.*$</packageUrl>
    <cve>CVE-2025-15104</cve>
  </suppress>

  <!-- ============================================================================
       kotlin-stdlib 1.9.25  (CVSS 5.3 — below gate, suppressed for clean report)
       FALSE POSITIVE: CVE-2020-29582 affects JetBrains Kotlin BEFORE 1.4.21 (insecure temp
       file/dir permissions). This classpath has 1.9.25, far past the fix; the NVD version
       range is over-broad. Not vulnerable.
       ============================================================================ -->
  <suppress>
    <notes><![CDATA[FALSE POSITIVE: CVE-2020-29582 affects Kotlin before 1.4.21 (insecure temp file permissions); this classpath uses kotlin-stdlib (and its kotlin-stdlib-jdk7/jdk8/common companions) at 1.9.25, well past the fix. NVD range is over-broad. Regex covers every kotlin-stdlib* variant.]]></notes>
    <packageUrl regex="true">^pkg:maven/org\.jetbrains\.kotlin/kotlin-stdlib.*$</packageUrl>
    <cve>CVE-2020-29582</cve>
  </suppress>

</suppressions>
