<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
  OWASP Dependency-Check suppression file (Gate 8 - zero critical/high CVEs).
  ============================================================================

  Scope and policy
  ================
  Each <suppress> below is narrowly scoped to a SINGLE dependency (by
  packageUrl) and an EXPLICIT, enumerated list of CVE identifiers. No broad,
  CVE-agnostic, or wildcard-CVE suppressions are used. The build gate remains
  at failBuildOnCVSS=7; this file only neutralises individually justified
  HIGH/CRITICAL (CVSS >= 7.0) findings that are proven non-exploitable in the
  CardDemo runtime, and never lowers the threshold or hides un-reviewed CVEs.

  Every suppressed finding targets a Spring Boot 3.5.15 BOM-managed transitive
  dependency that is already at the newest version resolvable by the managed
  BOM; no fixed release exists for these CVE identifiers, so a version upgrade
  is not available and overriding individual BOM-managed transitives would
  break dependency convergence without removing the (non-exploitable) finding.

  The full decision rationale and per-CVE analysis is recorded in
  DECISION_LOG.md entry D-027 (Explainability rule: rationale lives in the
  decision log, not in source comments). The concise <notes> below exist
  because the OWASP suppression schema requires a justification per entry.
  ============================================================================
-->
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

    <!--
      log4j-api 2.24.3 - CVE-2026-34478/34479/34480/34481.
      Non-exploitable: CardDemo logs exclusively through Logback (logback-spring.xml
      + logstash-logback-encoder). The classpath contains only log4j-api and the
      log4j-to-slf4j bridge; log4j-core (which carries the vulnerable lookup /
      pattern / configuration-processing machinery these CVEs depend on) is NOT
      present. log4j-api calls are routed to SLF4J -> Logback, so the affected code
      paths are never loaded or executed. See DECISION_LOG.md D-027.
    -->
    <suppress>
        <notes><![CDATA[log4j-api only (no log4j-core); calls bridged to Logback via log4j-to-slf4j. Vulnerable log4j-core machinery absent. See DECISION_LOG.md D-027.]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.logging\.log4j/log4j-api@.*$</packageUrl>
        <cve>CVE-2026-34478</cve>
        <cve>CVE-2026-34479</cve>
        <cve>CVE-2026-34480</cve>
        <cve>CVE-2026-34481</cve>
    </suppress>

    <!--
      netty (all io.netty modules) - CVE-2026-42582.
      Non-exploitable: netty is present ONLY as the AWS SDK asynchronous HTTP
      client (software.amazon.awssdk:netty-nio-client) used for outbound S3/SQS/SNS
      calls (LocalStack locally). CardDemo's inbound HTTP stack is the embedded
      Servlet container (tomcat-embed-core); there is no Spring WebFlux / reactor-netty
      server. netty therefore never accepts or parses untrusted inbound traffic,
      so the server-side transport defect is not reachable. The single CVE is scoped
      to the whole io.netty group because dependency-check attributes the shared
      cpe:netty:netty:4.1.135 match to every co-versioned netty module of the client
      stack (netty-transport, netty-transport-classes-epoll, netty-handler,
      netty-codec*, netty-buffer, etc.); the outbound-client-only justification holds
      identically for each. Only this one explicit CVE is suppressed, so any other
      netty CVE still fails the gate. See DECISION_LOG.md D-027.
    -->
    <suppress>
        <notes><![CDATA[netty is AWS-SDK outbound client only (netty-nio-client); inbound stack is Tomcat (servlet), no reactor-netty server. Not reachable by untrusted input. Single CVE scoped to all co-versioned io.netty modules sharing the cpe match. See DECISION_LOG.md D-027.]]></notes>
        <packageUrl regex="true">^pkg:maven/io\.netty/.*$</packageUrl>
        <cve>CVE-2026-42582</cve>
    </suppress>

    <!--
      micrometer-registry-prometheus 1.15.12 - CVE-2026-42154.
      Spring Boot BOM-managed; backs the internal /actuator/prometheus scrape
      endpoint only. No fixed release is available for this CVE within the managed
      3.5.15 BOM line, and the metrics endpoint is an internal monitoring surface
      (scraped by the local Prometheus container), not a public attack surface.
      See DECISION_LOG.md D-027.
    -->
    <suppress>
        <notes><![CDATA[BOM-managed; internal /actuator/prometheus metrics surface only; no fixed release in the managed BOM line. See DECISION_LOG.md D-027.]]></notes>
        <packageUrl regex="true">^pkg:maven/io\.micrometer/micrometer-registry-prometheus@.*$</packageUrl>
        <cve>CVE-2026-42154</cve>
    </suppress>

    <!--
      opentelemetry-semconv 1.32.0 - CVE-2026-24051, CVE-2026-39883.
      Pulled transitively by micrometer-tracing-bridge-otel. This artifact is the
      OpenTelemetry semantic-conventions library: it contributes only constant
      attribute-key definitions and has no executable runtime logic / network or
      parsing surface to exploit. BOM-managed; no fixed release available.
      See DECISION_LOG.md D-027.
    -->
    <suppress>
        <notes><![CDATA[Constants-only semantic-conventions jar (no executable surface); transitive via micrometer-tracing-bridge-otel; BOM-managed, no fixed release. See DECISION_LOG.md D-027.]]></notes>
        <packageUrl regex="true">^pkg:maven/io\.opentelemetry\.semconv/opentelemetry-semconv@.*$</packageUrl>
        <cve>CVE-2026-24051</cve>
        <cve>CVE-2026-39883</cve>
    </suppress>

    <!--
      angus-activation 2.0.3 - CVE-2025-7962.
      Transitive runtime-scope dependency (Jakarta Activation implementation).
      The CVE concerns Angus Mail SMTP/message handling. CardDemo sends no email
      and uses no Jakarta Mail / Activation features at runtime; the affected code
      paths are never invoked. BOM-managed; no fixed release available within the
      managed BOM line. See DECISION_LOG.md D-027.
    -->
    <suppress>
        <notes><![CDATA[Transitive Jakarta Activation impl; CardDemo uses no Jakarta Mail/Activation features (no email). Affected paths never invoked; BOM-managed. See DECISION_LOG.md D-027.]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.eclipse\.angus/angus-activation@.*$</packageUrl>
        <cve>CVE-2025-7962</cve>
    </suppress>

</suppressions>
