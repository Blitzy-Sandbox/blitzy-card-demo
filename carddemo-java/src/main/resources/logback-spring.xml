<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
  CardDemo - Structured Logging Configuration (logback-spring.xml)
  ============================================================================
  The application emits structured JSON logs to STDOUT carrying distributed-
  tracing identifiers and a per-request correlation identifier so that
  container/aggregator tooling (Docker, Kubernetes, Promtail/Loki) and the
  Jaeger/Prometheus/Grafana observability stack can correlate events.

  MDC field provenance (this file only RENDERS these keys; it never sets them):
    - correlationId : set per request (and propagated through service/batch
                      layers) by com.carddemo.observability.CorrelationIdFilter,
                      which places it in the SLF4J MDC.
    - traceId, spanId : supplied by Micrometer Tracing + the OpenTelemetry
                        bridge when tracing is active; Spring Boot 3.x exposes
                        them through the MDC.

  Structured JSON is emitted for EVERY profile (local, test, default, prod-like).
  The Observability rule (AAP 0.7.1) requires structured JSON logging in the
  locally verifiable runtime (the 'local'/compose profile is what operators and
  the QA harness actually observe), so a single JSON appender is used uniformly
  rather than a human-readable console for 'local'. The "-spring" suffix still
  lets Spring Boot evaluate the <springProperty> element below for the embedded
  application name.

  Design rationale is recorded in DECISION_LOG.md (Explainability rule); the
  comments here are intentionally functional only.

  NOTE: 'scan' is intentionally NOT enabled. Logback's reconfigure-on-change
  task re-parses the file with a plain JoranConfigurator that does not
  understand the Spring <springProfile>/<springProperty> extensions, which
  would break hot reloads of a logback-spring.xml.

  NOTE: Never place credentials, tokens, or other sensitive values in the MDC;
  only the allow-listed observability keys below are rendered into the logs.
  ============================================================================
-->
<configuration>

    <!--
      Spring Boot logging defaults: conversion rules (clr, wEx, correlationId,
      applicationName, ...) and noise-reducing third-party logger levels. We
      deliberately do NOT include console-appender.xml/file-appender.xml so that
      the explicit, profile-specific appenders defined below are the only sinks.
    -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!--
      Application name resolved from Spring configuration. Embedded as the static
      JSON field "application" (see the JSON appender below) and usable in
      patterns. Context scope keeps it resolvable during appender construction.
    -->
    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="carddemo"/>

    <!--
      Application logger level. Appenders are inherited from the profile-specific
      <root> via additivity, so no appender-ref is needed here. Runtime overrides
      remain possible through the logging.level.* keys in application*.yml.
    -->
    <logger name="com.carddemo" level="INFO"/>

    <!--
      ======================================================================
      Single structured-JSON appender for ALL profiles (local, test, default,
      prod-like). Structured JSON to STDOUT via logstash-logback-encoder 8.0;
      writing to stdout is the container best practice and the platform collects
      the stream. The correlationId / traceId / spanId MDC keys are rendered so a
      single request or batch chunk can be followed end-to-end. JSON is emitted
      uniformly (including 'local') because the Observability rule (AAP 0.7.1)
      requires structured JSON in the locally verifiable runtime; the former
      'local' human-readable console has been removed so operators and the QA
      harness observe the same JSON format the non-local profiles already used.
      ======================================================================
    -->
    <appender name="STDOUT_JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
                <providers>
                    <!-- ISO-8601 timestamp in UTC -->
                    <timestamp>
                        <fieldName>timestamp</fieldName>
                        <timeZone>UTC</timeZone>
                        <pattern>yyyy-MM-dd'T'HH:mm:ss.SSSXXX</pattern>
                    </timestamp>
                    <!-- severity, e.g. INFO / WARN / ERROR -->
                    <logLevel>
                        <fieldName>level</fieldName>
                    </logLevel>
                    <!-- originating logger name -->
                    <loggerName>
                        <fieldName>logger</fieldName>
                        <shortenedLoggerNameLength>40</shortenedLoggerNameLength>
                    </loggerName>
                    <!-- executing thread -->
                    <threadName>
                        <fieldName>thread</fieldName>
                    </threadName>
                    <!-- formatted log message -->
                    <message>
                        <fieldName>message</fieldName>
                    </message>
                    <!--
                      MDC: emit ONLY the allow-listed observability keys.
                      Restricting the set both guarantees the required keys
                      appear in output AND prevents accidental leakage of
                      sensitive data placed in the MDC. Add further NON-sensitive
                      keys here if a use case requires them.
                    -->
                    <mdc>
                        <includeMdcKeyName>traceId</includeMdcKeyName>
                        <includeMdcKeyName>spanId</includeMdcKeyName>
                        <includeMdcKeyName>correlationId</includeMdcKeyName>
                    </mdc>
                    <!-- exception stack traces: shortened and root-cause-first -->
                    <stackTrace>
                        <fieldName>stackTrace</fieldName>
                        <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                            <maxDepthPerThrowable>30</maxDepthPerThrowable>
                            <maxLength>4096</maxLength>
                            <shortenedClassNameLength>40</shortenedClassNameLength>
                            <rootCauseFirst>true</rootCauseFirst>
                        </throwableConverter>
                    </stackTrace>
                    <!--
                      Static field identifying the emitting application. Rendered
                      via a JSON pattern so the value is resolved from ${appName}
                      at configuration time without third-party bean introspection
                      (which keeps the configuration free of Logback warnings).
                    -->
                    <pattern>
                        <pattern>{"application":"${appName}"}</pattern>
                    </pattern>
                </providers>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="STDOUT_JSON"/>
        </root>

</configuration>
