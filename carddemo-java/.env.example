# =============================================================================
# CardDemo (Java 25 LTS + Spring Boot 3.5.15) — ENVIRONMENT TEMPLATE
# =============================================================================
# Purpose:
#   Template for the local `.env` file consumed by `docker compose up` (and a
#   handy reference for a bare `mvn spring-boot:run -Plocal`). Copy this file to
#   `.env` and fill in real values:
#
#       cp .env.example .env
#
#   `.env` is git-ignored (see .gitignore); THIS template carries only NON-SECRET
#   placeholders and IS committed.
#
# CWE-798 / AAP §0.7.2 — NO HARDCODED CREDENTIALS:
#   The base application.yml and docker-compose.yml intentionally provide NO
#   runnable default for the auth token signing key or the production datasource
#   credentials. They are supplied EXCLUSIVELY through the environment variables
#   below. `docker compose up` FAILS FAST with a clear message if
#   CARDDEMO_SECURITY_TOKEN_SECRET is unset. The `local` Spring profile
#   (application-local.yml) and the `test` profile (application-test.yml) carry
#   their own clearly-labelled NON-SECRET defaults so local dev and the test suite
#   boot out-of-the-box; production/base runs require the variables here.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — Auth token signing secret (HMAC-SHA256; >= 256 bits / 32 bytes)
# -----------------------------------------------------------------------------
# Consumed by com.cardemo.security.TokenService. There is NO default anywhere in
# base config or compose — you MUST set a real, random secret. Generate one with:
#     openssl rand -base64 48
# The value below is an OBVIOUS PLACEHOLDER, not a usable secret — replace it.
CARDDEMO_SECURITY_TOKEN_SECRET=REPLACE_ME_WITH_A_RANDOM_BASE64_SECRET_AT_LEAST_32_BYTES_LONG
# Optional: token lifetime in seconds (default 3600 = one hour).
CARDDEMO_SECURITY_TOKEN_TTL_SECONDS=3600

# -----------------------------------------------------------------------------
# Datasource (PostgreSQL 16)
# -----------------------------------------------------------------------------
# In docker-compose the `postgres` service is created with POSTGRES_USER /
# POSTGRES_PASSWORD / POSTGRES_DB, and the `app` service binds the SAME values to
# SPRING_DATASOURCE_USERNAME / SPRING_DATASOURCE_PASSWORD. For a bare host run on
# the base profile, set SPRING_DATASOURCE_* directly (the base application.yml has
# NO credential default; the `local` profile defaults them to carddemo/carddemo).
POSTGRES_USER=carddemo
POSTGRES_PASSWORD=carddemo
POSTGRES_DB=carddemo
# Bare host run on the base profile (compose sets these automatically from the above):
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/carddemo
# SPRING_DATASOURCE_USERNAME=carddemo
# SPRING_DATASOURCE_PASSWORD=carddemo

# -----------------------------------------------------------------------------
# AWS → LocalStack (ZERO live AWS; AAP §0.7.7)
# -----------------------------------------------------------------------------
# NON-SECRET throwaway placeholders. Every AWS client is pinned to the LocalStack
# edge endpoint, and LocalStack ignores credential values, so "test"/"test" can
# never authenticate against — or reach — a live AWS account. Leave them as-is for
# local/compose runs.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
# Endpoint: compose overrides this to the in-network emulator (http://localstack:4566).
# For a bare host run against a local LocalStack, use http://localhost:4566.
# AWS_ENDPOINT_URL=http://localhost:4566

# -----------------------------------------------------------------------------
# LocalStack runtime (only relevant to docker-compose's localstack service)
# -----------------------------------------------------------------------------
# LocalStack image. DEFAULT is the license-free COMMUNITY edition, which fully
# supports the s3/sqs/sns subset this migration uses, so `docker compose up -d`
# works from a clean environment with NO auth token (AAP §0.7.7: zero live AWS
# dependencies). To use Pro, set this to a Pro image AND supply LOCALSTACK_AUTH_TOKEN:
#   LOCALSTACK_IMAGE=localstack/localstack-pro:2026.5.3
LOCALSTACK_IMAGE=localstack/localstack:3
# Required ONLY when LOCALSTACK_IMAGE is a localstack-pro image; leave blank for community.
LOCALSTACK_AUTH_TOKEN=
# Verbose LocalStack logging (0 = off, 1 = on).
LOCALSTACK_DEBUG=0

# -----------------------------------------------------------------------------
# Optional — AWS resource names (defaults match localstack-init/init-aws.sh)
# -----------------------------------------------------------------------------
# CARDDEMO_S3_BATCH_INPUT_BUCKET=carddemo-batch-input
# CARDDEMO_S3_BATCH_OUTPUT_BUCKET=carddemo-batch-output
# CARDDEMO_S3_STATEMENTS_BUCKET=carddemo-statements
# CARDDEMO_SQS_REPORT_JOBS_QUEUE=carddemo-report-jobs.fifo
# CARDDEMO_SNS_NOTIFICATIONS_TOPIC=carddemo-notifications

# -----------------------------------------------------------------------------
# Optional — Observability (tracing export target)
# -----------------------------------------------------------------------------
# Compose overrides this to the in-network Jaeger collector (http://jaeger:4318/v1/traces).
# MANAGEMENT_OTLP_TRACING_ENDPOINT=http://localhost:4318/v1/traces
