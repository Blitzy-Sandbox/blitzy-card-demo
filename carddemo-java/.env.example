# =============================================================================
# CardDemo (Java) — environment template
# =============================================================================
# Copy this file to `.env` (which is git-ignored) and override values as needed:
#
#     cp .env.example .env
#
# Docker Compose automatically loads `.env` from this directory. Every variable
# below has a SAFE LOCAL-DEVELOPMENT DEFAULT baked into docker-compose.yml and
# the Spring `local`/`test` profiles, so a clean checkout runs out of the box
# WITHOUT creating a `.env` at all. Override here only when you need to.
#
# SECURITY (AAP 0.8.1 — no hardcoded real credentials):
#   * The values shipped as defaults are OBVIOUSLY-FAKE, LOCAL-ONLY placeholders
#     (e.g. POSTGRES_PASSWORD=carddemo, AWS test/test, a throwaway JWT secret).
#     They exist purely so local LocalStack/PostgreSQL development is friction-free.
#   * They MUST NOT be reused for any shared, staging, or production deployment.
#   * For any non-local environment, supply REAL secrets exclusively through your
#     platform's secret manager / vault (e.g. AWS Secrets Manager, Kubernetes
#     Secrets, CI masked variables) — never by committing a populated `.env`.
# =============================================================================

# --- PostgreSQL (replaces the VSAM KSDS stores) -----------------------------
# POSTGRES_DB is a fixed, non-secret database name. POSTGRES_USER / POSTGRES_PASSWORD
# drive both the postgres container and the application's datasource credentials.
POSTGRES_DB=carddemo
POSTGRES_USER=carddemo
# LOCAL-ONLY default password — override with a real secret outside local dev.
POSTGRES_PASSWORD=carddemo
# Optional: override ONLY the application's datasource password independently of
# the postgres container password (defaults to POSTGRES_PASSWORD when unset).
# SPRING_DATASOURCE_PASSWORD=

# --- AWS / LocalStack (S3 + SQS + SNS; zero live-AWS dependency) -------------
AWS_REGION=us-east-1
# Non-secret LocalStack dummy credentials; any value works against LocalStack.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# LocalStack image. The default is the Community image, which fully covers
# S3/SQS/SNS and needs NO auth token. To use the PRO image, set BOTH this and
# LOCALSTACK_AUTH_TOKEN to a valid token.
LOCALSTACK_IMAGE=localstack/localstack:3.8
# Required only by the PRO image; ignored by the Community image. Leave blank
# for local Community use. NEVER commit a real token.
LOCALSTACK_AUTH_TOKEN=
# LocalStack verbosity (0/1) and persistence (0/1) — optional tuning knobs.
LOCALSTACK_DEBUG=0
LOCALSTACK_PERSISTENCE=0

# --- JWT (stateless authentication) -----------------------------------------
# HMAC (HS256) signing secret. There is intentionally NO default in the app
# (application.yml: ${JWT_SECRET:}); SecurityConfig fails fast below the 32-byte
# HS256 minimum. The compose stack supplies an OBVIOUSLY-FAKE >=32-byte local
# default only — ALWAYS override with a real, randomly-generated secret outside
# local development.
JWT_SECRET=local-dev-only-change-me-jwt-hs256-signing-secret-0123456789
# Access-token lifetime in seconds (backs carddemo.security.jwt.expiration-seconds).
JWT_EXPIRATION=3600

# --- Observability ----------------------------------------------------------
# OTLP gRPC endpoint for distributed tracing (Jaeger in the local compose stack).
OTLP_ENDPOINT=http://jaeger:4317
