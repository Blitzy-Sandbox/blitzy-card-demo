          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(rate(http_server_requests_seconds_count{job=~\"$job\"}[5m]))",
          "legendFormat": "total req/s",
          "range": true,
          "instant": false,
          "refId": "A"
