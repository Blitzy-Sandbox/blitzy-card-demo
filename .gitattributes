# ---- New Java build tree: normalise to LF in the index and the worktree ----
*.java      text eol=lf diff=java
*.xml       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.sql       text eol=lf
*.properties text eol=lf
*.sh        text eol=lf
*.md        text eol=lf
*.html      text eol=lf
Dockerfile  text eol=lf
.gitignore  text eol=lf
.gitattributes text eol=lf
.editorconfig  text eol=lf
.dockerignore  text eol=lf

# ---- Maven wrapper: the POSIX script must stay LF, the batch script CRLF ----
mvnw        text eol=lf
mvnw.cmd    text eol=crlf

# ---- Binary artefacts ----
*.jar       binary
*.zip       binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.pdf       binary
*.PS        binary

# ---- FROZEN LEGACY CORPUS: no conversion, no normalisation, ever ----
# These rules are last so they win over every pattern above.
app/**      -text
samples/**  -text
diagrams/** -text
