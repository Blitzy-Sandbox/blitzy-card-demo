ometry y="250" width="370" height="20" as="geometry"/></mxCell><mxCell id="ent_dailytran_r12" value="dly_tran_proc_ts : TIMESTAMP &#160;&#8592; DALYTRAN-PROC-TS PIC X(26)" style="text;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;spacingLeft=8;fontSize=10;html=1;" vertex="1" parent="ent_dailytran"><mxGeometry y="270" width="370" height="20" as="geometry"/></mxCell><mxCell id="ent_dailytran_r13" value="IDX&#160; idx_dailytran_card (dly_tran_card_num)" style="text;align=left;verticalAlign=middle;strokeColor=none;fillColor=#d5e8d4;spacingLeft=8;fontSize=10;html=1;fontStyle=2;" vertex="1" parent="ent_dailytran"><mxGeometry y="290" width="370" height="20" as="geometry"/></mxCell><mxCell id="ent_dailytran_r14" value="&#160;&#160;&#160;&#160;&#8594; Nightly batch staging (AAP &#167;0.4.1)" style="text;align=left;verticalAlign=middle;strokeColor=none;fillColor=#f5f5f5;spacingLeft=8;fontSize=9;html=1;fontStyle=2;" vertex="1" parent="ent_dailytran"><mxGeometry y="310" width="370" height="20" as="geometry"/></mxCell><mxCell id="edge_card_account" value="card_acct_id" style="endArrow=classic;html=1;rounded=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#0066CC;strokeWidth=1.5;endFill=1;" edge="1" parent="1" source="ent_card" target="ent_account"><mxGeometry relative="1" as="geometry"><Array as="points"/></mxGeometry></mxCell><mxCell id="edge_xref_card" value="xref_card_num" style="endArrow=classic;html=1;rounded=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#0066CC;strokeWidth=1.5;endFill=1;" edge="1" parent="1" source="ent_cardxref" target="ent_card"><mxGeometry relative="1" as="geometry"><Array as="points"/></mxGeometry></mxCell><mxCell id="edge_xref_account" value="xref_acct_id" style="endArrow=classic;html=1;rounded=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#0066CC;strokeWidth=1.5;endFill=1;" edge="1" parent="1" source="ent_cardxref" target="ent_account"><mxGeometry relative="1" as="geometry"><Array as="points"/></mxGeometry></mxCell><mxCell id="edge_xref_customer" value="xref_cust_id" style="endArrow=classic;html=1;rounded=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#0066CC;strokeWidth=1.5;endFill=1;" edge="1" parent="1" source="ent_cardxref" target="ent_customer"><mxGeometry relative="1" as="geometry"><Array as="points"/></mxGeometry></mxCell><mxCell id="edge_transaction_card" value="tran_card_num" style="endArrow=classic;html=1;rounded=0;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeColor=#0066CC;strokeWidth=1.5;endFill=1;" edge="1" parent="1" source="ent_transaction" target="ent_card"><mxGeometry relative="1" as="geometry"><Array as="points"/></mxGeometry></mxCell><mxCell id="edge_transaction_trantype" value="tran_type_cd" style="endArrow=classic;html=1;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#0066CC;strokeWidth=1.5;endFill=1;" edge="1" parent="1" source="ent_transaction" target="ent_trantype"><mxGeometry relative="1" as="geometry"><Array as="points"/></mxGeometry></mxCell><mxCell id="edge_transaction_trancat" value="(tran_type_cd, tran_cat_cd)" style="endArrow=classic;html=1;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#0066CC;strokeWidth=1.5;endFill=1;" edge="1" parent="1" source="ent_transaction" target="ent_trancat"><mxGeometry relative="1" as="geometry"><Array as="points"/></mxGeometry></mxCell><mxCell id="edge_tcb_account" value="tcatbal_acct_id" style="endArrow=classic;html=1;rounded=0;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeColor=#0066CC;strokeWidth=1.5;endFill=1;" edge="1" parent="1" source="ent_tcatbal" target="ent_account"><mxGeometry relative="1" as="geometry"><Array as="points"/></mxGeometry></mxCell><mxCell id="edge_tcb_trantype" value="tcatbal_tran_type_cd" style="endArrow=classic;html=1;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#0066CC;strokeWidth=1.5;endFill=1;" edge="1" parent="1" source="ent_tcatbal" target="ent_trantype"><mxGeometry relative="1" as="geometry"><Array as="points"/></mxGeometry></mxCell><mxCell id="edge_tcb_trancat" value="(type_cd, cat_cd)" style="endArrow=classic;html=1;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#0066CC;strokeWidth=1.5;endFill=1;" edge="1" parent="1" source="ent_tcatbal" target="ent_trancat"><mxGeometry relative="1" as="geometry"><Array as="points"/></mxGeometry></mxCell><mxCell id="edge_trancat_trantype" value="tran_type_cd" style="endArrow=classic;html=1;rounded=0;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeColor=#0066CC;strokeWidth=1.5;endFill=1;" edge="1" parent="1" source="ent_trancat" target="ent_trantype"><mxGeometry relative="1" as="geometry"><Array as="points"/></mxGeometry></mxCell><mxCell id="cal1_title" value="Replaces VSAM KSDS Clusters" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="1290" width="380" height="30" as="geometry"/></mxCell><mxCell id="cal1_body" value="Source inventory: app/catlg/LISTCAT.txt&#10;&#10;ACCTDATA.VSAM.KSDS &#8594; Account&#10;CARDDATA.VSAM.KSDS &#8594; Card&#10;CUSTDATA.VSAM.KSDS &#8594; Customer&#10;CARDXREF.VSAM.KSDS + CARDXREF.VSAM.AIX &#8594; CardCrossReference + idx_cardxref_acct_id&#10;TRANSACT.VSAM.KSDS + TRANSACT.VSAM.AIX &#8594; Transaction + idx_transact_card_proc&#10;TCATBALF.VSAM.KSDS &#8594; TransactionCategoryBalance&#10;DISCGRP.VSAM.KSDS &#8594; DisclosureGroup&#10;TRANCATG.VSAM.KSDS &#8594; TransactionCategory&#10;TRANTYPE.VSAM.KSDS &#8594; TransactionType&#10;USRSEC.VSAM.KSDS &#8594; UserSecurity" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;fillColor=#ffffff;strokeColor=#d6b656;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="1320" width="380" height="200" as="geometry"/></mxCell><mxCell id="cal2_title" value="AWS-native RDS Posture" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="440" y="1290" width="380" height="30" as="geometry"/></mxCell><mxCell id="cal2_body" value="RDS PostgreSQL 16.4 Multi-AZ&#10;Encryption at rest via AWS KMS CMK&#10;Multi-AZ standby for HA&#10;backup_retention_period=35 days (AAP &#167;0.7.2)&#10;Point-in-time recovery enabled&#10;rds.force_ssl=1 (TLS 1.2+)&#10;Performance Insights enabled&#10;Parameter group tuned for NUMERIC precision&#10;Default isolation: READ_COMMITTED" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;fillColor=#ffffff;strokeColor=#d6b656;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="440" y="1320" width="380" height="200" as="geometry"/></mxCell><mxCell id="cal3_title" value="BigDecimal Precision (AAP &#167;0.6.1)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="840" y="1290" width="380" height="30" as="geometry"/></mxCell><mxCell id="cal3_body" value="All monetary columns use NUMERIC(precision, scale).&#10;NEVER DOUBLE PRECISION or REAL.&#10;&#10;PostgreSQL NUMERIC is arbitrary-precision and matches COBOL PIC 9 decimal arithmetic exactly.&#10;&#10;Java uses java.math.BigDecimal with RoundingMode.HALF_EVEN (banker&apos;s rounding).&#10;&#10;Precision rule: digits_total + 1 (sign), scale = V99 (=2) or V9999 (=4)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;fillColor=#ffffff;strokeColor=#d6b656;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="840" y="1320" width="380" height="200" as="geometry"/></mxCell><mxCell id="cal4_title" value="Optimistic Locking (AAP &#167;0.6.2)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1240" y="1290" width="380" height="30" as="geometry"/></mxCell><mxCell id="cal4_body" value="Account and Card entities use JPA @Version columns for optimistic concurrency control.&#10;&#10;This replaces the COBOL before/after image comparison pattern in:&#10;&#8226; COACTUPC.cbl (account update)&#10;&#8226; COCRDUPC.cbl (card update)&#10;&#10;On version mismatch, Spring throws OptimisticLockException &#8594; mapped to HTTP 409 Conflict via GlobalExceptionHandler (AAP &#167;0.4.1)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;fillColor=#ffffff;strokeColor=#d6b656;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1240" y="1320" width="380" height="200" as="geometry"/></mxCell><mxCell id="cal5_title" value="Flyway Migrations" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="1540" width="1580" height="30" as="geometry"/></mxCell><mxCell id="cal5_body" value="Schema is created and seeded by Flyway migrations under src/main/resources/db/migration/ (AAP &#167;0.4.1):&#10;V001__create_account.sql &#183; V002__create_card.sql &#183; V003__create_customer.sql &#183; V004__create_cardxref.sql &#183; V005__create_transaction.sql &#183; V006__create_tcatbal.sql &#183; V007__create_disclosure_group.sql &#183; V008__create_transaction_type.sql &#183; V009__create_transaction_category.sql &#183; V010__create_user_security.sql &#183; V011__create_daily_transaction.sql&#10;Reference data seeds: V012__seed_disclosure_group.sql, V013__seed_transaction_type.sql, V014__seed_transaction_category.sql, V015__seed_default_users.sql." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;fillColor=#ffffff;strokeColor=#d6b656;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="1570" width="1580" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>