        <mxCell id="p1_title" value="CardDemo — AWS-Native Target Architecture (Runtime Topology)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=18;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="1614" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="p1_subtitle" value="Migration target for AWS M2 CardDemo — Java 17+ / Spring Boot 3.x on AWS-native managed services" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=12;fontStyle=2;fillColor=none;strokeColor=none;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry x="20" y="46" width="1614" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="p1_internet" value="Internet&#10;(End Users / Downstream Systems)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="1">
          <mxGeometry x="20" y="100" width="160" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="p1_waf" value="AWS WAF&#10;(REGIONAL Web ACL)&#10;• AWS Managed Rules: CommonRuleSet,&#10;  KnownBadInputs, SQLi, AmazonIpReputation&#10;• RateLimitPerIp: 2000 req / 5 min&#10;• Logs to CloudWatch (auth + cookie redacted)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=11;spacingLeft=6;spacingTop=4;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="1">
          <mxGeometry x="200" y="100" width="240" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="p1_shield" value="AWS Shield&#10;• Shield Standard: always-on&#10;• Shield Advanced: optional&#10;  (var.shield_advanced_enabled, default=false)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=11;spacingLeft=6;spacingTop=4;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="1">
          <mxGeometry x="460" y="100" width="220" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="p1_alb" value="Application Load Balancer&#10;• TLS 1.2+ ELBSecurityPolicy-TLS13-1-2-2021-06&#10;• HTTPS listener (ACM cert) + HTTP→HTTPS redirect&#10;• Sticky sessions (stateful CICS COMMAREA flows)&#10;• Access logs → S3 logs bucket" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=11;spacingLeft=6;spacingTop=4;fillColor=#ffe6cc;strokeColor=#d79b00" vertex="1" parent="1">
          <mxGeometry x="700" y="100" width="260" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="p1_github" value="GitHub Actions&#10;• OIDC federation to AWS IAM&#10;  (github_actions_oidc role)&#10;• Workflows: build.yml,&#10;  docker-build.yml, deploy.yml" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=11;spacingLeft=6;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="1">
          <mxGeometry x="980" y="100" width="200" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="p1_ecr" value="Amazon ECR&#10;• Repository: carddemo-${var.environment}&#10;• IMMUTABLE tags; scan_on_push=true&#10;• KMS encryption; lifecycle keeps N tagged,&#10;  expires untagged after 7 days" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=11;spacingLeft=6;spacingTop=4;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="1">
          <mxGeometry x="1200" y="100" width="220" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="p1_map_callout" value="Source-to-target mapping (per AAP §0.1)&#10;&#10;• 3270 Terminal → REST + JSON (Spring MVC)&#10;• CICS Pseudo-Conv → Stateless REST + JWT&#10;• COBOL @Service per program (1:1) per §0.7.1&#10;• VSAM KSDS/AIX/PATH → RDS PostgreSQL + JPA&#10;• JCL/JES → Step Functions + AWS Batch&#10;• CICS TDQ → MSK Kafka topics&#10;• GDG generations → S3 versioning + lifecycle&#10;• LE CEEDAYS / CEE3ABD → java.time + typed exceptions&#10;• RACF → IAM + JWT + BCrypt" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacingLeft=8;spacingTop=6;fillColor=#ffe6cc;strokeColor=#d79b00" vertex="1" parent="1">
          <mxGeometry x="1440" y="100" width="200" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="p1_vpc" value="VPC — Private Subnets (Multi-AZ)&#10;No public IPs on Fargate tasks; VPC Endpoints for S3 (Gateway), Secrets Manager, KMS, ECR-api, ECR-dkr, Logs" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;collapsible=0;fontStyle=1;fontSize=13;align=center;dashed=0;spacingTop=8;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="1">
          <mxGeometry x="20" y="240" width="1170" height="600" as="geometry"/>
        </mxCell>
        <mxCell id="p1_ecs_cluster" value="Amazon ECS Fargate Cluster&#10;• Container Insights enabled    • Non-root user uid 1000&#10;• Auto-scaling: CPU&gt;70%, Memory&gt;80%, MSK MaxOffsetLag&gt;1000&#10;• Deployment circuit breaker rollback enabled" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;collapsible=0;fontStyle=1;fontSize=11;align=center;dashed=0;spacingTop=6;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="1130" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="p1_task_1" value="Fargate Task 1&#10;Spring Boot 3.x / Java 17+&#10;(Controller → Service →&#10;Repository → Domain)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1">
          <mxGeometry x="80" y="350" width="220" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="p1_task_2" value="Fargate Task 2&#10;Spring Boot 3.x / Java 17+&#10;(Controller → Service →&#10;Repository → Domain)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1">
          <mxGeometry x="350" y="350" width="220" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="p1_task_3" value="Fargate Task 3&#10;Spring Boot 3.x / Java 17+&#10;(Controller → Service →&#10;Repository → Domain)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1">
          <mxGeometry x="620" y="350" width="220" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="p1_task_4" value="Fargate Task 4&#10;Spring Boot 3.x / Java 17+&#10;(Controller → Service →&#10;Repository → Domain)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1">
          <mxGeometry x="890" y="350" width="220" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="p1_rds_group" value="Amazon RDS PostgreSQL Multi-AZ&#10;• engine=16.4; db.t3.medium / db.r6g.large&#10;• storage_encrypted=true (KMS CMK)&#10;• Multi-AZ=true (primary + standby in separate AZ)&#10;• backup_retention_period=35&#10;• rds.force_ssl=1; isolation=read committed&#10;• Performance Insights enabled&#10;• Master password in Secrets Manager" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;collapsible=0;fontStyle=1;fontSize=10;align=left;dashed=0;spacingTop=6;fillColor=#d5e8d4;strokeColor=#82b366;spacingLeft=8" vertex="1" parent="1">
          <mxGeometry x="40" y="490" width="300" height="320" as="geometry"/>
        </mxCell>
        <mxCell id="p1_rds_primary" value="RDS Primary&#10;(AZ-1)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="1">
          <mxGeometry x="70" y="660" width="110" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="p1_rds_standby" value="RDS Standby&#10;(AZ-2)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="1">
          <mxGeometry x="210" y="660" width="110" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="p1_e_rds_sync" value="Synchronous&#10;replication" style="endArrow=classic;startArrow=classic;html=1;rounded=0;fontSize=9;edgeStyle=none;dashed=1;" edge="1" parent="1" source="p1_rds_primary" target="p1_rds_standby">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p1_redis" value="Amazon ElastiCache for Redis&#10;• engine=7.1; replication group&#10;• cache-aside pattern (per AAP §0.6.6)&#10;• maxmemory-policy=allkeys-lru&#10;• at-rest + transit encryption (TLS)&#10;• auth_token from Secrets Manager&#10;• multi_az_enabled=true&#10;• snapshot_retention=7 days" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;collapsible=0;fontStyle=1;fontSize=10;align=left;dashed=0;spacingTop=6;fillColor=#d5e8d4;strokeColor=#82b366;spacingLeft=8" vertex="1" parent="1">
          <mxGeometry x="360" y="490" width="280" height="320" as="geometry"/>
        </mxCell>
        <mxCell id="p1_msk" value="Amazon MSK (Apache Kafka 3.6.0)&#10;• SASL_SSL + IAM auth&#10;• min.insync.replicas=2&#10;• unclean.leader.election.enable=false&#10;• auto.create.topics.enable=false&#10;&#10;Topics (each 12 partitions, RF=3,&#10;partition key = ACCT-ID / USER-ID):&#10;  • transaction.posted&#10;  • account.updated&#10;  • ledger.balanced&#10;  • report.requested" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;collapsible=0;fontStyle=1;fontSize=10;align=left;dashed=0;spacingTop=6;fillColor=#d5e8d4;strokeColor=#82b366;spacingLeft=8" vertex="1" parent="1">
          <mxGeometry x="660" y="490" width="250" height="320" as="geometry"/>
        </mxCell>
        <mxCell id="p1_actuator" value="Spring Boot Actuator&#10;(in each Fargate task)&#10;• /actuator/health&#10;  (liveness + readiness)&#10;• /actuator/metrics&#10;• Exported to CloudWatch&#10;  via Micrometer&#10;  namespace=CardDemo" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacingLeft=6;spacingTop=4;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="1">
          <mxGeometry x="930" y="490" width="240" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="p1_vpc_endpoints" value="VPC Endpoints&#10;• S3 (Gateway)&#10;• Secrets Manager (Interface)&#10;• KMS (Interface)&#10;• ECR-api / ECR-dkr&#10;• Logs (Interface)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacingLeft=6;spacingTop=4;fillColor=#ffe6cc;strokeColor=#d79b00" vertex="1" parent="1">
          <mxGeometry x="930" y="670" width="240" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="p1_s3_outputs" value="Amazon S3 — batch_outputs bucket&#10;• Prefixes: DALYREJS, SYSTRAN, TRANREPT,&#10;  STMTFILE, TRANSACT.BKUP (replaces GDG&#10;  generations per AAP §0.6.2)&#10;• SSE-KMS; versioning=ON&#10;• public_access_block ALL 4 enabled&#10;• TLS-only bucket policy&#10;• Lifecycle → Glacier @90 days&#10;• Expire @ 2555 days (7-year retention)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacingLeft=6;spacingTop=4;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="1">
          <mxGeometry x="1210" y="240" width="220" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="p1_s3_logs" value="Amazon S3 — logs bucket&#10;• ALB access logs +&#10;  CloudTrail destination&#10;• Same security posture as&#10;  batch_outputs (SSE-KMS,&#10;  versioning, public_access_block,&#10;  TLS-only)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacingLeft=6;spacingTop=4;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="1">
          <mxGeometry x="1210" y="420" width="220" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="p1_step_fn" value="AWS Step Functions&#10;• 2 state machines:&#10;  - eod-batch-pipeline&#10;    (POSTTRAN→INTCALC→COMBTRAN&#10;    →Parallel{CREASTMT,TRANREPT})&#10;  - file-provisioning&#10;    (Flyway + Glue ETL bulk-loads)&#10;• X-Ray tracing enabled&#10;• logging include_execution_data=false (PCI-DSS)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacingLeft=6;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1">
          <mxGeometry x="1450" y="240" width="184" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="p1_batch" value="AWS Batch&#10;• Fargate compute env;&#10;  job queue&#10;• 6 job definitions:&#10;  1. DailyTransactionPostingJob&#10;     ← POSTTRAN.jcl&#10;  2. InterestCalculationJob&#10;     ← INTCALC.jcl&#10;  3. CombineTransactionsJob&#10;     ← COMBTRAN.jcl&#10;  4. StatementGenerationJob&#10;     ← CREASTMT.JCL&#10;  5. TransactionReportJob&#10;     ← TRANREPT.jcl&#10;  6. PrintCategoryBalanceJob&#10;     ← PRTCATBL.jcl&#10;• 2-hour timeout; no retries&#10;  (Step Functions handles)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacingLeft=6;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1">
          <mxGeometry x="1450" y="450" width="184" height="280" as="geometry"/>
        </mxCell>
        <mxCell id="p1_glue" value="AWS Glue&#10;• 5 Spark ETL jobs replace IDCAMS REPRO:&#10;  - load_account ← ACCTFILE.jcl&#10;  - load_card ← CARDFILE.jcl&#10;  - load_customer ← CUSTFILE.jcl&#10;  - load_xref ← XREFFILE.jcl&#10;  - load_transaction ← TRANFILE.jcl&#10;• glue_version=4.0; G.1X workers&#10;• Glue connection to RDS" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacingLeft=6;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1">
          <mxGeometry x="1210" y="560" width="220" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="p1_eventbridge" value="Amazon EventBridge Scheduler&#10;• Optional cron 0 23 * * ? *&#10;• Triggers eod-batch-pipeline&#10;  state machine" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacingLeft=6;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1">
          <mxGeometry x="1210" y="740" width="220" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="p1_security_band" value="Security &amp; Secrets Layer" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;collapsible=0;fontStyle=1;fontSize=12;align=center;dashed=0;spacingTop=4;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="1">
          <mxGeometry x="20" y="870" width="810" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="p1_kms" value="AWS KMS&#10;• Customer-managed CMK&#10;  alias/carddemo-${env}&#10;• Annual rotation enabled&#10;• Key policy grants: RDS, S3,&#10;  ElastiCache, MSK, CloudWatch&#10;  Logs, OpenSearch, Secrets&#10;  Manager, SNS/SQS, ECR, CloudTrail" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacingLeft=6;spacingTop=4;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="1">
          <mxGeometry x="30" y="900" width="200" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="p1_secrets" value="AWS Secrets Manager&#10;• JWT signing key&#10;• RDS master password&#10;• MSK SASL credentials&#10;• ElastiCache auth_token&#10;• OpenSearch master user&#10;• Rotation: SNS→SQS→@RefreshScope&#10;  (no Spring restart, AAP §0.6.4)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacingLeft=6;spacingTop=4;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="1">
          <mxGeometry x="240" y="900" width="200" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="p1_param" value="AWS Systems Manager&#10;Parameter Store&#10;• Non-sensitive externalized config&#10;  (per AAP §0.7.2)&#10;• Spring Cloud AWS auto-import&#10;• Env vars: AWS_REGION,&#10;  ECS_CLUSTER_NAME,&#10;  MSK_BOOTSTRAP_SERVERS, etc." style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacingLeft=6;spacingTop=4;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="1">
          <mxGeometry x="450" y="900" width="180" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="p1_iam" value="AWS IAM&#10;• Roles: ecs_task_execution,&#10;  ecs_task_role, batch_service,&#10;  batch_execution_role,&#10;  batch_job_role,&#10;  step_functions_execution,&#10;  glue_job_execution,&#10;  rds_enhanced_monitoring,&#10;  eventbridge_scheduler,&#10;  github_actions_oidc (federated),&#10;  lambda_secrets_rotation" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacingLeft=6;spacingTop=4;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="1">
          <mxGeometry x="640" y="900" width="180" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="p1_observ_band" value="Observability Layer" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;collapsible=0;fontStyle=1;fontSize=12;align=center;dashed=0;spacingTop=4;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="1">
          <mxGeometry x="840" y="870" width="794" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="p1_cloudwatch" value="Amazon CloudWatch&#10;• Log groups: ecs_app, batch_jobs,&#10;  step_functions, glue_jobs,&#10;  opensearch, cloudtrail,&#10;  secrets_rotation_lambda&#10;• All KMS-encrypted, 365-day retention&#10;• Container Insights&#10;• Metric filters: PanLeakageDetected,&#10;  AcctIdLeakageDetected&#10;• Alarms: CPU&gt;75, Mem&gt;80, RDS Conns&gt;80,&#10;  MSK MaxOffsetLag&gt;1000, ErrorLog&gt;20/min" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacingLeft=6;spacingTop=4;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="1">
          <mxGeometry x="850" y="900" width="220" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="p1_opensearch" value="Amazon OpenSearch 2.11&#10;• VPC-internal domain&#10;• encrypt_at_rest (KMS CMK)&#10;• node_to_node_encryption&#10;• Policy-Min-TLS-1-2-PFS-2023-10&#10;• Fine-grained access control&#10;• Master user from Secrets Manager&#10;• dedicated_master for prod&#10;• Transaction logs + CloudTrail index" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacingLeft=6;spacingTop=4;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="1">
          <mxGeometry x="1080" y="900" width="190" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="p1_cloudtrail" value="AWS CloudTrail&#10;• Multi-region org trail&#10;• enable_log_file_validation=true&#10;• KMS CMK encryption&#10;• S3 data events on&#10;  batch_outputs +&#10;  cloudtrail_logs&#10;• Lambda data events&#10;• ApiCallRateInsight" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacingLeft=6;spacingTop=4;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="1">
          <mxGeometry x="1280" y="900" width="170" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="p1_macie" value="Amazon Macie&#10;• FIFTEEN_MINUTES finding&#10;  frequency&#10;• Classification jobs on&#10;  batch_outputs bucket (100%&#10;  sampling)&#10;• Custom identifiers:&#10;  - 11-digit ACCT-ID&#10;  - 16-digit CARD-NUM&#10;  (per AAP §0.6.1)&#10;• SNS topic: macie_findings" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacingLeft=6;spacingTop=4;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="1">
          <mxGeometry x="1460" y="900" width="170" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="p1_pci_callout" value="PCI-DSS posture:  •  All data at rest encrypted via KMS CMK  •  All data in transit via TLS 1.2+  •  Credentials in Secrets Manager (zero plaintext)  •  WAF + Shield on ALB  •  Macie continuous S3 scanning for PII/financial data  •  CloudTrail immutable audit trail  •  OpenSearch indexed for regulatory queries &amp; fraud investigation" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacingLeft=8;spacingTop=6;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="1">
          <mxGeometry x="20" y="1040" width="1614" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="p1_footer" value="All AWS services depicted trace to Terraform definitions under infrastructure/terraform/*.tf  •  See AAP §0.3, §0.6.3, §0.6.5, §0.6.6, §0.7.2 for cross-references  •  Page 1 of 4 — Runtime Topology" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;fontStyle=2;fillColor=none;strokeColor=none;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry x="20" y="1110" width="1614" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="p1_e_int_waf" value="HTTPS" style="endArrow=classic;html=1;rounded=0;fontSize=10;edgeStyle=orthogonalEdgeStyle;curved=0;" edge="1" parent="1" source="p1_internet" target="p1_waf">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p1_e_waf_shield" value="" style="endArrow=classic;html=1;rounded=0;fontSize=10;edgeStyle=orthogonalEdgeStyle;curved=0;" edge="1" parent="1" source="p1_waf" target="p1_shield">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p1_e_shield_alb" value="" style="endArrow=classic;html=1;rounded=0;fontSize=10;edgeStyle=orthogonalEdgeStyle;curved=0;" edge="1" parent="1" source="p1_shield" target="p1_alb">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p1_e_alb_ecs" value="HTTPS REST" style="endArrow=classic;html=1;rounded=0;fontSize=10;edgeStyle=orthogonalEdgeStyle;curved=0;" edge="1" parent="1" source="p1_alb" target="p1_ecs_cluster">
