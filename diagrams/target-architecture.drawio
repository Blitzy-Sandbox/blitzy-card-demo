  <diagram id="page-eod-batch" name="2 — End-of-Day Batch Pipeline (Step Functions)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p2_title" value="End-of-Day Batch Pipeline — AWS Step Functions State Machine" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=18;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="1614" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="p2_subtitle" value="Replaces JCL job stream: POSTTRAN → INTCALC → COMBTRAN → CREASTMT / TRANREPT (per AAP §0.6.3)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=12;fontStyle=2;fillColor=none;strokeColor=none;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry x="20" y="46" width="1614" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="p2_pattern_note" value="Each Task state invokes arn:aws:states:::batch:submitJob.sync against an AWS Batch job definition that runs a Spring Batch jar inside a Fargate container (per AAP §0.6.3).&#10;&#10;JCL COND= and IF/THEN map to Step Functions Retry + Catch. JCL PARM= values are passed as Step Functions inputs into Batch job environment variables." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontSize=10;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#ffffcc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="20" y="90" width="1110" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="p2_jcl_legend" value="JCL → Step Functions Legend&#10;&#10;• PostTransactions ← app/jcl/POSTTRAN.jcl&#10;   (PGM=CBTRN02C, STEP15)&#10;• CalculateInterest ← app/jcl/INTCALC.jcl&#10;   (PGM=CBACT04C, PARM=&apos;YYYYMMDD0&apos;)&#10;• CombineTransactions ← app/jcl/COMBTRAN.jcl&#10;   (PGM=SORT + IDCAMS REPRO; no COBOL)&#10;• CreateStatements ← app/jcl/CREASTMT.JCL&#10;   (PGM=CBSTM03A; text + HTML variants)&#10;• RunTransactionReports ← app/jcl/TRANREPT.jcl&#10;   (PGM=CBTRN03C; date-window filter)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacingLeft=8;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1">
          <mxGeometry x="1140" y="90" width="494" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="p2_start" value="▶ Start&#10;EventBridge Scheduler&#10;cron 0 23 * * ? *" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="1">
          <mxGeometry x="630" y="200" width="180" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p2_post" value="Task: PostTransactions&#10;AWS Batch SubmitJob.sync&#10;DailyTransactionPostingJob&#10;&#10;• Replaces COBOL: CBTRN02C.cbl + POSTTRAN.jcl&#10;• Inputs: DALYTRAN-FILE (S3)&#10;• 4-stage validation cascade:&#10;    XREF → Account → CreditLimit → Expiration&#10;• Outputs: Transaction + Account +&#10;  TransactionCategoryBalance updates +&#10;  S3 reject file (DALYREJS prefix)&#10;• Retry: 3 attempts, 60s backoff&#10;• Catch → FailureNotification" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacingLeft=8;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1">
          <mxGeometry x="520" y="290" width="400" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="p2_interest" value="Task: CalculateInterest&#10;AWS Batch SubmitJob.sync&#10;InterestCalculationJob&#10;&#10;• Replaces COBOL: CBACT04C.cbl + INTCALC.jcl&#10;• Formula (per AAP §0.6.1):&#10;   balance.multiply(rate).divide(&#10;     BigDecimal.valueOf(1200), 2,&#10;     RoundingMode.HALF_EVEN)&#10;• PARM=&apos;YYYYMMDD&apos; (current business date)&#10;• Lookup: DisclosureGroup with DEFAULT fallback&#10;• Retry: 3 attempts, 60s backoff&#10;• Catch → FailureNotification" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacingLeft=8;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1">
          <mxGeometry x="520" y="490" width="400" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="p2_combine" value="Task: CombineTransactions&#10;AWS Batch SubmitJob.sync&#10;CombineTransactionsJob&#10;&#10;• Replaces JCL: COMBTRAN.jcl&#10;  (DFSORT + IDCAMS REPRO; no COBOL source)&#10;• Java Comparator sort (by TRAN-ID)&#10;• Bulk JPA insert into Transaction master&#10;• Retry: 3 attempts, 60s backoff&#10;• Catch → FailureNotification" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacingLeft=8;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1">
          <mxGeometry x="520" y="690" width="400" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="p2_parallel" value="Parallel State&#10;(Fan-out Stage 4a + 4b)" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1">
          <mxGeometry x="620" y="870" width="200" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p2_stmt" value="Branch A — CreateStatements&#10;AWS Batch SubmitJob.sync&#10;StatementGenerationJob&#10;&#10;• Replaces COBOL:&#10;  CBSTM03A.CBL / CBSTM03B.CBL&#10;  + CREASTMT.JCL&#10;• Template Method pattern&#10;  for text + HTML variants&#10;• Output: S3 STMTFILE prefix" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacingLeft=8;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1">
          <mxGeometry x="250" y="970" width="350" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="p2_report" value="Branch B — RunTransactionReports&#10;AWS Batch SubmitJob.sync&#10;TransactionReportJob&#10;&#10;• Replaces COBOL:&#10;  CBTRN03C.cbl (report variant)&#10;  + TRANREPT.jcl&#10;• Date-window filter + join with&#10;  TransactionType + TransactionCategory&#10;  + CardCrossReference&#10;• Output: S3 TRANREPT prefix" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacingLeft=8;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1">
          <mxGeometry x="840" y="970" width="350" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="p2_success" value="✓ Success&#10;State machine completes&#10;CloudWatch metric +&#10;OpenSearch event indexed" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="1">
          <mxGeometry x="610" y="1090" width="220" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p2_fail" value="✗ Fail State&#10;FailureNotification&#10;&#10;• Publishes to SNS error topic&#10;• Emits CloudWatch alarm&#10;• OpenSearch failure event indexed&#10;• ALL upstream Tasks&apos; Catch&#10;  routes to this state" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacingLeft=8;spacingTop=6;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="1">
          <mxGeometry x="1160" y="540" width="400" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="p2_e_start_post" value="" style="endArrow=classic;html=1;rounded=0;fontSize=10;edgeStyle=orthogonalEdgeStyle;curved=0;" edge="1" parent="1" source="p2_start" target="p2_post">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p2_e_post_int" value="Next" style="endArrow=classic;html=1;rounded=0;fontSize=10;edgeStyle=orthogonalEdgeStyle;curved=0;" edge="1" parent="1" source="p2_post" target="p2_interest">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p2_e_int_comb" value="Next" style="endArrow=classic;html=1;rounded=0;fontSize=10;edgeStyle=orthogonalEdgeStyle;curved=0;" edge="1" parent="1" source="p2_interest" target="p2_combine">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p2_e_comb_par" value="Next" style="endArrow=classic;html=1;rounded=0;fontSize=10;edgeStyle=orthogonalEdgeStyle;curved=0;" edge="1" parent="1" source="p2_combine" target="p2_parallel">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p2_e_par_stmt" value="Branch A" style="endArrow=classic;html=1;rounded=0;fontSize=10;edgeStyle=orthogonalEdgeStyle;curved=0;" edge="1" parent="1" source="p2_parallel" target="p2_stmt">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p2_e_par_rpt" value="Branch B" style="endArrow=classic;html=1;rounded=0;fontSize=10;edgeStyle=orthogonalEdgeStyle;curved=0;" edge="1" parent="1" source="p2_parallel" target="p2_report">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p2_e_stmt_done" value="Join" style="endArrow=classic;html=1;rounded=0;fontSize=10;edgeStyle=orthogonalEdgeStyle;curved=0;" edge="1" parent="1" source="p2_stmt" target="p2_success">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p2_e_rpt_done" value="Join" style="endArrow=classic;html=1;rounded=0;fontSize=10;edgeStyle=orthogonalEdgeStyle;curved=0;" edge="1" parent="1" source="p2_report" target="p2_success">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p2_e_post_fail" value="Catch" style="endArrow=classic;html=1;rounded=0;fontSize=9;edgeStyle=orthogonalEdgeStyle;curved=0;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="p2_post" target="p2_fail">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p2_e_int_fail" value="Catch" style="endArrow=classic;html=1;rounded=0;fontSize=9;edgeStyle=orthogonalEdgeStyle;curved=0;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="p2_interest" target="p2_fail">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p2_e_comb_fail" value="Catch" style="endArrow=classic;html=1;rounded=0;fontSize=9;edgeStyle=orthogonalEdgeStyle;curved=0;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="p2_combine" target="p2_fail">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p2_e_stmt_fail" value="Catch" style="endArrow=classic;html=1;rounded=0;fontSize=9;edgeStyle=orthogonalEdgeStyle;curved=0;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="p2_stmt" target="p2_fail">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p2_e_rpt_fail" value="Catch" style="endArrow=classic;html=1;rounded=0;fontSize=9;edgeStyle=orthogonalEdgeStyle;curved=0;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="p2_report" target="p2_fail">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p2_footer" value="Page 2 of 4 — End-of-Day Batch Pipeline  •  Source JCLs preserved frozen under app/jcl/  •  AWS Batch job definitions and Step Functions ASL under infrastructure/terraform/{batch,stepfunctions}.tf and src/main/resources/stepfunctions/eod-batch-pipeline.asl.json" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;fontStyle=2;fillColor=none;strokeColor=none;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry x="20" y="1140" width="1614" height="24" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-msk-topology" name="3 — MSK Kafka Topology">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p3_title" value="Amazon MSK Topology — Event-Driven Transaction Pipeline" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=18;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="1614" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="p3_subtitle" value="Per-account ordering guaranteed by partition key = account ID (per AAP §0.6.5)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=12;fontStyle=2;fillColor=none;strokeColor=none;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry x="20" y="46" width="1614" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="p3_broker_config" value="Broker / Cluster Configuration&#10;Kafka 3.6.0 on Amazon MSK  •  SASL_SSL + IAM auth  •  min.insync.replicas=2  •  unclean.leader.election.enable=false  •  auto.create.topics.enable=false  •  TLS in transit" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacingLeft=8;spacingTop=6;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="1">
          <mxGeometry x="20" y="90" width="1614" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="p3_prod_header" value="Producers (Spring Boot @Service in Fargate Tasks)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;collapsible=0;fontStyle=1;fontSize=12;align=center;dashed=0;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1">
          <mxGeometry x="20" y="160" width="380" height="760" as="geometry"/>
        </mxCell>
        <mxCell id="p3_txn_add" value="TransactionAddService&#10;← COBOL: COTRN02C.cbl&#10;→ transaction.posted" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacingLeft=6;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1">
          <mxGeometry x="30" y="200" width="360" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="p3_bill_pay" value="BillPaymentService&#10;← COBOL: COBIL00C.cbl&#10;→ transaction.posted&#10;→ account.updated" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacingLeft=6;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1">
          <mxGeometry x="30" y="315" width="360" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="p3_acct_upd" value="AccountUpdateService&#10;← COBOL: COACTUPC.cbl&#10;→ account.updated" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacingLeft=6;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1">
          <mxGeometry x="30" y="430" width="360" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="p3_int_calc" value="InterestCalculationService&#10;← COBOL: CBACT04C.cbl&#10;→ account.updated" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacingLeft=6;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1">
          <mxGeometry x="30" y="545" width="360" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="p3_ledger" value="LedgerService&#10;(EOD reconciliation;&#10;double-entry bookkeeping)&#10;→ ledger.balanced" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacingLeft=6;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1">
          <mxGeometry x="30" y="660" width="360" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="p3_rpt_sub" value="ReportSubmissionService&#10;← COBOL: CORPT00C.cbl&#10;→ report.requested&#10;(replaces CICS TDQ JOBS&#10;online→batch bridge)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacingLeft=6;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1">
          <mxGeometry x="30" y="775" width="360" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="p3_prod_config" value="Producer Config (spring.kafka.producer.*)&#10;• acks=all&#10;• enable.idempotence=true&#10;• max.in.flight.requests.per.connection=5&#10;• retries=Integer.MAX_VALUE&#10;• delivery.timeout.ms ≥ request.timeout.ms + linger.ms&#10;• Partitioner: DefaultPartitioner (murmur2 hash of key bytes)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontSize=10;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#ffffcc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="20" y="935" width="380" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="p3_topic_header" value="MSK Topics (Partitioned by ACCT-ID for Ordering)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;collapsible=0;fontStyle=1;fontSize=12;align=center;dashed=0;spacingTop=4;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="1">
          <mxGeometry x="430" y="160" width="540" height="760" as="geometry"/>
        </mxCell>
        <mxCell id="p3_topic_posted" value="📦 transaction.posted&#10;&#10;12 partitions, RF=3&#10;Partition key: ACCT-ID&#10;(zero-padded 11-digit string)&#10;Message format: JSON envelope&#10;{ txnId, acctId, cardNum, amt,&#10;  type, category, timestamp }" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;align=center;verticalAlign=top;spacingTop=8;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="1">
          <mxGeometry x="490" y="200" width="420" height="155" as="geometry"/>
        </mxCell>
        <mxCell id="p3_topic_updated" value="📦 account.updated&#10;&#10;12 partitions, RF=3&#10;Partition key: ACCT-ID&#10;Message format: JSON&#10;{ acctId, oldBalance, newBalance,&#10;  reason, version, timestamp }" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;align=center;verticalAlign=top;spacingTop=8;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="1">
          <mxGeometry x="490" y="375" width="420" height="155" as="geometry"/>
        </mxCell>
        <mxCell id="p3_topic_balanced" value="📦 ledger.balanced&#10;&#10;12 partitions, RF=3&#10;Partition key: ACCT-ID&#10;Message format: JSON&#10;{ acctId, debit, credit,&#10;  reconciled, runId, timestamp }" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;align=center;verticalAlign=top;spacingTop=8;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="1">
          <mxGeometry x="490" y="550" width="420" height="155" as="geometry"/>
        </mxCell>
        <mxCell id="p3_topic_report" value="📦 report.requested&#10;&#10;12 partitions, RF=3&#10;Partition key: USER-ID&#10;Message format: JSON&#10;{ userId, reportType,&#10;  startDate, endDate, format }" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;align=center;verticalAlign=top;spacingTop=8;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="1">
          <mxGeometry x="490" y="725" width="420" height="155" as="geometry"/>
        </mxCell>
        <mxCell id="p3_cons_header" value="Consumers (@KafkaListener, manual offset commit)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;collapsible=0;fontStyle=1;fontSize=12;align=center;dashed=0;spacingTop=4;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="1">
          <mxGeometry x="1000" y="160" width="614" height="760" as="geometry"/>
        </mxCell>
        <mxCell id="p3_cons_audit" value="Audit Consumer&#10;AuditLogService&#10;→ OpenSearch indexer&#10;+ CloudTrail correlation&#10;&#10;Subscribes to:&#10;• transaction.posted&#10;• account.updated&#10;• ledger.balanced" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacingLeft=6;spacingTop=4;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="1">
          <mxGeometry x="1010" y="200" width="594" height="155" as="geometry"/>
        </mxCell>
        <mxCell id="p3_cons_cache" value="Cache Invalidation Consumer&#10;CacheService.evict(acctId)&#10;on ElastiCache Redis&#10;&#10;Subscribes to:&#10;• account.updated&#10;• ledger.balanced" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacingLeft=6;spacingTop=4;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="1">
          <mxGeometry x="1010" y="375" width="594" height="155" as="geometry"/>
        </mxCell>
        <mxCell id="p3_cons_report" value="Report Trigger Consumer&#10;Lambda → Step Functions&#10;file-provisioning state machine&#10;&#10;Subscribes to:&#10;• report.requested&#10;&#10;(Replaces CICS TDQ JOBS&#10;bridge via SfnClient.startExecution)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacingLeft=6;spacingTop=4;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="1">
          <mxGeometry x="1010" y="550" width="594" height="155" as="geometry"/>
        </mxCell>
        <mxCell id="p3_cons_metrics" value="Metrics &amp; Reporting Consumer&#10;Downstream reporting service&#10;+ CloudWatch metric emission&#10;&#10;Subscribes to:&#10;• transaction.posted&#10;• ledger.balanced" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacingLeft=6;spacingTop=4;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="1">
          <mxGeometry x="1010" y="725" width="594" height="155" as="geometry"/>
        </mxCell>
        <mxCell id="p3_cons_config" value="Consumer Config (spring.kafka.consumer.*)&#10;• enable.auto.commit=false (manual offset commit after successful processing)&#10;• isolation.level=read_committed&#10;• max.poll.interval.ms tuned to processing latency to avoid rebalance during long-running handlers&#10;• Single consumer per partition at a time (consumer-group atomicity)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontSize=10;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#ffffcc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1010" y="935" width="624" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="p3_invariant" value="Ordering Invariant (per AAP §0.6.5):&#10;For any given ACCT-ID, events are produced in app order, land on a single partition (DefaultPartitioner with murmur2 hash of key bytes),&#10;are consumed by a single consumer at a time, and committed only after successful processing.&#10;Re-balance does NOT interleave events for the same account because partition assignment is atomic at the consumer-group level." style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacingLeft=8;spacingTop=6;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00" vertex="1" parent="1">
          <mxGeometry x="20" y="1045" width="1614" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p3_source_map" value="Source mapping: CICS TDQ JOBS (online→batch bridge from CORPT00C.cbl) → MSK report.requested topic + Step Functions trigger Lambda.  All inter-service transaction events flow through MSK per AAP §0.7.1." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;fontStyle=2;fillColor=none;strokeColor=none;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry x="20" y="1125" width="1614" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="p3_e_txn_posted" value="publish" style="endArrow=classic;html=1;rounded=0;fontSize=10;edgeStyle=orthogonalEdgeStyle;curved=0;" edge="1" parent="1" source="p3_txn_add" target="p3_topic_posted">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p3_e_bill_posted" value="" style="endArrow=classic;html=1;rounded=0;fontSize=10;edgeStyle=orthogonalEdgeStyle;curved=0;" edge="1" parent="1" source="p3_bill_pay" target="p3_topic_posted">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p3_e_bill_upd" value="" style="endArrow=classic;html=1;rounded=0;fontSize=10;edgeStyle=orthogonalEdgeStyle;curved=0;" edge="1" parent="1" source="p3_bill_pay" target="p3_topic_updated">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p3_e_acctupd_upd" value="" style="endArrow=classic;html=1;rounded=0;fontSize=10;edgeStyle=orthogonalEdgeStyle;curved=0;" edge="1" parent="1" source="p3_acct_upd" target="p3_topic_updated">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p3_e_int_upd" value="" style="endArrow=classic;html=1;rounded=0;fontSize=10;edgeStyle=orthogonalEdgeStyle;curved=0;" edge="1" parent="1" source="p3_int_calc" target="p3_topic_updated">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p3_e_ledger_bal" value="" style="endArrow=classic;html=1;rounded=0;fontSize=10;edgeStyle=orthogonalEdgeStyle;curved=0;" edge="1" parent="1" source="p3_ledger" target="p3_topic_balanced">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p3_e_rpt_req" value="" style="endArrow=classic;html=1;rounded=0;fontSize=10;edgeStyle=orthogonalEdgeStyle;curved=0;" edge="1" parent="1" source="p3_rpt_sub" target="p3_topic_report">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p3_e_posted_audit" value="consume" style="endArrow=classic;html=1;rounded=0;fontSize=10;edgeStyle=orthogonalEdgeStyle;curved=0;" edge="1" parent="1" source="p3_topic_posted" target="p3_cons_audit">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p3_e_upd_audit" value="" style="endArrow=classic;html=1;rounded=0;fontSize=10;edgeStyle=orthogonalEdgeStyle;curved=0;" edge="1" parent="1" source="p3_topic_updated" target="p3_cons_audit">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p3_e_bal_audit" value="" style="endArrow=classic;html=1;rounded=0;fontSize=10;edgeStyle=orthogonalEdgeStyle;curved=0;" edge="1" parent="1" source="p3_topic_balanced" target="p3_cons_audit">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p3_e_upd_cache" value="" style="endArrow=classic;html=1;rounded=0;fontSize=10;edgeStyle=orthogonalEdgeStyle;curved=0;" edge="1" parent="1" source="p3_topic_updated" target="p3_cons_cache">
          <mxGeometry relative="1" as="geometry"/>
