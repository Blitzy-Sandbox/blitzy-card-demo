  </diagram>
  <diagram id="page-security-compliance" name="4 — Security &amp; Compliance Boundary (PCI-DSS)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p4_title" value="Security &amp; Compliance Boundary — PCI-DSS Posture" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=18;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="1614" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="p4_subtitle" value="Defense in depth — concentric boundary controls per AAP §0.6.6 and §0.7.2" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=12;fontStyle=2;fillColor=none;strokeColor=none;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry x="20" y="46" width="1614" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="p4_b_outer" value="Boundary 1 — Internet Edge" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;collapsible=0;fontStyle=1;fontSize=12;align=center;dashed=0;spacingTop=6;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="1080" height="920" as="geometry"/>
        </mxCell>
        <mxCell id="p4_b_app_edge" value="Boundary 2 — Application Edge" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;collapsible=0;fontStyle=1;fontSize=12;align=center;dashed=0;spacingTop=6;fillColor=#ffe6cc;strokeColor=#d79b00" vertex="1" parent="1">
          <mxGeometry x="80" y="170" width="1000" height="820" as="geometry"/>
        </mxCell>
        <mxCell id="p4_b_compute" value="Boundary 3 — Compute (VPC Private Subnets)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;collapsible=0;fontStyle=1;fontSize=12;align=center;dashed=0;spacingTop=6;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1">
          <mxGeometry x="120" y="250" width="920" height="720" as="geometry"/>
        </mxCell>
        <mxCell id="p4_b_data" value="Boundary 4 — Data (At Rest + In Transit)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;collapsible=0;fontStyle=1;fontSize=12;align=center;dashed=0;spacingTop=6;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="1">
          <mxGeometry x="160" y="330" width="840" height="620" as="geometry"/>
        </mxCell>
        <mxCell id="p4_b_id" value="Boundary 5 — Identity &amp; Secrets" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;collapsible=0;fontStyle=1;fontSize=12;align=center;dashed=0;spacingTop=6;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="1">
          <mxGeometry x="200" y="410" width="760" height="520" as="geometry"/>
        </mxCell>
        <mxCell id="p4_b_audit" value="Boundary 6 — Audit &amp; Detection (core)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;collapsible=0;fontStyle=1;fontSize=12;align=center;dashed=0;spacingTop=6;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="1">
          <mxGeometry x="240" y="490" width="680" height="420" as="geometry"/>
        </mxCell>
        <mxCell id="p4_internet_edge" value="AWS WAF (REGIONAL Web ACL)  •  AWS Shield (Standard always-on; Advanced optional)  •  Rate limit 2000 req / 5 min per IP&#10;Managed rules: CommonRuleSet, KnownBadInputs, SQLi, AmazonIpReputationList" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=10;spacingLeft=8;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="1">
          <mxGeometry x="680" y="110" width="420" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="p4_app_edge" value="ALB with TLS 1.2+ (ACM cert + HTTP→HTTPS redirect)  •  JWT issuance via POST /api/auth/signin&#10;JWT validation in JwtAuthenticationFilter (Spring Security 6)  •  Sticky sessions for stateful CICS COMMAREA flows" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=10;spacingLeft=8;fillColor=#ffe6cc;strokeColor=#d79b00" vertex="1" parent="1">
          <mxGeometry x="640" y="190" width="420" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="p4_compute" value="ECS Fargate tasks (non-root user uid 1000)&#10;VPC endpoints: S3 (Gateway), Secrets Manager, KMS, ECR-api, ECR-dkr, Logs (all Interface)&#10;No public IP on Fargate tasks" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=10;spacingLeft=8;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1">
          <mxGeometry x="620" y="270" width="400" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="p4_data" value="RDS encrypted at rest (KMS CMK); rds.force_ssl=1 (TLS in transit)&#10;ElastiCache: at_rest + transit encryption + auth_token&#10;MSK: TLS in transit + SASL_SSL + IAM&#10;S3: SSE-KMS + public_access_block + TLS-only bucket policy + versioning&#10;OpenSearch: encrypt_at_rest + node_to_node_encryption + TLS 1.2+" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=10;spacingLeft=8;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="1">
          <mxGeometry x="590" y="350" width="400" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="p4_identity" value="IAM roles (least privilege per AAP §0.6.6)&#10;Secrets Manager: JWT signing key, DB master pw, MSK SASL,&#10;  OpenSearch master, ElastiCache auth_token&#10;Secrets rotation via SNS→SQS→@RefreshScope&#10;  (no Spring Boot restart per AAP §0.6.4)&#10;BCrypt password hashing for UserSecurity entity&#10;  (security upgrade from COBOL plaintext per AAP §0.1.1)&#10;Parameter Store for non-sensitive externalized config" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacingLeft=8;spacingTop=6;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="1">
          <mxGeometry x="550" y="440" width="400" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="p4_audit" value="Core Audit &amp; Detection&#10;&#10;CloudTrail multi-region org trail&#10;(immutable, log_file_validation=true)&#10;&#10;OpenSearch indexed for regulatory queries&#10;+ fraud investigation&#10;&#10;Macie continuous S3 PII / financial-data scan&#10;• 11-digit ACCT-ID custom identifier&#10;• 16-digit CARD-NUM custom identifier&#10;  (per AAP §0.6.1)&#10;&#10;CloudWatch metric filters:&#10;• PanLeakageDetected&#10;• AcctIdLeakageDetected&#10;+ alarms on detection" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=11;spacingLeft=10;spacingTop=8;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="1">
          <mxGeometry x="450" y="570" width="420" height="320" as="geometry"/>
        </mxCell>
        <mxCell id="p4_pci_req" value="PCI-DSS Requirements Mapping" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;collapsible=0;fontStyle=1;fontSize=13;align=center;dashed=0;spacingTop=4;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="1">
          <mxGeometry x="1140" y="90" width="494" height="600" as="geometry"/>
        </mxCell>
        <mxCell id="p4_req1" value="&lt;b&gt;Req 1 (Firewall)&lt;/b&gt;&lt;br/&gt;VPC + Security Groups + AWS WAF (regional Web ACL)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=4;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="1">
          <mxGeometry x="1150" y="130" width="474" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="p4_req2" value="&lt;b&gt;Req 2 (No vendor defaults)&lt;/b&gt;&lt;br/&gt;Custom config, non-root user (uid 1000)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=4;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="1">
          <mxGeometry x="1150" y="186" width="474" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="p4_req3" value="&lt;b&gt;Req 3 (Protect stored card data)&lt;/b&gt;&lt;br/&gt;KMS CMK encryption at rest (RDS, S3, ElastiCache, MSK, CloudWatch Logs, OpenSearch) + Macie monitoring" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=4;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="1">
          <mxGeometry x="1150" y="242" width="474" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="p4_req4" value="&lt;b&gt;Req 4 (Encrypt transmission)&lt;/b&gt;&lt;br/&gt;TLS 1.2+ everywhere: ALB, RDS, ElastiCache, MSK, OpenSearch" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=4;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="1">
          <mxGeometry x="1150" y="298" width="474" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="p4_req6" value="&lt;b&gt;Req 6 (Secure development)&lt;/b&gt;&lt;br/&gt;GitHub Actions OIDC + OWASP dependency-check + ECR scan_on_push" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=4;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="1">
          <mxGeometry x="1150" y="354" width="474" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="p4_req7" value="&lt;b&gt;Req 7 (Least privilege access)&lt;/b&gt;&lt;br/&gt;IAM roles per service + Secrets Manager + Parameter Store" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=4;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="1">
          <mxGeometry x="1150" y="410" width="474" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="p4_req8" value="&lt;b&gt;Req 8 (Identify &amp; authenticate)&lt;/b&gt;&lt;br/&gt;JWT (Spring Security 6) + BCrypt + UserSecurity entity" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=4;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="1">
          <mxGeometry x="1150" y="466" width="474" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="p4_req10" value="&lt;b&gt;Req 10 (Audit trail)&lt;/b&gt;&lt;br/&gt;CloudTrail + OpenSearch + CloudWatch metric filters + alarms" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=4;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="1">
          <mxGeometry x="1150" y="522" width="474" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="p4_req11" value="&lt;b&gt;Req 11 (Security testing)&lt;/b&gt;&lt;br/&gt;WAF managed rules + Macie + OWASP scan + Container Insights" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=4;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="1">
          <mxGeometry x="1150" y="578" width="474" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="p4_req12" value="&lt;b&gt;Req 12 (Security policy)&lt;/b&gt;&lt;br/&gt;Documented in AAP and infrastructure/terraform/*.tf" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=4;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="1">
          <mxGeometry x="1150" y="634" width="474" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="p4_compliance_aux" value="Out-of-the-box Compliance Enabling&#10;&#10;• RDS automated backups: 35-day retention + point-in-time recovery&#10;• S3 lifecycle: 7-year regulatory retention (2555 days), Glacier @90 days&#10;• No plaintext card/account data in logs — enforced via&#10;   CloudWatch metric filters (PanLeakageDetected,&#10;   AcctIdLeakageDetected) + Macie continuous classification&#10;• All credentials in AWS Secrets Manager — never in application.yml&#10;   or environment variables (only Secret ARNs surfaced)&#10;• ECS deployment_circuit_breaker rollback enabled to prevent&#10;   unhealthy revisions from serving traffic" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontSize=10;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#ffffcc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1140" y="700" width="494" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="p4_defense_legend" value="Defense in Depth — Concentric Boundary Order&#10;&#10;1. Internet Edge:     AWS WAF + Shield + rate limit&#10;2. Application Edge:  ALB TLS 1.2+ + JWT validation + sticky sessions&#10;3. Compute:           VPC Private Subnets + VPC Endpoints + Non-root container&#10;4. Data:              KMS CMK encryption at rest + TLS in transit on every datastore&#10;5. Identity:          IAM + Secrets Manager + Parameter Store + BCrypt&#10;6. Audit &amp; Detection: CloudTrail + OpenSearch + Macie + CloudWatch metric filters" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacingLeft=8;spacingTop=6;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="1">
          <mxGeometry x="40" y="1030" width="1080" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="p4_footer" value="Page 4 of 4 — Security &amp; Compliance Boundary  •  All controls trace to infrastructure/terraform/{waf,shield,kms,secrets,iam,cloudtrail,macie,opensearch,cloudwatch,rds,elasticache,msk,s3}.tf" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;fontStyle=2;fillColor=none;strokeColor=none;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry x="20" y="1140" width="1614" height="24" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
