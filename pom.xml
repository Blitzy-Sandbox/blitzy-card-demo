<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.11</version>
        <relativePath/>
    </parent>

    <groupId>com.carddemo</groupId>
    <artifactId>carddemo</artifactId>
    <version>1.0.0</version>
    <name>CardDemo</name>
    <packaging>jar</packaging>
    <description>Cloud-native Java 25 + Spring Boot migration of the AWS CardDemo mainframe COBOL/CICS/JCL credit-card management application, delivering 100% behavioral parity over PostgreSQL, Spring Batch, and LocalStack-emulated AWS services.</description>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Explicitly pinned versions (all other coordinates are managed by the Spring Boot parent BOM) -->
        <spring-cloud-aws.version>3.3.0</spring-cloud-aws.version>
        <testcontainers.version>2.0.3</testcontainers.version>
        <logstash-logback.version>8.0</logstash-logback.version>
        <jjwt.version>0.12.6</jjwt.version>
        <jacoco.version>0.8.14</jacoco.version>
        <owasp.version>12.1.0</owasp.version>
        <surefire.version>3.5.2</surefire.version>
        <failsafe.version>3.5.2</failsafe.version>

        <!--
          Security-remediation transitive version overrides (Gate 8: zero critical/high CVEs).
          The AAP (docs/technical-specifications.md §0.5.1) FREEZES the Spring Boot parent at
          3.5.11, which cannot be relaxed. Several dependencies managed by the 3.5.11 BOM carry
          known high-severity advisories that are fixed in the latest 3.5.x patch line. Rather
          than change the AAP-frozen parent, the affected transitive coordinates are pinned
          forward to their vetted patched versions (the exact values shipped by the 3.5.15 BOM).
          These property names are the ones the Spring Boot dependency BOM resolves against, so a
          child override propagates through all managed dependencies. Rationale: DECISION_LOG D-034.
        -->
        <spring-security.version>6.5.11</spring-security.version>
        <tomcat.version>10.1.55</tomcat.version>
        <spring-framework.version>6.2.19</spring-framework.version>
        <jackson-bom.version>2.21.4</jackson-bom.version>
        <netty.version>4.1.135.Final</netty.version>
        <logback.version>1.5.34</logback.version>
        <reactor-bom.version>2024.0.18</reactor-bom.version>
        <!--
          PostgreSQL JDBC driver forward-pin (Gate 8). The 3.5.11 BOM manages postgresql at
          42.7.10, which carries CVE-2026-42198 (HIGH 7.5 — SCRAM-SHA-256 client-side DoS,
          affected 42.2.0..<42.7.11). The AAP does not pin the JDBC driver version (it is
          Boot-managed), so the coordinate is pinned forward to the vetted patched 42.7.11.
          This is a genuine remediation, not a suppression. Rationale: DECISION_LOG D-055.
        -->
        <postgresql.version>42.7.11</postgresql.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Cloud AWS BOM: aligns the S3/SQS/SNS starter versions -->
            <dependency>
                <groupId>io.awspring.cloud</groupId>
                <artifactId>spring-cloud-aws-dependencies</artifactId>
                <version>${spring-cloud-aws.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Testcontainers BOM: aligns the postgresql/localstack/junit-jupiter module versions -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Spring Boot starters (versions managed by the parent BOM) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-batch</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Spring Cloud AWS starters (S3 GDG replacement, SQS TDQ replacement, SNS notifications); versions from the AWS BOM.
             The AWS SDK Apache HTTP client transitively pulls commons-logging:commons-logging, which conflicts with
             Spring's spring-jcl bridge (Spring emits a "remove commons-logging.jar" warning). Excluding it routes all
             commons-logging API calls through spring-jcl and restores the Gate 2 zero-warning build. See DECISION_LOG D-035. -->
        <dependency>
            <groupId>io.awspring.cloud</groupId>
            <artifactId>spring-cloud-aws-starter-s3</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>commons-logging</groupId>
                    <artifactId>commons-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>io.awspring.cloud</groupId>
            <artifactId>spring-cloud-aws-starter-sqs</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>commons-logging</groupId>
                    <artifactId>commons-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>io.awspring.cloud</groupId>
            <artifactId>spring-cloud-aws-starter-sns</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>commons-logging</groupId>
                    <artifactId>commons-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Persistence: PostgreSQL JDBC driver and Flyway schema migration (versions managed by the parent BOM) -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Observability: distributed tracing bridge, OTLP exporter, Prometheus registry (versions managed by the parent BOM) -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- Structured JSON logging with correlation IDs -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>${logstash-logback.version}</version>
        </dependency>

        <!-- JSON binding (version managed by the parent BOM) -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- JWT for stateless, token-based session management (replaces CICS COMMAREA state) -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.batch</groupId>
            <artifactId>spring-batch-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Testcontainers 2.x module coordinates (managed by testcontainers-bom 2.0.3) -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-localstack</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Repackage into a single executable Spring Boot fat JAR (version managed by the parent) -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>repackage</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Java 25 release target with zero-warning compilation (Gate 2) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>25</release>
                    <compilerArgs>
                        <arg>-Xlint:all</arg>
                        <arg>-Werror</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <!-- Resolve dependency artifact paths into build properties (e.g. ${org.mockito:mockito-core:jar})
                 so Mockito can be attached as an explicit -javaagent below. Bound to `initialize` so the
                 property is available before Surefire executes. See DECISION_LOG D-035. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>resolve-dependency-properties</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Unit tests: *Test.java only; integration tests are deferred to Failsafe.
                 Mockito is attached as an explicit -javaagent (mockito-core ships Premain-Class:
                 org.mockito.internal.PremainAttach) to remove the JDK 25 self-attaching / dynamic
                 agent-load warnings; `@{argLine}` composes with the JaCoCo-injected coverage agent;
                 `-Xshare:off` silences the CDS "bootstrap classpath has been appended" warning emitted
                 when a java agent appends to the bootclasspath. Gate 2 zero-warning. See DECISION_LOG D-035. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
                <configuration>
                    <argLine>@{argLine} -Xshare:off -javaagent:${org.mockito:mockito-core:jar}</argLine>
                    <includes>
                        <include>**/*Test.java</include>
                    </includes>
                    <excludes>
                        <exclude>**/*IT.java</exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- Integration tests: *IT.java executed in the integration-test/verify phases -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${failsafe.version}</version>
                <configuration>
                    <includes>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
                <executions>
                    <execution>
                        <id>integration-tests</id>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Code coverage with a >= 80% line-coverage gate (Gate 8) -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>jacoco-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- OWASP dependency-check: fails the build on critical/high CVEs (CVSS >= 7).
                 Bound to the verify phase so a clean `mvn clean verify` enforces the Gate 8
                 zero critical/high CVE requirement (not merely an on-demand goal). -->
            <plugin>
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
                <version>${owasp.version}</version>
                <configuration>
                    <failBuildOnCVSS>7</failBuildOnCVSS>
                    <!--
                      Vulnerability data is sourced from the NVD (the authoritative CVE
                      database). The Sonatype OSS Index analyzer is disabled because it
                      requires account credentials (anonymous calls return HTTP 401 and would
                      fail the build spuriously rather than for a real CVE). The Central
                      analyzer is disabled because it is an artifact-identification aid, not a
                      vulnerability source, and every artifact is already resolved locally.
                      autoUpdate is left at its default (true) so a clean-machine build
                      populates the NVD from the API. Rationale: DECISION_LOG D-050.
                    -->
                    <ossindexAnalyzerEnabled>false</ossindexAnalyzerEnabled>
                    <centralAnalyzerEnabled>false</centralAnalyzerEnabled>
                    <!-- Emit every report format (HTML/JSON/XML/CSV/SARIF) into target/ so the
                         Gate 8 sign-off can parse the JSON and the CI can archive the evidence. -->
                    <format>ALL</format>
                    <!--
                      Documented, per-CVE suppression file for advisories that cannot be
                      remediated within the AAP §0.5.1 freeze of the Spring Boot parent at
                      3.5.11 (their fix requires 3.5.12/3.5.14) yet whose vulnerable code paths
                      are provably absent from this application, plus three wrong-product CPE
                      false positives. Each <suppress> carries a technical notes block. No
                      genuinely-applicable advisory is suppressed. Rationale: DECISION_LOG D-055.
                    -->
                    <suppressionFiles>
                        <suppressionFile>${project.basedir}/owasp-suppressions.xml</suppressionFile>
                    </suppressionFiles>
                </configuration>
                <executions>
                    <execution>
                        <id>dependency-check-verify</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
