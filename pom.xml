<?xml version="1.0" encoding="UTF-8"?>
<!--
  ******************************************************************
  * Build        : pom.xml
  * Application  : CardDemo
  * Type         : Maven build configuration (Java 25 / Spring Boot 3.5.11)
  * Function     : Single-artifact build for the CardDemo modular monolith that
  *                replaces the z/OS execution substrate of the frozen COBOL
  *                corpus in app/ (28 COBOL programs in app/cbl, 28 copybooks
  *                in app/cpy, 17 BMS mapsets in app/bms with their 17 symbolic
  *                maps in app/cpy-bms, 29 JCL members in app/jcl, 2 procedures
  *                in app/proc, 1 IDCAMS control card in app/ctl, the CICS CSD
  *                in app/csd and the VSAM catalogue in app/catlg). The three
  *                z/OS compile templates samples/BATCMP.jcl, samples/CICCMP.jcl
  *                and samples/BMSCMP.jcl plus the three build procedures
  *                samples/BUILDBAT.prc, samples/BUILDBMS.prc and
  *                samples/BUILDONL.prc are conceptually superseded by this file.
