# ******************************************************************

# ---- Version control and CI ----
.git
.gitignore
.gitattributes
.github

# ---- Build output (the image builds from source inside the build stage) ----
target
build
out

# ---- Legacy mainframe corpus and z/OS build tooling (reference only) ----
app
samples
diagrams

# ---- Documentation and evidence artefacts ----
docs
*.md
mkdocs.yml
catalog-info.yaml
LICENSE
NOTICE

# ---- Local infrastructure definitions (not needed inside the image) ----
docker-compose.yml
localstack-init
observability

# ---- Secrets and local overrides ----
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
secrets

# ---- IDE / editor / OS noise ----
.idea
.vscode
.settings
.classpath
.project
*.iml
.DS_Store
Thumbs.db

# ---- Python tooling ----
.venv
venv
__pycache__

# ---- Blitzy scratch space ----
blitzy
blitzy_adhoc_test_*
